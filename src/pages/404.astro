---
// 404 页：简单的未找到页面。
// 文章已静态化为 .md 内容集合，未构建出的 slug 直接 404，不再做"动态文章兜底"。
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 | HConzlvra_">
  <div class="nf" id="nf">
    <h1>404</h1>
    <p class="nf-text">Page not found.</p>
    <a href="/" class="nf-link">← Back home</a>
  </div>
</Layout>

<style>
  .nf {
    max-width: 820px;
    margin: 0 auto;
    padding: 5.5rem 1.5rem 4rem;
    width: 100%;
    min-height: 60vh;
  }
  /* 移动端：顶部留出悬浮导航（约 60px），正文上移 */
  @media (max-width: 768px) {
    .nf {
      padding: 6.2rem 1.1rem 4rem;
    }
  }
  .nf h1 {
    width: fit-content; /* 渐变随文字宽度收缩：短标题也能显示完整渐变 */
    background: var(--heading-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-size: 5rem;
    margin-bottom: 0.75rem;
  }
  .nf-text {
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }
  .nf-link {
    color: var(--accent-text);
    text-decoration: none;
  }
  .nf-link:hover {
    text-decoration: underline;
  }
</style>
