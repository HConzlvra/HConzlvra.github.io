---
import Layout from '../layouts/Layout.astro';
import DotGrid from '../components/DotGrid.astro';
import { getCollection } from 'astro:content';

// Latest posts: static top 3 at build time (merged with /admin posts at runtime)
const posts = (await getCollection('posts'))
  .sort((a, b) => (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0))
  .slice(0, 3);

const pad2 = (n: number) => String(n).padStart(2, '0');
const dateLabel = (d?: Date) =>
  d ? `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}` : '';
---

<Layout title="HConzlvra_'s Site">
  <DotGrid />
  <!-- First screen: gradient background + dot grid visible, centered in viewport -->
  <div class="container">
    <!-- Desktop: hero + cards centered as one group (container handles it).
         Mobile: hero-screen fills the whole first screen with just the headline,
         the cards start below the fold -->
    <div class="hero-screen">
      <section class="hero">
        <h1 class="anim-up" style="--d: 0.05s"><span class="lines-hi" data-scramble>HI,<br class="br-mobile" /> THIS IS</span><br /><span class="name" data-scramble>HCONZLVRA_</span></h1>
        <p class="subtitle anim-up" style="--d: 0.18s">Welcome to my site.</p>
        <p class="tagline" data-type="300">There is a crack in everything. <br class="br-mobile" />That's how the light gets in.</p>
        <!-- 框体本身不做淡入上移：移动端的 L 形线要以"笔顺"自己画出来，
             所以淡入动画下移到框内的各个子元素上 -->
        <div class="hero-frame">
          <div class="frame-deco anim-up" style="--d: 0.42s">
            <span class="deco-dot"></span>
            <span class="deco-text">NAV</span>
          </div>
          <div class="hero-actions anim-up" style="--d: 0.42s">
            <a class="btn btn-solid" href="/about">About me</a>
            <a class="btn btn-outline" href="/guestbook">Guestbook</a>
          </div>
          <span class="frame-meta"><span class="frame-meta-label" data-type="420">// entry points</span></span>
          <!-- 像素方块装饰：桌面在流内、移动端悬在 L 形左下角下方 -->
          <div class="hero-pixels" aria-hidden="true">
            <span></span><span></span><span></span><span></span><span></span>
          </div>
        </div>
      </section>
    </div>

    <section class="features">
      <div class="card enter-up">
        <h3>A Soul</h3>
        <p>Harold_Conzlvra, HConzlvra_, HC.</p>
      </div>
      <div class="card enter-up">
        <h3>A Thought</h3>
        <p>to share ideas and life.</p>
      </div>
      <div class="card enter-up">
        <h3>A Site</h3>
        <p>Powered by Astro, and a deep mind.</p>
      </div>
    </section>
  </div>

  <!-- Below the fold: solid footer-style background — no gradient, no dot grid -->
  <section class="home-lower">
    <div class="lower-inner">
      <div class="section-head">
        <h2>Latest posts</h2>
        <a class="more-link" href="/posts">All posts →</a>
      </div>
      <ul class="latest-list" id="latest-list">
        {
          posts.map((p) => (
            <li data-slug={p.id} data-title={p.data.title} data-ts={p.data.pubDate?.valueOf() ?? 0}>
              <a href={`/posts/${p.id}`} class="latest-item">
                <span class="latest-title">{p.data.title}</span>
                <time>{dateLabel(p.data.pubDate)}</time>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="section-head">
        <h2>Explore</h2>
      </div>
      <div class="quick-grid">
        <a class="quick-card" href="/about">
          <span class="qc-title">About</span>
          <span class="qc-desc">The person behind this site</span>
        </a>
        <a class="quick-card" href="/docs">
          <span class="qc-title">Docs</span>
          <span class="qc-desc">Articles &amp; notes, properly organized</span>
        </a>
        <a class="quick-card" href="/archive">
          <span class="qc-title">Archive</span>
          <span class="qc-desc">Site stats &amp; the visitor map</span>
        </a>
        <a class="quick-card" href="/guestbook">
          <span class="qc-title">Guestbook</span>
          <span class="qc-desc">Passing by? Leave a message</span>
        </a>
        <a class="quick-card" href="/bruh">
          <span class="qc-title">Bruh</span>
          <span class="qc-desc">…just go see for yourself</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { API_BASE } from '../lib/api';

  // Latest posts merge: pull /admin-published posts and re-rank with the static list, top 3;
  // keep the static list as-is when the backend is down or has nothing new
  const API = API_BASE;

  const fmt = (ts: number) => {
    const d = new Date(ts);
    const p = (n: number) => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`;
  };

  const mergeLatest = async () => {
    const list = document.getElementById('latest-list');
    if (!list) return; // not on the homepage
    try {
      const res = await fetch(`${API}/posts`);
      if (!res.ok) return;
      const { posts = [] } = await res.json();
      const staticSlugs = new Set([...list.children].map((li) => (li as HTMLElement).dataset.slug));
      if (!posts.some((p) => !staticSlugs.has(p.slug))) return;

      type Item = { slug: string; title: string; ts: number };
      const items: Item[] = [...list.children].map((el) => {
        const li = el as HTMLElement;
        return {
          slug: li.dataset.slug || '',
          title: li.dataset.title || '',
          ts: Number(li.dataset.ts) || 0,
        };
      });
      for (const p of posts)
        if (!staticSlugs.has(p.slug)) items.push({ slug: p.slug, title: p.title, ts: p.created_at });
      items.sort((a, b) => b.ts - a.ts);

      list.innerHTML = '';
      for (const it of items.slice(0, 3)) {
        const li = document.createElement('li');
        // keep data attrs so re-running the merge after soft nav stays idempotent
        li.dataset.slug = it.slug;
        li.dataset.title = it.title;
        li.dataset.ts = String(it.ts);
        const a = document.createElement('a');
        a.className = 'latest-item';
        a.href = `/posts/${it.slug}`;
        const t = document.createElement('span');
        t.className = 'latest-title';
        t.textContent = it.title;
        const time = document.createElement('time');
        time.textContent = fmt(it.ts);
        a.append(t, time);
        li.append(a);
        list.append(li);
      }
    } catch {
      /* silent: keep static list */
    }
  };

  // Re-merge on soft-nav back to the homepage (also fires on first load)
  document.addEventListener('astro:page-load', mergeLatest);
  mergeLatest();

  // ---------- Scramble text effect ----------
  // 字符解密效果：只作用于 hero 标题，与淡入动画同时开始，
  // 随机字符（仅英文字母）逐位还原为正确字符。
  // 递归处理文本节点，保留 <br> 等 DOM 结构；渐变文字用 background-clip:text 不受影响。
  const SCRAMBLE_UPPER = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  const SCRAMBLE_LOWER = 'abcdefghijklmnopqrstuvwxyz';
  const FRAME_INTERVAL = 45; // ms/次：随机字符的切换节奏
  const LOCK_DURATION = 1000; // ms：还原过程的总时长

  // 每个文本节点的原文只在第一次记下，之后一律从它还原。
  // 本效果有两个触发入口（模块内的立即调用 + astro:page-load），第二次触发时
  // 文本可能已经被打乱；若把乱码当成原文，动画结束就会停在错误的字母上。
  const originals = new WeakMap<Text, string>();
  // 已有动画在跑的元素：重复触发直接忽略，避免两套循环同时改写同一批文本节点
  const playing = new WeakSet<HTMLElement>();
  // 已经完整播放过的元素：同一页面视图内不重播（首次加载两个入口会各触发一次）
  const played = new WeakSet<HTMLElement>();

  // 递归收集元素下的所有文本节点，保留 DOM 结构（<br> 等不丢）
  const collectTextNodes = (root: Node): Text[] => {
    const nodes: Text[] = [];
    const walk = (node: Node) => {
      if (node.nodeType === Node.TEXT_NODE) {
        if ((node.textContent || '').length > 0) nodes.push(node as Text);
      } else {
        for (const child of node.childNodes) walk(child);
      }
    };
    walk(root);
    return nodes;
  };

  const randChar = (set: string) => set.charAt(Math.floor(Math.random() * set.length));

  const scrambleElement = (el: HTMLElement) => {
    if (playing.has(el)) return;
    const nodes = collectTextNodes(el);
    if (!nodes.length) return;

    // 取回原文；顺便判断当前文本是否已被打乱（上次被打断留下的乱码）
    let dirty = false;
    const texts = nodes.map((n) => {
      const known = originals.get(n);
      if (known === undefined) {
        const text = n.textContent || '';
        originals.set(n, text);
        return text;
      }
      if (n.textContent !== known) dirty = true;
      return known;
    });

    // 已播过且文本干净：同一页面视图内的重复触发，跳过不重播
    if (played.has(el) && !dirty) return;
    // 文本脏了：先还原干净再重播
    if (dirty) nodes.forEach((n, i) => (n.textContent = texts[i]));

    // 统计非空白字符总数
    const totalChars = texts.reduce((sum, s) => sum + [...s].filter((c) => !/\s/.test(c)).length, 0);
    if (totalChars === 0) return;

    playing.add(el);
    played.add(el);

    const lockWindow = LOCK_DURATION * 0.7; // 锁定阶段占总时长的 ~70%，留余量收尾
    let start = 0;
    let lastPaint = Number.NEGATIVE_INFINITY;

    const paint = (targetLock: number) => {
      let count = 0;
      for (let ni = 0; ni < nodes.length; ni++) {
        const orig = texts[ni];
        let out = '';
        for (const ch of orig) {
          if (/\s/.test(ch)) {
            out += ch; // 空白字符原样保留
          } else if (count < targetLock) {
            out += ch; // 已锁定：显示正确字符
            count++;
          } else if (/[A-Z]/.test(ch)) {
            out += randChar(SCRAMBLE_UPPER);
          } else if (/[a-z]/.test(ch)) {
            out += randChar(SCRAMBLE_LOWER);
          } else {
            out += ch; // 非字母字符（标点、数字等）原样保留
          }
        }
        if (nodes[ni].textContent !== out) nodes[ni].textContent = out;
      }
    };

    // 收尾：确保所有文本完全正确
    const finish = () => {
      for (let ni = 0; ni < nodes.length; ni++) {
        if (nodes[ni].textContent !== texts[ni]) nodes[ni].textContent = texts[ni];
      }
      playing.delete(el);
    };

    // 进度按真实时间算而不是按帧数：标签页被节流或掉帧时不会拖慢/卡住，
    // 到点一定收尾，且最后写回的永远是原文
    const step = (now: number) => {
      if (!start) start = now;
      const elapsed = now - start;
      const progress = Math.min(1, elapsed / lockWindow);
      // 仍按 FRAME_INTERVAL 的节奏刷新字符，避免 60fps 下闪烁过快
      if (progress >= 1 || elapsed - lastPaint >= FRAME_INTERVAL) {
        lastPaint = elapsed;
        paint(Math.floor(progress * totalChars));
      }
      if (progress < 1) requestAnimationFrame(step);
      else finish();
    };

    requestAnimationFrame(step);
  };

  // 首次加载 + 软导航回首页时触发：对所有 [data-scramble] 元素执行
  const tryScramble = () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll<HTMLElement>('[data-scramble]').forEach(scrambleElement);
  };
  document.addEventListener('astro:page-load', tryScramble);
  tryScramble();

  // ---------- Typewriter effect ----------
  // 字母依序出现，像现场敲出来：整段文字一开始就占好位置（每个字符包一层
  // span，只切透明度），所以打字过程不会因为逐字排版而抖动。
  // 延迟与间隔分别由 [data-type]（毫秒）和 TYPE_INTERVAL 控制。
  // 300ms 起步 + 61 字 × 8ms ≈ 0.79s 收尾。
  // 注意 hero-rise 用的是 cubic-bezier(0.22,1,0.36,1) 强缓出，按钮名义上跑满
  // 1.22s，但视觉上 ~0.8s 就已到位，所以按"视觉到位"对齐而不是按名义终点
  const TYPE_INTERVAL = 8; // ms/字
  const typing = new WeakSet<HTMLElement>();

  const typeElement = (el: HTMLElement) => {
    if (typing.has(el)) return;
    const nodes = collectTextNodes(el);
    if (!nodes.length) return;
    typing.add(el);

    // 逐字包 span（<br> 等结构保持不动）
    const chars: HTMLElement[] = [];
    for (const node of nodes) {
      const frag = document.createDocumentFragment();
      for (const ch of node.textContent || '') {
        const span = document.createElement('span');
        span.className = 'tw-ch';
        span.textContent = ch;
        frag.append(span);
        chars.push(span);
      }
      node.replaceWith(frag);
    }

    // 按真实时间推进而不是链式 setTimeout：帧率与调度抖动不会把总时长拖长，
    // 60 字左右必定在 1s 内敲完，和其它入场动画一起到位
    let i = 0;
    let start = 0;
    const step = (now: number) => {
      if (!start) start = now;
      const target = Math.min(chars.length, Math.ceil((now - start) / TYPE_INTERVAL));
      while (i < target) chars[i++].classList.add('is-on');
      if (i < chars.length) requestAnimationFrame(step);
    };
    window.setTimeout(() => requestAnimationFrame(step), Number(el.dataset.type) || 0);
  };

  // 首次加载 + 软导航回首页时触发
  const tryTyping = () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll<HTMLElement>('[data-type]').forEach(typeElement);
  };
  document.addEventListener('astro:page-load', tryTyping);
  tryTyping();

  // ---------- 滚动驱动动画 ----------
  // 刷新时的入场动画播完后，把 L 形线 / 像素方块 / NAV 这几个元素交给滚动位置驱动：
  // 下滚按入场动画倒放、上滚正放，进度完全跟手，可以停在半途而不是一次性播完。
  // 只写一个 --p 变量（1 = 完全入场，0 = 完全退场），各元素在 CSS 里各自换算；
  // 支持原生 scroll-driven animation 的浏览器里，L 形线与 NAV 由合成器接管（见 CSS）。
  let scrubFrame: HTMLElement | null = null;
  let scrubDistance = 420; // px：滚过这段距离，动画从"完全入场"走到"完全退场"
  let scrubQueued = false;

  const paintScrub = () => {
    scrubQueued = false;
    if (!scrubFrame?.isConnected) return;
    const p = Math.max(0, Math.min(1, 1 - window.scrollY / scrubDistance));
    scrubFrame.style.setProperty('--p', p.toFixed(4));
  };

  // 监听器只注册一次（模块脚本只执行一次），元素在每次页面加载时重新取
  window.addEventListener(
    'scroll',
    () => {
      if (scrubQueued) return;
      scrubQueued = true;
      requestAnimationFrame(paintScrub);
    },
    { passive: true }
  );

  const setupScrub = () => {
    const frame = document.querySelector<HTMLElement>('.hero-frame');
    if (!frame || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const start = () => {
      if (!frame.isConnected) return;
      // 滚到"框顶到达视口顶部"时正好退场完毕，距离据此换算
      scrubDistance = Math.max(200, Math.round(frame.getBoundingClientRect().top + window.scrollY));
      scrubFrame = frame;
      // 原生滚动驱动的动画范围（animation-range）要的是绝对像素
      frame.style.setProperty('--scrub-dist', `${scrubDistance}px`);
      frame.classList.add('is-scrub');
      paintScrub();
    };

    // 等刷新时最晚结束的入场动画（按钮/NAV 的 hero-rise，1.22s）播完再接管，
    // 否则接管瞬间会把还没播完的动画直接跳到终态
    const last = frame.querySelector('.hero-actions');
    if (last) last.addEventListener('animationend', start, { once: true });
    else start();
  };
  document.addEventListener('astro:page-load', setupScrub);
  setupScrub();

  // ---------- 彩蛋：像素方块波浪 ----------
  // 桌面：指针在热区（比方块大一圈）停留 0.3s 后开始波浪，移开立刻停；
  //       不离开就每 1s 再来一波——用"周期 1s 的无限循环 + 相邻方块错开 60ms"叠出来，
  //       而不是一次次重启动画（重启会把半空中的方块打断）
  // 移动端：点一下走一波
  const HOP_MS = 300; // ms：单次"跳起—落地"的动作时长（两端一致）
  const HOP_SPAN = 0.8; // 跳跃占动作时长的比例，余下的时间落地静止
  const LOOP_MS = 1000; // ms：桌面端两波之间的间隔
  const HOP_STAGGER = 60; // ms：相邻方块错开的相位
  const HOP_HEIGHT = 7; // px：跳起高度

  // 在一个 duration 内只跳一次（占用 HOP_MS），其余时间静止，
  // 于是"动作时长"和"重复间隔"可以分开设：桌面端 1s 的周期里只在开头跳
  const buildHop = (duration: number): Keyframe[] => {
    const hop = (HOP_MS * HOP_SPAN) / duration;
    return [
      { transform: 'translateY(0px)', offset: 0, easing: 'cubic-bezier(0.33, 0, 0.67, 1)' },
      { transform: `translateY(-${HOP_HEIGHT}px)`, offset: hop / 2, easing: 'cubic-bezier(0.33, 0, 0.67, 1)' },
      { transform: 'translateY(0px)', offset: hop },
      { transform: 'translateY(0px)', offset: 1 },
    ];
  };

  let waveAnims: Animation[] = [];
  let waveTimer = 0;

  const stopWave = () => {
    window.clearTimeout(waveTimer);
    waveTimer = 0;
    waveAnims.forEach((a) => a.cancel());
    waveAnims = [];
  };

  const runWave = (loop: boolean) => {
    const host = document.querySelector<HTMLElement>('.hero-pixels');
    if (!host) return;
    stopWave();
    const duration = loop ? LOOP_MS : HOP_MS; // 桌面：1s 的周期里只跳一次
    const frames = buildHop(duration);
    host.querySelectorAll('span').forEach((span, i) => {
      waveAnims.push(
        span.animate(frames, {
          duration,
          delay: i * HOP_STAGGER, // 依次从左往右起跳
          iterations: loop ? Number.POSITIVE_INFINITY : 1,
        })
      );
    });
  };

  const waveBound = new WeakSet<HTMLElement>();
  const bindWave = () => {
    stopWave(); // 软导航离开首页时，停掉还在跑的波
    const host = document.querySelector<HTMLElement>('.hero-pixels');
    if (!host || waveBound.has(host)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    waveBound.add(host);

    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      host.addEventListener('mouseenter', () => {
        window.clearTimeout(waveTimer);
        waveTimer = window.setTimeout(() => runWave(true), 300); // 停留 0.3s 才起跳
      });
      host.addEventListener('mouseleave', stopWave);
    } else {
      host.addEventListener('click', () => runWave(false)); // 点一次走一波
    }
  };
  document.addEventListener('astro:page-load', bindWave);
  bindWave();
</script>

<style>
  .container {
    width: 100%;
    box-sizing: border-box;
    text-align: left;
    display: flex;
    flex-direction: column;
    padding: 5rem 3rem 3rem;
    margin: 0;
  }

  /* Desktop: hero-screen 填满首屏（减去导航栏高度），hero 内容纵向居中，
     三个卡片自然落到折线以下。Mobile: 靠上，见媒体查询。 */
  .hero-screen {
    width: 100%;
    min-height: calc(100vh - 5rem);
    min-height: calc(100lvh - 5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* Hero */
  .hero {
    width: 100%;
  }

  /* 入场动画：从下往上淡入，每个元素有独立 delay（用 --d 控制），
     backwards 填充保证动画开始前元素已是 from 态，不会闪现。
     位移幅度随屏宽缩放：大屏 2.5rem，移动端 1.2rem */
  :root {
    --anim-y-up: 2.5rem;
  }
  @media (max-width: 768px) {
    :root {
      --anim-y-up: 1.2rem;
    }
  }
  .anim-up {
    opacity: 0;
    animation: hero-rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0s) forwards;
    will-change: opacity, transform;
  }
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(var(--anim-y-up));
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  /* 像素方块：只做"出现"，不淡入、不位移、不缩放 */
  @keyframes pixel-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  /* L 形线按笔顺画出：先竖（自上而下），后横（自左而右） */
  @keyframes l-stroke-y {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }
  @keyframes l-stroke-x {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  /* 原生滚动驱动用的关键帧：时间轴 0% = 页面顶部（完全画好），
     100% = 已滚过 --scrub-dist（完全退场）。数值与 JS 回退实现一一对应 */
  @keyframes l-scrub-y {
    from {
      transform: scaleY(1);
    }
    30% {
      transform: scaleY(1); /* 前 30% 不动，之后才收（倒放"先横后竖"） */
    }
    to {
      transform: scaleY(0);
    }
  }
  @keyframes l-scrub-x {
    from {
      transform: scaleX(1);
    }
    40% {
      transform: scaleX(0); /* 一进来就开始收，40% 处收完 */
    }
    to {
      transform: scaleX(0);
    }
  }
  @keyframes deco-scrub {
    from {
      opacity: 1;
      transform: translateY(0);
    }
    to {
      opacity: 0;
      transform: translateY(var(--anim-y-up));
    }
  }
  /* 打字效果：字符从一开始就占好位置（不改变排版），只逐个显出来，
     这样"敲字"过程不会引起换行抖动。
     这些 span 由脚本运行时创建，没有 Astro 的作用域属性，必须用 :global */
  :global(.tw-ch) {
    opacity: 0;
  }
  :global(.tw-ch.is-on) {
    opacity: 1;
  }

  /* 减少动态偏好：直接显示，不做动画 */
  @media (prefers-reduced-motion: reduce) {
    .anim-up {
      opacity: 1;
      animation: none;
    }
    .hero-pixels span {
      opacity: 1;
      animation: none;
    }
  }
  .hero h1 {
    font-size: clamp(2.8rem, 5.2vw, 5.5rem); /* first line (HI, HERE IS) */
    font-weight: 600;
    width: fit-content; /* shrink the gradient to text width so short titles still show all of it */
    background: var(--heading-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  /* The name: bigger and heavier than line one, on its own line (break comes from <br>) */
  .hero h1 .name {
    display: inline-block;
    font-size: 1.55em; /* ≈ 大屏可达 10rem+ */
    font-weight: 800;
    letter-spacing: -0.01em;
    /* inline-block + large font: the h1 line box would clip the descending
       underscore. Give the name its own roomy line box */
    line-height: 1.25;
    padding-bottom: 0.08em;
  }
  .hero .subtitle {
    font-size: clamp(1.6rem, 2.4vw, 2.4rem);
    font-weight: 500;
    color: var(--accent-text);
    margin-bottom: 0.75rem;
  }
  .hero .tagline {
    font-size: clamp(1rem, 1.3vw, 1.4rem);
    color: var(--text-secondary);
    line-height: 1.7;
    white-space: nowrap;
    border-left: 3px solid var(--btn-primary-bg);
    padding-left: 1rem;
    margin: 1.2rem 0 0;
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
  }

  /* 代码风角框装饰（竖排 NAV）：仅移动端可见 */
  .frame-deco {
    display: none;
  }

  /* 角框容器：移动端像素方块以它为定位基准；桌面端用 flex 排成
     「按钮一行 + 像素方块与 // entry points 一行」 */
  .hero-frame {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    row-gap: 3rem; /* 按钮行与像素方块行之间的间距 */
  }

  /* // entry points：桌面与像素方块同一行（排在方块右侧），移动端在 L 形底部（见媒体查询） */
  .frame-meta {
    order: 1; /* 桌面上排到像素方块之后 */
    margin-left: 0.5rem;
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
    font-size: 0.7rem;
    line-height: 1.4;
    color: var(--text-secondary);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .frame-meta::before {
    content: none; /* 桌面无横线 */
  }

  /* 像素方块：5 个并排，饱和紫调从左到右依次变浅；
     与按钮淡入同时开始，逐个从左往右"跳"出来（用 steps 去掉过渡，只剩出现） */
  .hero-pixels {
    position: relative; /* 彩蛋热区的定位基准（移动端被媒体查询覆盖为 absolute） */
    display: flex;
    gap: 4px;
    cursor: pointer;
  }
  /* 彩蛋热区：比方块本身大一圈，指针/手指更容易命中 */
  .hero-pixels::after {
    content: '';
    position: absolute;
    inset: -10px -14px;
  }
  .hero-pixels span {
    width: 9px;
    height: 9px;
    background: #ad81e5;
    opacity: 0; /* 按钮出现前保持不可见 */
    animation: pixel-in 1ms steps(1, end) forwards;
  }
  .hero-pixels span:nth-child(1) {
    background: #6f3fc4;
    animation-delay: 0.42s; /* 与按钮淡入同时开始 */
  }
  .hero-pixels span:nth-child(2) {
    background: #7d4dd0;
    animation-delay: 0.5s;
  }
  .hero-pixels span:nth-child(3) {
    background: #8b5cda;
    animation-delay: 0.58s;
  }
  .hero-pixels span:nth-child(4) {
    background: #9c6fe0;
    animation-delay: 0.66s;
  }
  .hero-pixels span:nth-child(5) {
    animation-delay: 0.74s;
  }

  /* ---- 像素方块的滚动驱动（两端通用）----
     脚本在入场动画播完后给 .hero-frame 加 .is-scrub，此后方块由 --p
     （滚动位置换算：1 = 完全入场 / 0 = 完全退场）决定显隐。
     每个方块在自己的阈值上直接"跳"，阈值从左往右依次错开 → 下滚时最右边先消失、
     最左边最后消失，且可停在中间 */
  .hero-frame.is-scrub .hero-pixels span {
    animation: none;
    --lp: clamp(0, calc((var(--p) - (0.25 + var(--i) * 0.15)) * 100), 1);
    opacity: var(--lp);
  }
  .hero-frame.is-scrub .hero-pixels span:nth-child(1) { --i: 0; }
  .hero-frame.is-scrub .hero-pixels span:nth-child(2) { --i: 1; }
  .hero-frame.is-scrub .hero-pixels span:nth-child(3) { --i: 2; }
  .hero-frame.is-scrub .hero-pixels span:nth-child(4) { --i: 3; }
  .hero-frame.is-scrub .hero-pixels span:nth-child(5) { --i: 4; }

  /* Hero 按钮：紫色主题（实心 + 描边），桌面/移动通用 */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    flex: 0 0 100%; /* 在 .hero-frame 里独占一行，像素方块行落在其下 */
    gap: 1rem;
    margin-top: 2rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1.8rem;
    border-radius: 0;
    border: 2px solid var(--btn-primary-bg);
    box-shadow: 4px 4px 0 rgba(146, 103, 215, 0.28);
    font-size: 0.98rem;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
    transition: transform 0.18s ease, box-shadow 0.18s ease, filter 0.18s ease;
    position: relative;
    isolation: isolate;
  }
  .btn::before {
    content: '';
    position: absolute;
    inset: 4px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    pointer-events: none;
  }
  /* 按钮文本末尾右箭头 */
  .btn::after {
    content: ' →';
    margin-left: 0.3em;
    transition: transform 0.18s ease;
  }
  .btn:hover::after {
    transform: translateX(3px);
  }
  .btn-solid {
    background: linear-gradient(180deg, #9a58e7 0%, #7f3fc9 100%);
    color: #fff;
    box-shadow: 6px 6px 0 rgba(123, 78, 190, 0.8), inset 0 0 0 1px rgba(255,255,255,0.18);
  }
  .btn-solid:hover {
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0 rgba(123, 78, 190, 0.9), inset 0 0 0 1px rgba(255,255,255,0.2);
    filter: brightness(1.05);
  }
  .btn-outline {
    border-color: rgba(151, 109, 220, 0.9);
    color: var(--accent-text);
    background: rgba(146, 103, 215, 0.04);
    box-shadow: 4px 4px 0 rgba(146, 103, 215, 0.18);
  }
  .btn-outline:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 rgba(146, 103, 215, 0.3);
    background: rgba(146, 103, 215, 0.08);
  }
  html[data-theme='dark'] .btn-outline {
    color: #d9c9ff;
  }

  /* Features: three cards side by side */
  .features {
    width: 100%;
    margin-top: 3.5rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .features .card {
    background: var(--surface);
    backdrop-filter: blur(10px);
    border: 1px solid var(--surface-border);
    border-radius: 20px;
    padding: clamp(1.5rem, 2vw, 2.5rem);
    transition: all 0.3s ease;
  }
  .features .card:hover {
    transform: translateY(-6px);
    background: var(--surface-hover);
    border-color: var(--surface-border-hover);
    box-shadow: var(--card-shadow);
  }
  /* staggered fade-in */
  .features .card:nth-child(2) { animation-delay: 0.08s; }
  .features .card:nth-child(3) { animation-delay: 0.16s; }
  .features .card h3 {
    width: fit-content;
    font-size: clamp(1.3rem, 2vw, 2rem);
    font-weight: 700;
    margin-bottom: 0.75rem;
    background: var(--heading-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .features .card p {
    color: var(--text-secondary);
    line-height: 1.7;
    font-size: clamp(0.95rem, 1.2vw, 1.2rem);
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
    letter-spacing: 0.02em;
  }

  /* ---- Below the fold: same background logic as the footer ----
     Solid --footer-bg paints over the html gradient AND the fixed dot-grid
     canvas (z-index -1 sits below normal-flow backgrounds) */
  .home-lower {
    background: var(--footer-bg);
    border-top: 1px solid var(--surface-border);
    padding: 2rem 3rem 4.5rem;
    text-align: left;
  }
  .lower-inner {
    width: 100%;
    margin: 0;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin: 2.5rem 0 0.6rem;
  }
  .section-head h2 {
    font-size: clamp(1.4rem, 2vw, 2rem);
    font-weight: 700;
    color: var(--text);
  }
  .more-link {
    font-size: 0.9rem;
    color: var(--accent-text);
    text-decoration: none;
  }
  .more-link:hover {
    text-decoration: underline;
  }

  .latest-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .latest-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.05rem 0.5rem;
    border-bottom: 1px dashed var(--surface-border);
    text-decoration: none;
  }
  .latest-list li:last-child .latest-item {
    border-bottom: none;
  }
  .latest-title {
    color: var(--text);
    font-weight: 600;
    font-size: clamp(1.05rem, 1.3vw, 1.4rem);
    transition: color 0.2s ease;
  }
  .latest-item:hover .latest-title {
    color: var(--accent-text);
  }
  .latest-item time {
    flex-shrink: 0;
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .quick-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 1rem;
  }
  .quick-card {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.35rem 1.2rem;
    background: var(--surface);
    border: 1px solid var(--surface-border);
    border-radius: 18px;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  .quick-card:hover {
    transform: translateY(-4px);
    background: var(--surface-hover);
    border-color: var(--surface-border-hover);
    box-shadow: var(--card-shadow);
  }
  .qc-title {
    font-size: clamp(1.05rem, 1.3vw, 1.4rem);
    font-weight: 700;
    color: var(--text);
    transition: color 0.2s ease;
  }
  .quick-card:hover .qc-title {
    color: var(--accent-text);
  }
  .qc-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* 移动端专用换行：桌面 display:none 彻底隐藏（渲染与不存在时一致），
     ≤768px 恢复 inline（= br 默认行为）才产生换行 */
  .br-mobile {
    display: none;
  }

  /* narrow viewports: let the tagline wrap (nowrap needs ~830px+) */
  @media (max-width: 900px) {
    .hero .tagline {
      white-space: normal;
    }
  }

  /* mobile */
  @media (max-width: 768px) {
    .br-mobile {
      display: inline; /* HI,↵THIS IS 与 tagline 两句各占一行（桌面隐藏） */
    }
    .container {
      text-align: left; /* 与桌面端一致：左对齐 */
      padding-left: 1.25rem; /* 略收边距，给放大后的字让位 */
      padding-right: 1.25rem;
    }
    .hero-screen {
      justify-content: flex-start; /* 移动端靠上，不居中 */
      padding-top: 5vh;
    }
    .hero h1 {
      font-size: min(2.7rem, 10.5vw); /* 仅作 .name 的 em 基准，实际字号在下方两个 span 上 */
      margin-inline: 0; /* 覆盖桌面的 fit-content 居中，左对齐 */
      max-width: 100%; /* 窄屏防御 */
      line-height: 1.18; /* 行距收紧，三行大字成为一个紧凑字块 */
      margin-bottom: 0.85rem; /* 与 welcome 副标题之间留一点呼吸感，不挤 */
    }
    /* 恢复到最初的移动端 hero 字体：不再做额外拉伸 */
    .hero h1 .lines-hi {
      display: inline-block;
      font-size: min(3.4rem, 12.8vw);
      font-weight: 800;
      line-height: 1;
      transform: scaleY(1.5);
      background-image: var(--heading-gradient), var(--heading-gradient);
      background-size: 100% 52%;
      background-position: 0 0, 0 100%;
      background-repeat: no-repeat;
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .hero h1 .name {
      display: block;
      font-size: min(1.8em, 12.6vw);
      font-weight: 900;
      letter-spacing: -0.02em;
      line-height: 1.15;
      margin-top: 0.59em;
      transform: scaleY(1.7);
      background: var(--heading-gradient);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    /* 更窄的手机（≤359px）：padding 占比更高，vw 再收一档防止名字顶到边距 */
    @media (max-width: 359px) {
      .hero h1 .name {
        font-size: min(1.8em, 12.3vw); /* 900 更宽，窄屏同步再收防溢出 */
      }
    }
    .hero .subtitle {
      font-size: min(2rem, 7.6vw); /* 名字为主，副标题退一档 */
      margin-bottom: 0.9rem;
    }
    .hero .tagline {
      font-size: min(1.1rem, 4vw);
      line-height: 1.45;
      padding-left: 0.7rem;
      margin-top: 0.85rem;
    }
    /* 代码风 L 形角框：仅移动端。左竖线 + 底部横线，线条 2px */
    .hero-frame {
      display: block; /* 覆盖桌面的 flex 行布局 */
      margin-top: 3.8rem;
    }
    /* 桌面在流内的像素方块，移动端改回绝对定位，悬在 L 形左下角下方 */
    .hero-pixels {
      position: absolute;
      left: 0;
      bottom: -1.5rem;
    }
    /* 左竖线：底部与横线交叉后收在框底。笔顺第一步：自上而下长出 */
    .hero-frame::before {
      content: '';
      position: absolute;
      left: 0;
      top: 1.4rem;
      bottom: 0;
      width: 2px;
      background: var(--surface-border);
      transform-origin: top;
      animation: l-stroke-y 0.35s ease-out 0.42s both;
    }
    /* 底部行：横线撑满左侧、文字居右。横线左端穿出竖线左侧与之交叉，
       右端在文字前停下（不再延伸到右边界） */
    .frame-meta {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin: 0.7rem 0 0; /* 覆盖桌面的 margin-left */
    }
    /* 底部横线：笔顺第二步，竖线画完后自左而右长出 */
    .frame-meta::before {
      content: '';
      flex: 1;
      height: 2px;
      margin-left: -0.35rem; /* 穿出竖线左侧，与竖线交叉 */
      margin-right: 8.4rem; /* 右端收在文字前，横线明显短于竖线，呈 L 形 */
      background: var(--surface-border);
      transform-origin: left;
      animation: l-stroke-x 0.3s ease-out 0.77s both;
    }
    .frame-meta-label {
      opacity: 0.55;
    }
    /* 减少动态偏好：L 形线直接画好 */
    @media (prefers-reduced-motion: reduce) {
      .hero-frame::before,
      .frame-meta::before {
        animation: none;
      }
    }
    /* 左竖线与按钮之间的装饰列：紫色小圆点 + 竖排文字，间距刚好容纳 */
    .frame-deco {
      position: absolute;
      left: 0.35rem;
      top: 0.2rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.35rem;
    }
    .deco-dot {
      width: 0.4rem;
      height: 0.4rem;
      border-radius: 1px;
      background: var(--btn-primary-bg);
    }
    .deco-text {
      font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
      font-size: 0.6rem;
      font-weight: 700;
      color: var(--btn-primary-bg);
      letter-spacing: 0.15em;
      writing-mode: vertical-rl;
      text-orientation: upright;
      opacity: 0.7;
    }
    /* 按钮：居右排列，统一宽度，左侧留出装饰列空间 */
    .hero-actions {
      margin-top: 0;
      margin-left: 2rem;
      gap: 1.1rem;
      flex-direction: column;
      align-items: flex-end;
    }
    .hero-actions .btn {
      width: 11rem;
      padding: 0.9rem 1rem;
      font-size: 0.95rem;
    }
    .features {
      margin-top: 5rem; /* clear separation from the first screen */
      grid-template-columns: 1fr;
    }
    .home-lower {
      padding: 1.5rem 1.25rem 3.5rem; /* 左右与 container 同边距 */
    }
    .section-head {
      margin-top: 1.75rem;
    }
    .quick-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .latest-item {
      padding: 0.9rem 0.25rem;
    }

    /* ---- 滚动驱动动画（L 形线 / NAV）----
       .hero-frame 由脚本在入场动画播完后加 .is-scrub，此后这几个元素的状态
       由 --p（滚动位置换算而来，1 = 完全入场 / 0 = 完全退场）决定，
       所以下滚是倒放、上滚是正放，并且能停在动画中间。
       下面是 JS 换算的回退实现；支持原生滚动驱动时由后面的 @supports 覆盖 */
    .hero-frame.is-scrub::before {
      animation: none;
      /* 入场是"先竖后横"，倒放就是"先收横、再收竖" */
      transform: scaleY(clamp(0, calc(var(--p) / 0.7), 1));
    }
    .hero-frame.is-scrub .frame-meta::before {
      animation: none;
      transform: scaleX(clamp(0, calc((var(--p) - 0.6) / 0.4), 1));
    }
    .hero-frame.is-scrub .frame-deco {
      animation: none;
      opacity: var(--p);
      transform: translateY(calc((1 - var(--p)) * var(--anim-y-up)));
    }

    /* 原生 scroll-driven animation：动画跑在合成器上，滚动期间完全不占主线程，
       避免主线程被点阵画布等占用时（iOS Safari 上很明显）出现卡顿 */
    @supports (animation-timeline: scroll()) {
      .hero-frame.is-scrub::before,
      .hero-frame.is-scrub .frame-meta::before,
      .hero-frame.is-scrub .frame-deco {
        animation-duration: 1s; /* 进度型时间轴里 1s = 时间轴范围的 100% */
