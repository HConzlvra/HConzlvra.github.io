---
import Layout from '../layouts/Layout.astro';
import DotGrid from '../components/DotGrid.astro';
---

<Layout title="HConzlvra_ 的主页">
  <DotGrid />
  <div class="container">
    <!-- Hero -->
    <section class="hero enter-left">
      <h1>Hi ! Here's HConzlvra_</h1>
      <p class="subtitle">你好！这里是哈康HC</p>
      <p class="tagline">「我让自己登基，做疯的君王｜万物皆有裂痕，那是光照进来的地方」</p>
    </section>

    <!-- Features -->
    <section class="features">
      <div class="card enter-up">
        <h3>由 Astro 搭建</h3>
        <p>不知道</p>
      </div>
      <div class="card enter-up">
        <h3>是个人物</h3>
        <p>烨然若神人</p>
      </div>
      <div class="card enter-up">
        <h3>哈康大会@Official</h3>
        <p>Harold_Conzlvra, HConzlvra_, HC, 哈康, 哈康HC, 哈康国王～</p>
      </div>
    </section>
  </div>
</Layout>

<style>
  .container {
    max-width: 1000px;
    width: 100%;
    text-align: center;
    min-height: 100vh; /* 撑满首屏，把页脚推到视口外 */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center; /* 上下左右居中 */
    padding: 5rem 1.5rem 3rem;
    margin: 0 auto;
  }

  /* Hero 区域 */
  .hero {
    width: 100%;
    margin-bottom: 3.5rem;
  }
  .hero h1 {
    font-size: 4.5rem;
    font-weight: 700;
    background: var(--heading-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
  }
  .hero .subtitle {
    font-size: 2.2rem;
    font-weight: 500;
    color: var(--accent-text);
    margin-bottom: 0.75rem;
  }
  .hero .tagline {
    font-size: 1.4rem;
    color: var(--text-secondary);
    line-height: 1.6;
    white-space: nowrap;
  }

  /* Features 区域：三张卡片始终并排 */
  .features {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }
  .features .card {
    background: var(--surface);
    backdrop-filter: blur(10px);
    border: 1px solid var(--surface-border);
    border-radius: 20px;
    padding: 2rem 1.5rem;
    transition: all 0.3s ease;
  }
  .features .card:hover {
    transform: translateY(-6px);
    background: var(--surface-hover);
    border-color: var(--surface-border-hover);
    box-shadow: var(--card-shadow);
  }
  /* 三张卡片从下往上依次淡入（轻微错开） */
  .features .card:nth-child(2) { animation-delay: 0.08s; }
  .features .card:nth-child(3) { animation-delay: 0.16s; }
  .features .card h3 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    background: var(--heading-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .features .card p {
    color: var(--text-secondary);
    line-height: 1.6;
    font-size: 1rem;
  }

  /* 响应式 */
  @media (max-width: 640px) {
    .hero h1 {
      font-size: 3rem;
    }
    .hero .subtitle {
      font-size: 1.6rem;
    }
    .hero .tagline {
      font-size: 1.1rem;
      white-space: normal;
    }
    .features {
      grid-template-columns: 1fr;
    }
  }
</style>
