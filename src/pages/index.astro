---
import Layout from '../layouts/Layout.astro';
import DotGrid from '../components/DotGrid.astro';
import { getCollection } from 'astro:content';

// Latest posts: static top 3 at build time (merged with /admin posts at runtime)
const posts = (await getCollection('posts'))
  .sort((a, b) => (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0))
  .slice(0, 3);

const pad2 = (n: number) => String(n).padStart(2, '0');
const dateLabel = (d?: Date) =>
  d ? `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}` : '';
---

<Layout title="HConzlvra_'s Site">
  <DotGrid />
  <!-- First screen: gradient background + dot grid visible, centered in viewport -->
  <div class="container">
    <!-- Desktop: hero + cards centered as one group (container handles it).
         Mobile: hero-screen fills the whole first screen with just the headline,
         the cards start below the fold -->
    <div class="hero-screen">
      <section class="hero enter-left">
        <h1>HI, THIS IS<br /><span class="name">HCONZLVRA_</span></h1>
        <p class="subtitle">Welcome to my site.</p>
        <p class="tagline">「There is a crack in everything. That's how the light gets in.」</p>
      </section>
    </div>

    <section class="features">
      <div class="card enter-up">
        <h3>A Soul</h3>
        <p>Harold_Conzlvra, HConzlvra_, HC.</p>
      </div>
      <div class="card enter-up">
        <h3>A Thought</h3>
        <p>to share ideas and life.</p>
      </div>
      <div class="card enter-up">
        <h3>A Site</h3>
        <p>Powered by Astro, and a deep mind.</p>
      </div>
    </section>
  </div>

  <!-- Below the fold: solid footer-style background — no gradient, no dot grid -->
  <section class="home-lower">
    <div class="lower-inner">
      <div class="section-head">
        <h2>Latest posts</h2>
        <a class="more-link" href="/posts">All posts →</a>
      </div>
      <ul class="latest-list" id="latest-list">
        {
          posts.map((p) => (
            <li data-slug={p.id} data-title={p.data.title} data-ts={p.data.pubDate?.valueOf() ?? 0}>
              <a href={`/posts/${p.id}`} class="latest-item">
                <span class="latest-title">{p.data.title}</span>
                <time>{dateLabel(p.data.pubDate)}</time>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="section-head">
        <h2>Explore</h2>
      </div>
      <div class="quick-grid">
        <a class="quick-card" href="/about">
          <span class="qc-title">About</span>
          <span class="qc-desc">The person behind this site</span>
        </a>
        <a class="quick-card" href="/docs">
          <span class="qc-title">Docs</span>
          <span class="qc-desc">Articles &amp; notes, properly organized</span>
        </a>
        <a class="quick-card" href="/archive">
          <span class="qc-title">Archive</span>
          <span class="qc-desc">Site stats &amp; the visitor map</span>
        </a>
        <a class="quick-card" href="/guestbook">
          <span class="qc-title">Guestbook</span>
          <span class="qc-desc">Passing by? Leave a message</span>
        </a>
        <a class="quick-card" href="/bruh">
          <span class="qc-title">Bruh</span>
          <span class="qc-desc">…just go see for yourself</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Latest posts merge: pull /admin-published posts and re-rank with the static list, top 3;
  // keep the static list as-is when the backend is down or has nothing new
  const API = import.meta.env.DEV ? '/api' : 'https://guestbook-9z8.pages.dev/api';

  const fmt = (ts: number) => {
    const d = new Date(ts);
    const p = (n: number) => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`;
  };

  const mergeLatest = async () => {
    const list = document.getElementById('latest-list');
    if (!list) return; // not on the homepage
    try {
      const res = await fetch(`${API}/posts`);
      if (!res.ok) return;
      const { posts = [] } = await res.json();
      const staticSlugs = new Set([...list.children].map((li) => (li as HTMLElement).dataset.slug));
      if (!posts.some((p) => !staticSlugs.has(p.slug))) return;

      type Item = { slug: string; title: string; ts: number };
      const items: Item[] = [...list.children].map((el) => {
        const li = el as HTMLElement;
        return {
          slug: li.dataset.slug || '',
          title: li.dataset.title || '',
          ts: Number(li.dataset.ts) || 0,
        };
      });
      for (const p of posts)
        if (!staticSlugs.has(p.slug)) items.push({ slug: p.slug, title: p.title, ts: p.created_at });
      items.sort((a, b) => b.ts - a.ts);

      list.innerHTML = '';
      for (const it of items.slice(0, 3)) {
        const li = document.createElement('li');
        // keep data attrs so re-running the merge after soft nav stays idempotent
        li.dataset.slug = it.slug;
        li.dataset.title = it.title;
        li.dataset.ts = String(it.ts);
        const a = document.createElement('a');
        a.className = 'latest-item';
        a.href = `/posts/${it.slug}`;
        const t = document.createElement('span');
        t.className = 'latest-title';
        t.textContent = it.title;
        const time = document.createElement('time');
        time.textContent = fmt(it.ts);
        a.append(t, time);
        li.append(a);
        list.append(li);
      }
    } catch {
      /* silent: keep static list */
    }
  };

  // Re-merge on soft-nav back to the homepage (also fires on first load)
  document.addEventListener('astro:page-load', mergeLatest);
  mergeLatest();
</script>

<style>
  .container {
    max-width: 1360px; /* wider than nav/footer: the hero headline needs the room */
    width: 100%;
    min-height: 100vh; /* first screen exactly: vertical padding counts in (border-box) */
    box-sizing: border-box;
    text-align: left; /* desktop: left aligned (mobile restores centering below) */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center; /* hero + cards centered as one group (= previous look) */
    padding: 5rem 2.5rem 3rem;
    margin: 0 auto;
  }

  /* Desktop: a plain wrapper (centering is the container's job).
     Mobile: overridden below — fills the first screen with just the headline */
  .hero-screen {
    width: 100%;
  }

  /* Hero */
  .hero {
    width: 100%;
  }
  .hero h1 {
    font-size: 3.4rem; /* first line (HI, HERE IS) */
    font-weight: 600;
    width: fit-content; /* shrink the gradient to text width so short titles still show all of it */
    background: var(--heading-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  /* The name: bigger and heavier than line one, on its own line (break comes from <br>) */
  .hero h1 .name {
    display: inline-block;
    font-size: 1.55em; /* ≈5.3rem, larger than line one */
    font-weight: 800;
    letter-spacing: -0.01em;
    /* inline-block + large font: the h1 line box would clip the descending
       underscore. Give the name its own roomy line box */
    line-height: 1.25;
    padding-bottom: 0.08em;
  }
  .hero .subtitle {
    font-size: 2.4rem;
    font-weight: 500;
    color: var(--accent-text);
    margin-bottom: 0.75rem;
  }
  .hero .tagline {
    font-size: 1.55rem;
    color: var(--text-secondary);
    line-height: 1.6;
    white-space: nowrap;
  }

  /* Features: three cards side by side */
  .features {
    width: 100%;
    margin-top: 3.5rem; /* hero ↔ cards gap (mobile: separates them by a screen anyway) */
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }
  .features .card {
    background: var(--surface);
    backdrop-filter: blur(10px);
    border: 1px solid var(--surface-border);
    border-radius: 20px;
    padding: 2rem 1.5rem;
    transition: all 0.3s ease;
  }
  .features .card:hover {
    transform: translateY(-6px);
    background: var(--surface-hover);
    border-color: var(--surface-border-hover);
    box-shadow: var(--card-shadow);
  }
  /* staggered fade-in */
  .features .card:nth-child(2) { animation-delay: 0.08s; }
  .features .card:nth-child(3) { animation-delay: 0.16s; }
  .features .card h3 {
    width: fit-content; /* shrink gradient to text width */
    font-size: 1.65rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    background: var(--heading-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .features .card p {
    color: var(--text-secondary);
    line-height: 1.6;
    font-size: 1.08rem;
  }

  /* ---- Below the fold: same background logic as the footer ----
     Solid --footer-bg paints over the html gradient AND the fixed dot-grid
     canvas (z-index -1 sits below normal-flow backgrounds) */
  .home-lower {
    background: var(--footer-bg);
    border-top: 1px solid var(--surface-border);
    padding: 2rem 2.5rem 4.5rem;
    text-align: left;
  }
  .lower-inner {
    max-width: 1080px;
    margin: 0 auto;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin: 2.5rem 0 0.6rem;
  }
  .section-head h2 {
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--text);
  }
  .more-link {
    font-size: 0.9rem;
    color: var(--accent-text);
    text-decoration: none;
  }
  .more-link:hover {
    text-decoration: underline;
  }

  .latest-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .latest-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.05rem 0.5rem;
    border-bottom: 1px dashed var(--surface-border);
    text-decoration: none;
  }
  .latest-list li:last-child .latest-item {
    border-bottom: none;
  }
  .latest-title {
    color: var(--text);
    font-weight: 600;
    font-size: 1.1rem;
    transition: color 0.2s ease;
  }
  .latest-item:hover .latest-title {
    color: var(--accent-text);
  }
  .latest-item time {
    flex-shrink: 0;
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .quick-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 1rem;
  }
  .quick-card {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.35rem 1.2rem;
    background: var(--surface);
    border: 1px solid var(--surface-border);
    border-radius: 18px;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  .quick-card:hover {
    transform: translateY(-4px);
    background: var(--surface-hover);
    border-color: var(--surface-border-hover);
    box-shadow: var(--card-shadow);
  }
  .qc-title {
    font-size: 1.12rem;
    font-weight: 700;
    color: var(--text);
    transition: color 0.2s ease;
  }
  .quick-card:hover .qc-title {
    color: var(--accent-text);
  }
  .qc-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* narrow viewports: let the tagline wrap (nowrap needs ~830px+) */
  @media (max-width: 900px) {
    .hero .tagline {
      white-space: normal;
    }
  }

  /* mobile */
  @media (max-width: 768px) {
    .container {
      text-align: center;
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
    /* First screen = headline only: hero-screen fills everything below the
       fixed navbar (= the container's 5rem top padding), so the headline is
       vertically centered on screen and the cards fall below the fold */
    .hero-screen {
      min-height: calc(100vh - 5rem); /* fallback for older browsers */
      min-height: calc(100svh - 5rem); /* initial viewport (URL bar shown) */
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .hero h1 {
      font-size: 2.1rem;
      margin-inline: auto; /* stay centered now that width is fit-content */
    }
    .hero .subtitle {
      font-size: 1.6rem;
    }
    .hero .tagline {
      font-size: 1.1rem;
    }
    .features {
      margin-top: 5rem; /* clear separation from the first screen */
      grid-template-columns: 1fr;
    }
    .home-lower {
      padding: 1.5rem 1.5rem 3.5rem;
    }
    .section-head {
      margin-top: 1.75rem;
    }
    .quick-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .latest-item {
      padding: 0.9rem 0.25rem;
    }
  }
</style>
