---
import PostsLayout from '../../layouts/PostsLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
  (a, b) => (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0)
);

const pad2 = (value: number) => String(value).padStart(2, '0');
---

<PostsLayout title="Posts | HConzlvra_" description="A personal journal of notes, memories, and passing thoughts.">
  <section class="posts-page enter-left">
    <header class="writing-hero">
      <p class="eyebrow"><span class="eyebrow-mark"></span> PERSONAL JOURNAL <span>/</span> SINCE 2026</p>
      <div class="hero-main">
        <div class="hero-copy">
          <h1>Words,<br /><em>in passing.</em></h1>
          <p class="hero-zh">Here contains my words.</p>
        </div>
        <aside class="journal-mark" aria-label={`${posts.length} journal entries`}>
          <span class="journal-caption">THE NOTEBOOK</span>
          <span class="journal-count">{pad2(posts.length)}</span>
          <span class="journal-description">ENTRIES<br />AND COUNTING</span>
          <span class="journal-orbit" aria-hidden="true"></span>
        </aside>
      </div>
      <div class="hero-foot">
        <p class="intro">A small record of what I notice, learn, and carry.</p>
        <span class="hero-motto">LEARN <i>·</i> REALIZE <i>·</i> INSIGHT</span>
      </div>
    </header>

    <section class="writing-index" aria-labelledby="writing-index-title">
      <div class="index-heading">
        <div>
          <span class="index-kicker">01 <i>/</i> CHRONOLOGY</span>
          <h2 id="writing-index-title">Recent entries<span>.</span></h2>
        </div>
        <span class="index-count">{pad2(posts.length)} {posts.length === 1 ? 'RECORD' : 'RECORDS'}</span>
      </div>

      {
        posts.length === 0 ? (
          <div class="empty-state">
            <span class="empty-glyph">✳</span>
            <p>The page is still waiting for its first words.</p>
            <span>Come back when there is something to tell.</span>
          </div>
        ) : (
          <ul class="post-list">
            {posts.map((post) => (
              <li
                data-slug={post.id}
                data-title={post.data.title}
                data-date={post.data.pubDate?.toISOString() ?? ''}
                data-desc={post.data.description ?? ''}
              >
                <a href={`/posts/${post.id}`} class="post-item">
                  <div class="item-top">
                    <span class="item-title">{post.data.title}</span>
                    {post.data.pubDate && (
                      <time class="item-date" datetime={post.data.pubDate.toISOString()}>
                        {post.data.pubDate.toLocaleDateString('en-US', {
                          year: 'numeric',
                          month: 'long',
                          day: 'numeric',
                        })}
                      </time>
                    )}
                  </div>
                  {post.data.description && <p class="item-desc">{post.data.description}</p>}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <footer class="archive-footer"><span>END OF THE NOTEBOOK</span><span>HCONZLVRA_ <i>✳</i></span></footer>
  </section>
</PostsLayout>

<style>
  .posts-page {
    width: min(100%, 1080px);
    margin: 0 auto;
    padding-bottom: 1rem;
  }

  .writing-hero {
    position: relative;
    padding: 1.5rem 0 2.2rem;
    border-bottom: 1px solid var(--surface-border);
  }

  .eyebrow,
  .journal-caption,
  .journal-description,
  .hero-motto,
  .index-kicker,
  .index-count,
  .archive-footer {
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.15em;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--text-secondary);
    font-size: 0.68rem;
  }

  .eyebrow > span:not(.eyebrow-mark) {
    color: var(--btn-primary-bg);
  }

  .eyebrow-mark {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--btn-primary-bg);
    box-shadow: 0 0 0 0.25rem color-mix(in srgb, var(--btn-primary-bg) 16%, transparent);
  }

  .hero-main {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
  }

  .writing-hero h1 {
    width: fit-content;
    margin: 1.25rem 0 0 -0.06em;
    background: var(--heading-gradient);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-size: clamp(3.7rem, 8vw, 6.8rem);
    font-weight: 750;
    letter-spacing: -0.08em;
    line-height: 0.9;
  }

  .writing-hero h1 em {
    font-family: ui-serif, Georgia, 'Times New Roman', serif;
    font-weight: 500;
    letter-spacing: -0.085em;
  }

  .hero-zh {
    margin-top: 1.15rem;
    color: var(--text);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .journal-mark {
    position: relative;
    display: grid;
    flex: 0 0 11rem;
    grid-template-columns: 1fr auto;
    align-items: end;
    overflow: hidden;
    min-height: 9.8rem;
    padding: 1.15rem 1.3rem;
    border: 1px solid var(--surface-border);
    border-radius: 1rem 1rem 0.25rem 1rem;
    background: var(--surface);
    box-shadow: var(--card-shadow);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .journal-caption {
    position: relative;
    z-index: 1;
    grid-column: 1 / -1;
    align-self: start;
    color: var(--text-secondary);
    font-size: 0.58rem;
    letter-spacing: 0.13em;
  }

  .journal-count {
    position: relative;
    z-index: 1;
    color: var(--accent-text);
    font-size: 4rem;
    font-weight: 700;
    letter-spacing: -0.1em;
    line-height: 0.9;
  }

  .journal-description {
    position: relative;
    z-index: 1;
    padding-bottom: 0.2rem;
    color: var(--text-secondary);
    font-size: 0.55rem;
    line-height: 1.7;
    text-align: right;
  }

  .journal-orbit {
    position: absolute;
    top: -1.7rem;
    right: -1.1rem;
    width: 5.7rem;
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--btn-primary-bg) 34%, transparent);
    border-radius: 50%;
  }

  .journal-orbit::before,
  .journal-orbit::after {
    position: absolute;
    content: '';
    border: 1px solid color-mix(in srgb, var(--btn-primary-bg) 22%, transparent);
    border-radius: 50%;
  }

  .journal-orbit::before {
    inset: 0.7rem;
  }

  .journal-orbit::after {
    inset: 1.4rem;
  }

  .hero-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .intro {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .hero-motto {
    flex: 0 0 auto;
    color: var(--text-secondary);
    font-size: 0.6rem;
    letter-spacing: 0.11em;
  }

  .hero-motto i {
    padding: 0 0.2rem;
    color: var(--btn-primary-bg);
    font-style: normal;
  }

  .writing-index {
    padding-top: 2rem;
  }

  .index-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .index-heading > div {
    display: grid;
    gap: 0.2rem;
  }

  .index-kicker {
    color: var(--text-secondary);
    font-size: 0.58rem;
  }

  .index-kicker i {
    color: var(--btn-primary-bg);
    font-style: normal;
  }

  .index-heading h2 {
    width: fit-content;
    background: var(--heading-gradient);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.045em;
  }

  .index-heading h2 span {
    color: var(--btn-primary-bg);
    -webkit-text-fill-color: var(--btn-primary-bg);
  }

  .index-count {
    padding-bottom: 0.3rem;
    color: var(--text-secondary);
    font-size: 0.6rem;
  }

  .post-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
    padding: 0;
    margin: 0;
    list-style: none;
    counter-reset: post-entry;
  }

  .post-list li {
    min-width: 0;
    counter-increment: post-entry;
  }

  .post-item {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 11.5rem;
    height: 100%;
    padding: 1.15rem 1.25rem 1.2rem;
    overflow: hidden;
    border: 1px solid var(--surface-border);
    border-radius: 0.85rem 0.85rem 0.85rem 0.2rem;
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.025);
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }

  .post-item::before {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    content: counter(post-entry, decimal-leading-zero);
    color: var(--btn-primary-bg);
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
  }

  .post-item::after {
    position: absolute;
    right: 1.2rem;
    bottom: 1.1rem;
    content: '↗';
    color: var(--text-secondary);
    font-size: 1rem;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .post-item:hover {
    transform: translateY(-3px);
    border-color: var(--surface-border-hover);
    background: var(--surface-hover);
    box-shadow: var(--card-shadow);
  }

  .post-item:hover::after {
    color: var(--btn-primary-bg);
    transform: translate(2px, -2px);
  }

  .item-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2.8rem;
  }

  .item-title {
    font-size: 1.22rem;
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 1.3;
    transition: color 0.2s ease;
  }

  .post-item:hover .item-title {
    color: var(--accent-text);
  }

  .item-date {
    flex: 0 0 auto;
    padding-top: 0.15rem;
    color: var(--text-secondary);
    font-size: 0.67rem;
    white-space: nowrap;
  }

  .item-desc {
    max-width: 38rem;
    margin: 1rem 2.4rem 0 0;
    color: var(--text-secondary);
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .empty-state {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    padding: 4.5rem 1rem;
    color: var(--text-secondary);
    text-align: center;
    font-size: 0.9rem;
  }

  .empty-state p {
    color: var(--text);
    font-weight: 600;
  }

  .empty-glyph {
    margin-bottom: 0.45rem;
    color: var(--btn-primary-bg);
    font-size: 1.8rem;
  }

  .archive-footer {
    display: flex;
    justify-content: space-between;
    margin-top: 2.5rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--surface-border);
    color: var(--text-secondary);
    font-size: 0.58rem;
  }

  .archive-footer i {
    margin-left: 0.3rem;
    color: var(--btn-primary-bg);
    font-style: normal;
  }

  @media (max-width: 760px) {
    .post-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .writing-hero {
      padding: 1rem 0 1.5rem;
    }

    .hero-main {
      align-items: flex-start;
      flex-direction: column;
      gap: 1.3rem;
    }

    .writing-hero h1 {
      margin-top: 1rem;
      font-size: clamp(3.5rem, 17vw, 5.2rem);
    }

    .journal-mark {
      flex: none;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      width: 100%;
      min-height: 0;
      padding: 0.7rem 1rem;
      column-gap: 0.8rem;
      border-radius: 0.7rem 0.7rem 0.2rem 0.7rem;
    }

    .journal-caption {
      grid-column: 1;
      grid-row: 1;
    }

    .journal-count {
      grid-column: 2;
      grid-row: 1 / 3;
      font-size: 2.7rem;
    }

    .journal-description {
      grid-column: 3;
      grid-row: 1 / 3;
    }

    .hero-foot {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.65rem;
      margin-top: 1.1rem;
    }

    .item-top {
      flex-direction: column;
      gap: 0.5rem;
    }

    .post-item {
      min-height: 10rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-item,
    .post-item::after,
    .item-title {
      transition-duration: 0.01ms;
    }
  }
</style>


