---
import PostsLayout from '../../layouts/PostsLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
  (a, b) => (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0)
);
---

<PostsLayout title="Posts | HConzlvra_" description="HConzlvra_ 的所有文章">
  <section class="posts-page enter-left">
    <h1>Here are my posts<span class="intro-zh">这里存有我的文字。</span></h1>
    <p class="intro">Learn, Realize, Insight</p>
    {
      posts.length === 0 ? (
        <p class="empty">暂无文章，敬请期待。</p>
      ) : (
        <ul class="post-list">
          {posts.map((post) => (
            <li
              data-slug={post.id}
              data-title={post.data.title}
              data-date={post.data.pubDate?.toISOString() ?? ''}
              data-desc={post.data.description ?? ''}
            >
              <a href={`/posts/${post.id}`} class="post-item">
                <div class="item-top">
                  <span class="item-title">{post.data.title}</span>
                  {post.data.pubDate && (
                    <time class="item-date" datetime={post.data.pubDate.toISOString()}>
                      {post.data.pubDate.toLocaleDateString('zh-CN', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                      })}
                    </time>
                  )}
                </div>
                {post.data.description && <p class="item-desc">{post.data.description}</p>}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</PostsLayout>

<style>
  .posts-page {
    padding-top: 0.5rem;
  }
  .posts-page h1 {
    width: fit-content; /* 渐变随文字宽度收缩：短标题也能显示完整渐变 */
    background: var(--heading-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-size: 2.2rem;
    margin-bottom: 0.5rem;
  }
  /* 中文副标：紧贴英文标题下方，字号一档小 */
  .intro-zh {
    display: block;
    font-size: 1.1rem;
    font-weight: 600;
    margin-top: 0.4rem;
  }
  .intro {
    color: var(--text-secondary);
    margin: 1.2rem 0 2.5rem;
    letter-spacing: 0.02em;
  }
  .empty {
    color: var(--text-secondary);
    padding: 2rem 0;
  }
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .post-item {
    position: relative;
    display: block;
    padding: 1.25rem 0.5rem;
    text-decoration: none;
    color: var(--text);
  }
  /* 底部横杠：悬浮时从左到右扫过 */
  .post-item::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    background: var(--btn-primary-bg);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.3s ease;
  }
  .post-item:hover::after {
    transform: scaleX(1);
  }
  .item-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .item-title {
    font-size: 1.25rem;
    font-weight: 600;
    transition: color 0.2s ease;
  }
  .post-item:hover .item-title {
    color: var(--btn-primary-bg);
  }
  .item-date {
    font-size: 0.8rem;
    color: var(--text-secondary);
    white-space: nowrap;
  }
  .item-desc {
    margin: 0.4rem 0 0;
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }
</style>

<script>
  // 动态文章合并：静态构建的列表之外，再拉取后端（D1）里通过 /admin 发布的文章，
  // 按更新时间降序混排重建列表。后端不可用或无新文章时保持静态列表原样
  const API = import.meta.env.DEV ? '/api' : 'https://guestbook-9z8.pages.dev/api';

  const fmt = (iso: string) =>
    new Date(iso).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });

  function itemEl(it: { href: string; title: string; date: string; desc: string }) {
    const li = document.createElement('li');
    const a = document.createElement('a');
    a.href = it.href;
    a.className = 'post-item';
    const top = document.createElement('div');
    top.className = 'item-top';
    const title = document.createElement('span');
    title.className = 'item-title';
    title.textContent = it.title;
    top.append(title);
    if (it.date) {
      const time = document.createElement('time');
      time.className = 'item-date';
      time.dateTime = it.date;
      time.textContent = fmt(it.date);
      top.append(time);
    }
    a.append(top);
    if (it.desc) {
      const p = document.createElement('p');
      p.className = 'item-desc';
      p.textContent = it.desc;
      a.append(p);
    }
    li.append(a);
    return li;
  }

  function mergeDynamicPosts() {
    const list = document.querySelector('.post-list') as HTMLUListElement | null;
    const empty = document.querySelector('.empty') as HTMLElement | null;

    fetch(`${API}/posts`)
      .then((res) => {
        if (!res.ok) return;
        return res.json();
      })
      .then((payload) => {
        const posts = Array.isArray(payload?.posts) ? payload.posts : [];
        const staticSlugs = new Set([...(list?.children || [])].map((li) => (li as HTMLElement).dataset.slug || ''));
        const dynamic = posts.filter((p) => p?.slug && !staticSlugs.has(p.slug));
        if (!dynamic.length) return;

        const items = [...(list?.children || [])].map((el) => {
          const li = el as HTMLElement;
          return {
            href: `/posts/${li.dataset.slug}`,
            title: li.dataset.title || '',
            date: li.dataset.date || '',
            desc: li.dataset.desc || '',
            ts: Number(new Date(li.dataset.date || 0).valueOf()) || 0,
          };
        });

        for (const p of dynamic) {
          const date = p.created_at ? new Date(p.created_at).toISOString() : '';
          items.push({
            href: `/posts/${p.slug}`,
            title: p.title || p.slug,
            date,
            desc: p.description || '',
            ts: Number(p.created_at) || 0,
          });
        }

        items.sort((a, b) => (b.ts || 0) - (a.ts || 0));

        const ul = list ?? document.createElement('ul');
        ul.className = 'post-list';
        ul.innerHTML = '';
        for (const it of items) ul.append(itemEl(it));
        if (!list) empty?.replaceWith(ul);
      })
      .catch(() => {
        // 后端不可用：保持静态列表
      });
  }

  document.addEventListener('astro:page-load', mergeDynamicPosts);
  mergeDynamicPosts();
</script>
