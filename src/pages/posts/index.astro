---
import PostsLayout from '../../layouts/PostsLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
  (a, b) => (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0)
);
---

<PostsLayout title="Posts | HConzlvra_" description="HConzlvra_ 的所有文章">
  <section class="posts-page">
    <h1>Posts</h1>
    <p class="intro">所有文章都在这里，也可以从左侧列表快速跳转。</p>
    {
      posts.length === 0 ? (
        <p class="empty">暂无文章，敬请期待。</p>
      ) : (
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <a href={`/posts/${post.id}`} class="post-item">
                <div class="item-top">
                  <span class="item-title">{post.data.title}</span>
                  {post.data.pubDate && (
                    <time class="item-date" datetime={post.data.pubDate.toISOString()}>
                      {post.data.pubDate.toLocaleDateString('zh-CN', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                      })}
                    </time>
                  )}
                </div>
                {post.data.description && <p class="item-desc">{post.data.description}</p>}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</PostsLayout>

<style>
  .posts-page h1 {
    background: var(--heading-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-size: 2.2rem;
    margin-bottom: 0.5rem;
  }
  .posts-page {
    padding-top: 0.5rem;
  }
  .intro {
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }
  .empty {
    color: var(--text-secondary);
    padding: 2rem 0;
  }
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .post-item {
    position: relative;
    display: block;
    padding: 1.25rem 0.5rem;
    text-decoration: none;
    color: var(--text);
  }
  /* 底部横杠：悬浮时从左到右扫过 */
  .post-item::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    background: var(--btn-primary-bg);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.3s ease;
  }
  .post-item:hover::after {
    transform: scaleX(1);
  }
  .item-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .item-title {
    font-size: 1.25rem;
    font-weight: 600;
    transition: color 0.2s ease;
  }
  .post-item:hover .item-title {
    color: var(--btn-primary-bg);
  }
  .item-date {
    font-size: 0.8rem;
    color: var(--text-secondary);
    white-space: nowrap;
  }
  .item-desc {
    margin: 0.4rem 0 0;
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }
</style>
