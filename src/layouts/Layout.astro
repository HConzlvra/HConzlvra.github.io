---
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/Navbar.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'HConzlvra_', description = 'HConzlvra_ 的个人主页' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <!-- 视图切换：页面间导航不再整页重新加载 -->
    <ClientRouter />
    <script is:inline>
      // 主题初始化：优先读取本地存储，否则跟随系统偏好（必须在渲染前执行，防止闪烁）
      (function () {
        const stored = localStorage.getItem('theme');
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <script>
      // ClientRouter 软导航会把新页面的 <html data-theme="light"> 覆盖过来，
      // 每次视图切换完成后从 localStorage 重新应用用户主题（模块脚本只执行一次，监听器常驻）
      document.addEventListener('astro:after-swap', () => {
        const stored = localStorage.getItem('theme');
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.setAttribute('data-theme', theme);
      });

      // 搜索结果跳转定位：从搜索页点进某页面时，URL 带 #q=关键词，
      // 在目标页找到第一处匹配，滚动到视口中部并临时高亮
      const scrollToSearchHit = () => {
        const hash = window.location.hash;
        const m = hash.match(/^#q=(.+)$/);
        if (!m) return;
        const q = decodeURIComponent(m[1]).trim();
        if (!q) return;

        const main = document.querySelector('main');
        if (!main) return;

        // 用 TreeWalker 找到第一个包含关键词的文本节点
        const walker = document.createTreeWalker(main, NodeFilter.SHOW_TEXT, {
          acceptNode(node) {
            const text = node.textContent ?? '';
            return text.toLowerCase().includes(q.toLowerCase())
              ? NodeFilter.FILTER_ACCEPT
              : NodeFilter.FILTER_REJECT;
          },
        });
        const textNode = walker.nextNode();
        if (!textNode || !textNode.textContent) return;
        const text = textNode.textContent;
        const idx = text.toLowerCase().indexOf(q.toLowerCase());
        if (idx < 0) return;

        // 把匹配片段包进 <mark class="search-hit"> 以便定位和高亮
        const range = document.createRange();
        range.setStart(textNode, idx);
        range.setEnd(textNode, idx + q.length);
        const mark = document.createElement('mark');
        mark.className = 'search-hit';
        try {
          range.surroundContents(mark);
        } catch {
          return; // 跨元素边界无法包围时跳过
        }

        requestAnimationFrame(() => {
          mark.scrollIntoView({ behavior: 'smooth', block: 'center' });
        });

        // 8 秒后移除高亮（用户可能想继续看页面）
        window.setTimeout(() => {
          const parent = mark.parentNode;
          if (parent) parent.replaceChild(document.createTextNode(mark.textContent ?? ''), mark);
        }, 8000);

        // 清掉 hash，避免刷新时重复定位（不触发页面滚动）
        history.replaceState(null, '', window.location.pathname + window.location.search);
      };

      document.addEventListener('astro:page-load', scrollToSearchHit);
    </script>
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <ThemeToggle />
  </body>
</html>
