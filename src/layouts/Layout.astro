---
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/Navbar.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'HConzlvra_', description = "HConzlvra_'s Site" } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <!-- 移动端浏览器 UI（地址栏/底栏）颜色跟随主题，与 --html-bg 同值 -->
    <meta name="theme-color" content="#efeaf5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0913" media="(prefers-color-scheme: dark)" /><!-- 与深色 --html-bg 同值 -->
    <meta name="description" content={description} />
    <slot name="head" />
    <title>{title}</title>
    <!-- 视图切换：页面间导航不再整页重新加载 -->
    <ClientRouter />
    <script is:inline>
      // 主题初始化：优先读取本地存储，否则跟随系统偏好（必须在渲染前执行，防止闪烁）
      (function () {
        const stored = localStorage.getItem('theme');
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <script>
      // ClientRouter 软导航会把新页面的 <html data-theme="light"> 覆盖过来，
      // 每次视图切换完成后从 localStorage 重新应用用户主题（模块脚本只执行一次，监听器常驻）
      document.addEventListener('astro:after-swap', () => {
        const stored = localStorage.getItem('theme');
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.setAttribute('data-theme', theme);
      });

      // 手动切换主题时同步更新 meta theme-color（覆盖上面的 prefers-color-scheme 版本），
      // 否则移动端浏览器地址栏颜色跟系统偏好走，和页面实际主题不一致
      const syncThemeColor = () => {
        const color =
          document.documentElement.getAttribute('data-theme') === 'dark' ? '#0a0913' : '#efeaf5';
        for (const meta of document.querySelectorAll('meta[name="theme-color"]')) {
          meta.setAttribute('content', color);
          meta.removeAttribute('media');
        }
      };
      new MutationObserver(syncThemeColor).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme'],
      });
      syncThemeColor();

      // 搜索结果跳转定位：从搜索页点进某页面时，URL 带 #q=关键词，
      // 在目标页找到第一处匹配，滚动到视口中部并临时高亮
      const scrollToSearchHit = () => {
        const hash = window.location.hash;
        const m = hash.match(/^#q=(.+)$/);
        if (!m) return;
        const q = decodeURIComponent(m[1]).trim();
        if (!q) return;

        const main = document.querySelector('main');
        if (!main) return;

        const qLower = q.toLowerCase();

        // 判断一个文本节点是否在"渐变文字"元素内：
        // 渐变标题用 -webkit-text-fill-color: transparent + background-clip: text，
        // 套 <mark> 后黄底会被裁成文字形状不可见，所以这类节点要跳过，
        // 继续找下一个在普通文本里的匹配。
        const isGradientText = (node: Node | null) => {
          let el: Element | null = node instanceof Element ? node : node?.parentElement ?? null;
          while (el && el !== main) {
            const cs = getComputedStyle(el);
            const fill = cs.getPropertyValue('-webkit-text-fill-color');
            const clip = String((cs as any).webkitBackgroundClip || cs.backgroundClip || '');
            // transparent 的计算值通常是 rgba(0,0,0,0)：取最后一个逗号后的数值作为 alpha
            let isTransparent = fill === 'transparent';
            if (!isTransparent && fill.indexOf('rgba') === 0) {
              const lastComma = fill.lastIndexOf(',');
              const lastParen = fill.lastIndexOf(')');
              if (lastComma >= 0 && lastParen > lastComma) {
                const alpha = parseFloat(fill.slice(lastComma + 1, lastParen).trim());
                if (alpha === 0) isTransparent = true;
              }
            }
            if (isTransparent && clip.indexOf('text') >= 0) return true;
            el = el.parentElement;
          }
          return false;
        };

        // 用 TreeWalker 遍历文本节点，跳过渐变文字，直到找到可高亮的匹配
        const walker = document.createTreeWalker(main, NodeFilter.SHOW_TEXT, {
          acceptNode(node) {
            if (!node.textContent?.toLowerCase().includes(qLower)) return NodeFilter.FILTER_REJECT;
            if (isGradientText(node)) return NodeFilter.FILTER_SKIP;
            return NodeFilter.FILTER_ACCEPT;
          },
        });
        const textNode = walker.nextNode();
        if (!textNode || !textNode.textContent) return;
        const text = textNode.textContent;
        const idx = text.toLowerCase().indexOf(qLower);
        if (idx < 0) return;

        // 把匹配片段包进 <mark class="search-hit"> 以便定位和高亮
        const range = document.createRange();
        range.setStart(textNode, idx);
        range.setEnd(textNode, idx + q.length);
        const mark = document.createElement('mark');
        mark.className = 'search-hit';
        try {
          range.surroundContents(mark);
        } catch {
          return; // 跨元素边界无法包围时跳过
        }

        requestAnimationFrame(() => {
          mark.scrollIntoView({ behavior: 'smooth', block: 'center' });
        });

        // 动画播放完毕后移除 mark，把文字还原回普通文本（不干扰后续阅读）
        mark.addEventListener('animationend', () => {
          const parent = mark.parentNode;
          if (parent) parent.replaceChild(document.createTextNode(mark.textContent ?? ''), mark);
        });

        // 清掉 hash，避免刷新时重复定位（不触发页面滚动）
        history.replaceState(null, '', window.location.pathname + window.location.search);
      };

      document.addEventListener('astro:page-load', scrollToSearchHit);
      // 兜底：初始加载时若 astro:page-load 已在模块执行前触发，
      // 直接调用一次（带 hash 才执行，无副作用）
      if (window.location.hash.startsWith('#q=')) scrollToSearchHit();
    </script>

    <script>
      // 全局鼠标拖尾 + 自绘指针：
      // - 指针本体替换成紫色小方块（隐藏系统指针）
      // - 指针走过的路径上每 9px 落一个小方块（相邻只搭一点点角，不重叠）
      // - 只保留紧跟指针的一小段（约 6 个），超范围的快速淡出，残留极少
      // 仅限精确指针设备（鼠标/触控笔）且用户未开启"减少动态效果"
      if (
        matchMedia('(pointer: fine)').matches &&
        !matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        const PURPLE = '#9c6fe0';
        const SIZE = 9; // 方块边长（px）：指针与拖尾统一
        const GAP = 9; // 每移动满 9px 落一个：与方块同尺寸，相邻只搭一点角不重叠
        const MAX_DIST = 54; // 尾巴离指针最远 54px（≈6 个方块）：只留紧跟指针的一小段
        const LEAVE_MS = 100; // 超范围方块淡出时长：极快，高速甩动也不留残影
        const MAX_SQUARES = 24; // 同时在场方块上限（安全兜底，正常到不了）

        // 隐藏系统指针（改由 #cursor-dot 自绘）；类挂在 <html> 上
        const hideNativeCursor = () => document.documentElement.classList.add('cursor-none');
        hideNativeCursor();

        // 指针最后已知位置：初始取视口中心——鼠标还没动时指针方块也已显示
        let px = window.innerWidth / 2;
        let py = window.innerHeight / 2;

        // 拖尾层 + 指针方块：ClientRouter 换页会换掉整个 body，
        // 元素随旧 body 消失，每次 mousemove 前确认还在
        let layer: HTMLElement | null = null;
        let dot: HTMLElement | null = null;
        const ensureEls = () => {
          if (!layer || !layer.isConnected) {
            layer = document.createElement('div');
            layer.id = 'cursor-trail';
            document.body.appendChild(layer);
          }
          if (!dot || !dot.isConnected) {
            dot = document.createElement('div');
            dot.id = 'cursor-dot';
            // 与拖尾方块同款：9px 紫色方块
            dot.style.width = `${SIZE}px`;
            dot.style.height = `${SIZE}px`;
            dot.style.background = PURPLE;
            dot.style.transform = `translate(${px - SIZE / 2}px, ${py - SIZE / 2}px)`;
            document.body.appendChild(dot);
          }
        };
        // 页面一加载就创建：指针方块永远在，不等第一次移动
        ensureEls();

        const spawn = (x: number, y: number) => {
          const box = layer!;
          const el = document.createElement('div');
          el.className = 'px';
          el.style.width = `${SIZE}px`;
          el.style.height = `${SIZE}px`;
          // 方块以 (x,y) 为中心
          el.style.left = `${x - SIZE / 2}px`;
          el.style.top = `${y - SIZE / 2}px`;
          el.style.background = PURPLE;
          // 停住指针后 ~0.24-0.36s 尾巴自己淡出；拖动中超范围的走更快的 px-leave
          el.style.setProperty('--life', `${(240 + Math.random() * 120).toFixed(0)}ms`);
          el.addEventListener('animationend', () => el.remove());
          box.appendChild(el);
          while (box.children.length > MAX_SQUARES) box.firstElementChild?.remove();
        };

        // 超范围方块的快速淡出；标记 leaving 防止每次移动重复重启动画
        const fadeOut = (el: HTMLElement) => {
          if (el.dataset.leaving) return;
          el.dataset.leaving = '1';
          el.style.animation = `px-leave ${LEAVE_MS}ms steps(2, end) forwards`;
        };

        // 离指针过远的方块触发快速淡出：无论拖多快，只留紧跟指针的一小段
        const pruneFar = (x: number, y: number) => {
          if (!layer) return;
          const limit = MAX_DIST * MAX_DIST;
          for (let i = layer.children.length - 1; i >= 0; i--) {
            const el = layer.children[i] as HTMLElement;
            const dx = parseFloat(el.style.left) + SIZE / 2 - x;
            const dy = parseFloat(el.style.top) + SIZE / 2 - y;
            if (dx * dx + dy * dy > limit) fadeOut(el);
          }
        };

        // 软导航后 <html> 属性会被新页面覆盖、body 被整体替换：
        // 重新隐藏系统指针并立即重建指针方块（沿用最后位置），换页后不等移动就有指针
        document.addEventListener('astro:after-swap', () => {
          hideNativeCursor();
          layer = null;
          dot = null;
          ensureEls();
        });

        let sx = -1; // 上一次落点：每累计满 9px 才落一个，不足的距离留到下次累计
        let sy = -1;
        window.addEventListener(
          'mousemove',
          (e) => {
            ensureEls();
            const x = e.clientX;
            const y = e.clientY;
            px = x;
            py = y;
            // 指针方块本体：每个事件同步贴住真实指针位置，无任何过渡/缓动，零滞后
            dot!.style.transform = `translate(${x - SIZE / 2}px, ${y - SIZE / 2}px)`;

            if (sx < 0) {
              sx = x;
              sy = y;
              return;
            }
            let dx = x - sx;
            let dy = y - sy;
            let dist = Math.hypot(dx, dy);
            // 跨窗口跳入等超大跨度：超过尾巴长度的部分没有意义，
            // 直接把落点截到距新位置 MAX_DIST 处，保证一次最多落 ~6 个
            if (dist > MAX_DIST) {
              const t = (dist - MAX_DIST) / dist;
              sx += dx * t;
              sy += dy * t;
              dx = x - sx;
              dy = y - sy;
              dist = MAX_DIST;
            }
            while (dist >= GAP) {
              const t = GAP / dist;
              sx += dx * t;
              sy += dy * t;
              spawn(sx, sy);
              dx = x - sx;
              dy = y - sy;
              dist = Math.hypot(dx, dy);
            }
            pruneFar(x, y);
          },
          { passive: true }
        );
      }
    </script>
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <ThemeToggle />
  </body>
</html>
