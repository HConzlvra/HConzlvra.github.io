---
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/Navbar.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'HConzlvra_', description = "HConzlvra_'s Site" } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <!-- 移动端浏览器 UI（地址栏/底栏）颜色跟随主题，与 --html-bg 同值 -->
    <meta name="theme-color" content="#efeaf5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0913" media="(prefers-color-scheme: dark)" /><!-- 与深色 --html-bg 同值 -->
    <meta name="description" content={description} />
    <slot name="head" />
    <title>{title}</title>
    <!-- 视图切换：页面间导航不再整页重新加载 -->
    <ClientRouter />
    <script is:inline>
      // 主题初始化：优先读取本地存储，否则跟随系统偏好（必须在渲染前执行，防止闪烁）
      (function () {
        const stored = localStorage.getItem('theme');
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <script>
      // ClientRouter 软导航会把新页面的 <html data-theme="light"> 覆盖过来，
      // 每次视图切换完成后从 localStorage 重新应用用户主题（模块脚本只执行一次，监听器常驻）
      document.addEventListener('astro:after-swap', () => {
        const stored = localStorage.getItem('theme');
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.setAttribute('data-theme', theme);
      });

      // 手动切换主题时同步更新 meta theme-color（覆盖上面的 prefers-color-scheme 版本），
      // 否则移动端浏览器地址栏颜色跟系统偏好走，和页面实际主题不一致
      const syncThemeColor = () => {
        const color =
          document.documentElement.getAttribute('data-theme') === 'dark' ? '#0a0913' : '#efeaf5';
        for (const meta of document.querySelectorAll('meta[name="theme-color"]')) {
          meta.setAttribute('content', color);
          meta.removeAttribute('media');
        }
      };
      new MutationObserver(syncThemeColor).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme'],
      });
      syncThemeColor();

      // 搜索结果跳转定位：从搜索页点进某页面时，URL 带 #q=关键词，
      // 在目标页找到第一处匹配，滚动到视口中部并临时高亮
      const scrollToSearchHit = () => {
        const hash = window.location.hash;
        const m = hash.match(/^#q=(.+)$/);
        if (!m) return;
        const q = decodeURIComponent(m[1]).trim();
        if (!q) return;

        const main = document.querySelector('main');
        if (!main) return;

        const qLower = q.toLowerCase();

        // 判断一个文本节点是否在"渐变文字"元素内：
        // 渐变标题用 -webkit-text-fill-color: transparent + background-clip: text，
        // 套 <mark> 后黄底会被裁成文字形状不可见，所以这类节点要跳过，
        // 继续找下一个在普通文本里的匹配。
        const isGradientText = (node: Node | null) => {
          let el: Element | null = node instanceof Element ? node : node?.parentElement ?? null;
          while (el && el !== main) {
            const cs = getComputedStyle(el);
            const fill = cs.getPropertyValue('-webkit-text-fill-color');
            const clip = String((cs as any).webkitBackgroundClip || cs.backgroundClip || '');
            // transparent 的计算值通常是 rgba(0,0,0,0)：取最后一个逗号后的数值作为 alpha
            let isTransparent = fill === 'transparent';
            if (!isTransparent && fill.indexOf('rgba') === 0) {
              const lastComma = fill.lastIndexOf(',');
              const lastParen = fill.lastIndexOf(')');
              if (lastComma >= 0 && lastParen > lastComma) {
                const alpha = parseFloat(fill.slice(lastComma + 1, lastParen).trim());
                if (alpha === 0) isTransparent = true;
              }
            }
            if (isTransparent && clip.indexOf('text') >= 0) return true;
            el = el.parentElement;
          }
          return false;
        };

        // 用 TreeWalker 遍历文本节点，跳过渐变文字，直到找到可高亮的匹配
        const walker = document.createTreeWalker(main, NodeFilter.SHOW_TEXT, {
          acceptNode(node) {
            if (!node.textContent?.toLowerCase().includes(qLower)) return NodeFilter.FILTER_REJECT;
            if (isGradientText(node)) return NodeFilter.FILTER_SKIP;
            return NodeFilter.FILTER_ACCEPT;
          },
        });
        const textNode = walker.nextNode();
        if (!textNode || !textNode.textContent) return;
        const text = textNode.textContent;
        const idx = text.toLowerCase().indexOf(qLower);
        if (idx < 0) return;

        // 把匹配片段包进 <mark class="search-hit"> 以便定位和高亮
        const range = document.createRange();
        range.setStart(textNode, idx);
        range.setEnd(textNode, idx + q.length);
        const mark = document.createElement('mark');
        mark.className = 'search-hit';
        try {
          range.surroundContents(mark);
        } catch {
          return; // 跨元素边界无法包围时跳过
        }

        requestAnimationFrame(() => {
          mark.scrollIntoView({ behavior: 'smooth', block: 'center' });
        });

        // 动画播放完毕后移除 mark，把文字还原回普通文本（不干扰后续阅读）
        mark.addEventListener('animationend', () => {
          const parent = mark.parentNode;
          if (parent) parent.replaceChild(document.createTextNode(mark.textContent ?? ''), mark);
        });

        // 清掉 hash，避免刷新时重复定位（不触发页面滚动）
        history.replaceState(null, '', window.location.pathname + window.location.search);
      };

      document.addEventListener('astro:page-load', scrollToSearchHit);
      // 兜底：初始加载时若 astro:page-load 已在模块执行前触发，
      // 直接调用一次（带 hash 才执行，无副作用）
      if (window.location.hash.startsWith('#q=')) scrollToSearchHit();
    </script>

    <script>
      // 全局鼠标拖尾 + 自绘指针（固定元素池 + 粒子寿命方案）：
      // - 指针本体 = 1 个紫色方块，渲染循环里每帧直贴最新鼠标坐标，零过渡零动画
      // - 拖尾 = 固定 6 个方块 = 6 个"粒子"：沿鼠标轨迹等距采样（每 9px 一个点）
      // - 粒子从诞生的那一瞬就开始线性溶解（透明度 = 剩余寿命比例，每帧直写）：
      //   移动中就是渐隐的彗尾；停住时不需要任何等待，各自按出生顺序继续化完
      // - 元素常驻复用、永不创建销毁：数量恒定、无残影堆积、开销恒定
      // 仅限精确指针设备（鼠标/触控笔）且用户未开启"减少动态效果"
      if (
        matchMedia('(pointer: fine)').matches &&
        !matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        const SIZE = 9; // 方块边长（px）
        const GAP = 9; // 采样间距 = 方块尺寸：直线移动时相邻方块正好边贴边
        const COUNT = 6; // 拖尾方块数（不含指针本体）
        const LIFE_MIN = 300; // 单个粒子寿命下限（ms）：从诞生持续溶解到 0
        const LIFE_MAX = 380; // 单个粒子寿命上限（ms）：随机微差让淡出更自然

        // 隐藏系统指针（改由 #cursor-dot 自绘）；类挂在 <html> 上
        const hideNativeCursor = () => document.documentElement.classList.add('cursor-none');
        hideNativeCursor();

        // 鼠标最新坐标：初始取视口中心，指针方块加载即显示
        let mx = window.innerWidth / 2;
        let my = window.innerHeight / 2;

        // 等距采样：鼠标累计每移动满 GAP px 记一个采样点，队列只留最近 COUNT 个。
        // 拖尾方块 i 就摆在倒数第 i+1 个采样点上——尾巴严格贴着走过的轨迹
        let sx = -1;
        let sy = -1;
        let samples: { x: number; y: number; t: number; life: number }[] = [];

        // 元素池（ClientRouter 换页会替换整个 body，循环里每次确认还在）
        let layer: HTMLElement | null = null;
        let dot: HTMLElement | null = null;
        let trail: HTMLElement[] = [];
        const ensureEls = () => {
          if (!layer || !layer.isConnected) {
            layer = document.createElement('div');
            layer.id = 'cursor-trail';
            document.body.appendChild(layer);
            trail = [];
          }
          if (!trail.length) {
            for (let i = 0; i < COUNT; i++) {
              const el = document.createElement('div');
              el.className = 'px';
              el.style.opacity = '0'; // 初始隐藏：有采样点才逐个亮起
              layer.appendChild(el);
              trail.push(el);
            }
          }
          if (!dot || !dot.isConnected) {
            dot = document.createElement('div');
            dot.id = 'cursor-dot';
            document.body.appendChild(dot);
          }
        };
        ensureEls();

        window.addEventListener(
          'mousemove',
          (e) => {
            mx = e.clientX;
            my = e.clientY;
            if (sx < 0) {
              sx = mx;
              sy = my;
              return;
            }
            // 沿本次移动的连线每满 GAP px 落一个采样点：
            // 间距恒定，慢速密、快速疏不会断，也绝不会重叠
            let dx = mx - sx;
            let dy = my - sy;
            let dist = Math.hypot(dx, dy);
            while (dist >= GAP) {
              const t = GAP / dist;
              sx += dx * t;
              sy += dy * t;
              samples.push({
                x: sx,
                y: sy,
                t: performance.now(),
                life: LIFE_MIN + Math.random() * (LIFE_MAX - LIFE_MIN),
              });
              if (samples.length > COUNT) samples.shift();
              dx = mx - sx;
              dy = my - sy;
              dist = Math.hypot(dx, dy);
            }
          },
          { passive: true }
        );

        // 软导航后 <html> 属性会被新页面覆盖、body 被整体替换：
        // 重新隐藏系统指针、重建元素池并重置采样
        document.addEventListener('astro:after-swap', () => {
          hideNativeCursor();
          layer = null;
          dot = null;
          trail = [];
          sx = -1;
          sy = -1;
          samples = [];
          ensureEls();
        });

        // 常驻渲染循环：指针每帧直贴鼠标；拖尾粒子摆到各自采样点，
        // 透明度直接按"剩余寿命"每帧重算——粒子从出生就在溶解，
        // 停下时无需任何等待/切换，各自顺着剩余进度继续化掉
        const tick = () => {
          ensureEls();
          const now = performance.now();
          dot!.style.transform = `translate(${mx - SIZE / 2}px, ${my - SIZE / 2}px)`;
          for (let i = 0; i < COUNT; i++) {
            const el = trail[i];
            const s = samples[samples.length - 1 - i];
            if (!s) {
              if (el.style.opacity !== '0') el.style.opacity = '0';
              continue;
            }
            el.style.transform = `translate(${s.x - SIZE / 2}px, ${s.y - SIZE / 2}px)`;
            const p = Math.min(1, (now - s.t) / s.life);
            el.style.opacity = (1 - p).toFixed(3);
          }
          requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    </script>
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <ThemeToggle />
  </body>
</html>
