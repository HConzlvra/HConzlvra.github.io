---
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/Navbar.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Footer from '../components/Footer.astro';
import SearchData from '../components/SearchData.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'HConzlvra_', description = 'HConzlvra_ 的个人主页' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <!-- 视图切换：页面间导航不再整页重新加载 -->
    <ClientRouter />
    <script is:inline>
      // 主题初始化：优先读取本地存储，否则跟随系统偏好（必须在渲染前执行，防止闪烁）
      (function () {
        const stored = localStorage.getItem('theme');
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <script>
      // ClientRouter 软导航会把新页面的 <html data-theme="light"> 覆盖过来，
      // 每次视图切换完成后从 localStorage 重新应用用户主题（模块脚本只执行一次，监听器常驻）
      document.addEventListener('astro:after-swap', () => {
        const stored = localStorage.getItem('theme');
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.setAttribute('data-theme', theme);
      });
    </script>
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <ThemeToggle />
    <SearchData />
  </body>
</html>
