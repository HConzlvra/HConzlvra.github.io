---
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/Navbar.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'HConzlvra_', description = "HConzlvra_'s Site" } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <!-- 移动端浏览器 UI（地址栏/底栏）颜色跟随主题，与 --html-bg 同值 -->
    <meta name="theme-color" content="#efeaf5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0913" media="(prefers-color-scheme: dark)" /><!-- 与深色 --html-bg 同值 -->
    <meta name="description" content={description} />
    <slot name="head" />
    <title>{title}</title>
    <!-- 视图切换：页面间导航不再整页重新加载 -->
    <ClientRouter />
    <script is:inline>
      // 主题初始化：优先读取本地存储，否则跟随系统偏好（必须在渲染前执行，防止闪烁）
      (function () {
        const stored = localStorage.getItem('theme');
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <script>
      // ClientRouter 软导航会把新页面的 <html data-theme="light"> 覆盖过来，
      // 每次视图切换完成后从 localStorage 重新应用用户主题（模块脚本只执行一次，监听器常驻）
      document.addEventListener('astro:after-swap', () => {
        const stored = localStorage.getItem('theme');
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.setAttribute('data-theme', theme);
      });

      // 手动切换主题时同步更新 meta theme-color（覆盖上面的 prefers-color-scheme 版本），
      // 否则移动端浏览器地址栏颜色跟系统偏好走，和页面实际主题不一致
      const syncThemeColor = () => {
        const color =
          document.documentElement.getAttribute('data-theme') === 'dark' ? '#0a0913' : '#efeaf5';
        for (const meta of document.querySelectorAll('meta[name="theme-color"]')) {
          meta.setAttribute('content', color);
          meta.removeAttribute('media');
        }
      };
      new MutationObserver(syncThemeColor).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme'],
      });
      syncThemeColor();

      // 搜索结果跳转定位：从搜索页点进某页面时，URL 带 #q=关键词，
      // 在目标页找到第一处匹配，滚动到视口中部并临时高亮
      const scrollToSearchHit = () => {
        const hash = window.location.hash;
        const m = hash.match(/^#q=(.+)$/);
        if (!m) return;
        const q = decodeURIComponent(m[1]).trim();
        if (!q) return;

        const main = document.querySelector('main');
        if (!main) return;

        const qLower = q.toLowerCase();

        // 判断一个文本节点是否在"渐变文字"元素内：
        // 渐变标题用 -webkit-text-fill-color: transparent + background-clip: text，
        // 套 <mark> 后黄底会被裁成文字形状不可见，所以这类节点要跳过，
        // 继续找下一个在普通文本里的匹配。
        const isGradientText = (node: Node | null) => {
          let el: Element | null = node instanceof Element ? node : node?.parentElement ?? null;
          while (el && el !== main) {
            const cs = getComputedStyle(el);
            const fill = cs.getPropertyValue('-webkit-text-fill-color');
            const clip = String((cs as any).webkitBackgroundClip || cs.backgroundClip || '');
            // transparent 的计算值通常是 rgba(0,0,0,0)：取最后一个逗号后的数值作为 alpha
            let isTransparent = fill === 'transparent';
            if (!isTransparent && fill.indexOf('rgba') === 0) {
              const lastComma = fill.lastIndexOf(',');
              const lastParen = fill.lastIndexOf(')');
              if (lastComma >= 0 && lastParen > lastComma) {
                const alpha = parseFloat(fill.slice(lastComma + 1, lastParen).trim());
                if (alpha === 0) isTransparent = true;
              }
            }
            if (isTransparent && clip.indexOf('text') >= 0) return true;
            el = el.parentElement;
          }
          return false;
        };

        // 用 TreeWalker 遍历文本节点，跳过渐变文字，直到找到可高亮的匹配
        const walker = document.createTreeWalker(main, NodeFilter.SHOW_TEXT, {
          acceptNode(node) {
            if (!node.textContent?.toLowerCase().includes(qLower)) return NodeFilter.FILTER_REJECT;
            if (isGradientText(node)) return NodeFilter.FILTER_SKIP;
            return NodeFilter.FILTER_ACCEPT;
          },
        });
        const textNode = walker.nextNode();
        if (!textNode || !textNode.textContent) return;
        const text = textNode.textContent;
        const idx = text.toLowerCase().indexOf(qLower);
        if (idx < 0) return;

        // 把匹配片段包进 <mark class="search-hit"> 以便定位和高亮
        const range = document.createRange();
        range.setStart(textNode, idx);
        range.setEnd(textNode, idx + q.length);
        const mark = document.createElement('mark');
        mark.className = 'search-hit';
        try {
          range.surroundContents(mark);
        } catch {
          return; // 跨元素边界无法包围时跳过
        }

        requestAnimationFrame(() => {
          mark.scrollIntoView({ behavior: 'smooth', block: 'center' });
        });

        // 动画播放完毕后移除 mark，把文字还原回普通文本（不干扰后续阅读）
        mark.addEventListener('animationend', () => {
          const parent = mark.parentNode;
          if (parent) parent.replaceChild(document.createTextNode(mark.textContent ?? ''), mark);
        });

        // 清掉 hash，避免刷新时重复定位（不触发页面滚动）
        history.replaceState(null, '', window.location.pathname + window.location.search);
      };

      document.addEventListener('astro:page-load', scrollToSearchHit);
      // 兜底：初始加载时若 astro:page-load 已在模块执行前触发，
      // 直接调用一次（带 hash 才执行，无副作用）
      if (window.location.hash.startsWith('#q=')) scrollToSearchHit();

      // 访客统计上报（/archive 页展示）：每个会话窗口（30 分钟）最多一次，
      // sendBeacon 发空 POST 不阻塞页面；地理定位由 Cloudflare 在服务端从请求解析
      try {
        const VISIT_API = import.meta.env.DEV
          ? '/api/visit'
          : 'https://guestbook-9z8.pages.dev/api/visit';
        const last = Number(sessionStorage.getItem('visit-ts') || 0);
        if (Date.now() - last > 30 * 60 * 1000) {
          sessionStorage.setItem('visit-ts', String(Date.now()));
          navigator.sendBeacon?.(VISIT_API);
        }
      } catch {
        /* 隐私模式等场景 sessionStorage 不可用：静默跳过 */
      }
    </script>

    <script>
      // Global pointer trail + custom cursor (fixed element pool + particle lifetime):
      // - pointer body = one purple square, snapped to the latest pointer coords every frame
      // - trail = six squares = six "particles": evenly sampled along the pointer path
      // - particles dissolve from the moment they're born (opacity = remaining life),
      //   so on touch release each keeps fading out on its own — no waiting, in order
      // Desktop (fine pointer): native cursor hidden, dot always visible, mousemove driven.
      // Touch: the finger is the pointer — dot lights up while touching and fades out
      //        via CSS transition after release; the render loop idles out once everything
      //        has dissolved (saves battery on phones).
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const FINE = matchMedia('(pointer: fine)').matches;
        // Touch-only devices (phones): no mouse will ever show up, so the dot
        // shows only while a finger is down. Hybrid laptops keep desktop behavior.
        const TOUCH_ONLY = matchMedia('(pointer: coarse)').matches && !FINE;
        const SIZE = 9; // square size (px)
        const GAP = 9; // sampling distance = size: adjacent squares touch edge to edge
        const COUNT = 6; // trail squares (excluding the pointer body)
        const LIFE_MIN = 300; // particle lifetime lower bound (ms)
        const LIFE_MAX = 380; // particle lifetime upper bound (ms): slight jitter

        // Hide the native cursor only for real pointers (touch devices have none)
        const hideNativeCursor = () => document.documentElement.classList.add('cursor-none');
        if (FINE) hideNativeCursor();

        // Latest pointer coords: desktop starts centered so the dot shows on load
        let mx = window.innerWidth / 2;
        let my = window.innerHeight / 2;

        // Evenly spaced sampling: accumulate GAP px of movement per sample point,
        // keep only the most recent COUNT. Trail square i sits on sample i+1 from the end
        let sx = -1;
        let sy = -1;
        let samples: { x: number; y: number; t: number; life: number }[] = [];

        // Element pool (ClientRouter swaps the whole body; re-check every loop)
        let layer: HTMLElement | null = null;
        let dot: HTMLElement | null = null;
        let trail: HTMLElement[] = [];
        const ensureEls = () => {
          if (!layer || !layer.isConnected) {
            layer = document.createElement('div');
            layer.id = 'cursor-trail';
            document.body.appendChild(layer);
            trail = [];
          }
          if (!trail.length) {
            for (let i = 0; i < COUNT; i++) {
              const el = document.createElement('div');
              el.className = 'px';
              el.style.opacity = '0'; // hidden until it has a sample
              layer.appendChild(el);
              trail.push(el);
            }
          }
          if (!dot || !dot.isConnected) {
            dot = document.createElement('div');
            dot.id = 'cursor-dot';
            // Desktop: always visible. Touch-only: hidden until first touch
            dot.style.opacity = FINE ? '1' : '0';
            document.body.appendChild(dot);
          }
        };
        ensureEls();

        // Core sampling: called by mouse and touch handlers alike
        const moveTo = (x: number, y: number) => {
          mx = x;
          my = y;
          if (sx < 0) {
            sx = mx;
            sy = my;
            return;
          }
          // Drop one sample point per GAP px along this movement:
          // constant spacing — never breaks up, never overlaps
          let dx = mx - sx;
          let dy = my - sy;
          let dist = Math.hypot(dx, dy);
          while (dist >= GAP) {
            const t = GAP / dist;
            sx += dx * t;
            sy += dy * t;
            samples.push({
              x: sx,
              y: sy,
              t: performance.now(),
              life: LIFE_MIN + Math.random() * (LIFE_MAX - LIFE_MIN),
            });
            if (samples.length > COUNT) samples.shift();
            dx = mx - sx;
            dy = my - sy;
            dist = Math.hypot(dx, dy);
          }
        };

        // Render loop with idle: touch-only devices stop the loop once the trail
        // has fully dissolved and the dot is hidden; desktop runs permanently
        let dotVisible = FINE; // tracks the dot's target opacity
        let rafOn = false;
        const tick = () => {
          ensureEls();
          const now = performance.now();
          // Retire fully dissolved samples so "empty" is detectable
          while (samples.length && now - samples[0].t > samples[0].life) samples.shift();
          dot!.style.transform = `translate(${mx - SIZE / 2}px, ${my - SIZE / 2}px)`;
          for (let i = 0; i < COUNT; i++) {
            const el = trail[i];
            const s = samples[samples.length - 1 - i];
            if (!s) {
              if (el.style.opacity !== '0') el.style.opacity = '0';
              continue;
            }
            el.style.transform = `translate(${s.x - SIZE / 2}px, ${s.y - SIZE / 2}px)`;
            const p = Math.min(1, (now - s.t) / s.life);
            el.style.opacity = (1 - p).toFixed(3);
          }
          if (TOUCH_ONLY && !dotVisible && !samples.length) {
            rafOn = false; // nothing left to animate — idle out
            return;
          }
          requestAnimationFrame(tick);
        };
        const wake = () => {
          if (!rafOn) {
            rafOn = true;
            requestAnimationFrame(tick);
          }
        };
        wake(); // desktop keeps it alive; touch-only idles out immediately

        if (FINE) {
          window.addEventListener(
            'mousemove',
            (e) => {
              moveTo(e.clientX, e.clientY);
              wake();
            },
            { passive: true }
          );
        }

        // Touch: the finger becomes the pointer. passive listeners —
        // scrolling stays untouched, the trail simply follows the finger
        const onTouch = (e: TouchEvent) => {
          const t = e.touches[0];
          if (!t) return;
          if (TOUCH_ONLY && !dotVisible) {
            dotVisible = true;
            dot!.style.opacity = '1';
          }
          moveTo(t.clientX, t.clientY);
          wake();
        };
        window.addEventListener('touchstart', onTouch, { passive: true });
        window.addEventListener('touchmove', onTouch, { passive: true });
        window.addEventListener(
          'touchend',
          () => {
            // Release: the dot fades out (CSS transition) and each trail particle
            // keeps dissolving on its remaining lifetime — in birth order
            if (TOUCH_ONLY && dotVisible) {
              dotVisible = false;
              dot!.style.opacity = '0';
            }
          },
          { passive: true }
        );

        // After a soft navigation the <html> attributes get overwritten and the
        // body replaced: re-hide the cursor, rebuild the pool, reset sampling
        document.addEventListener('astro:after-swap', () => {
          if (FINE) hideNativeCursor();
          layer = null;
          dot = null;
          trail = [];
          sx = -1;
          sy = -1;
          samples = [];
          ensureEls();
          if (TOUCH_ONLY) {
            dotVisible = false;
            dot!.style.opacity = '0';
          }
          wake();
        });
      }
    </script>
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <ThemeToggle />
  </body>
</html>
