---
import Layout from './Layout.astro';
import PostsSidebar from '../components/PostsSidebar.astro';

interface Props {
  title: string;
  description?: string;
  currentSlug?: string;
}

const { title, description, currentSlug } = Astro.props;
---

<Layout title={title} description={description}>
  <div class="posts-layout" data-open="false">
    <PostsSidebar currentSlug={currentSlug} />
    <div class="posts-content">
      <slot />
    </div>
  </div>
</Layout>

<style>
  /* 三列网格：[按钮列][侧栏列][内容列]
     按钮列宽度恒定（auto）→ 开合时按钮永不位移；
     侧栏列宽 --sb-w 由 data-open 驱动 0↔240px，撑开时把内容列往右挤（push） */
  .posts-layout {
    --sb-w: 0px;
    display: grid;
    grid-template-columns: auto var(--sb-w) minmax(0, 1fr);
    column-gap: 0;
    max-width: 1680px;
    margin: 0 auto;
    padding: 7rem 1.5rem 4rem;
    transition: grid-template-columns 0.34s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .posts-layout[data-open='true'] {
    --sb-w: 240px;
  }
  /* 按钮→侧栏、侧栏→内容 的间距用元素自身 margin，避开 grid gap 对按钮列的影响 */
  .posts-content {
    min-width: 0;
    padding-left: 2rem;
  }
  @media (max-width: 768px) {
    .posts-layout {
      grid-template-columns: 1fr;
      gap: 0;
      /* 顶部留出固定开关按钮（4.9rem + 2rem），避免压住首行内容 */
      padding: 7.1rem 1.1rem 4rem;
      transition: none;
    }
    .posts-content {
      padding-left: 0;
      width: 100%;
    }
  }
</style>
