---
import Layout from './Layout.astro';
import PostsSidebar from '../components/PostsSidebar.astro';

interface Props {
  title: string;
  description?: string;
  currentSlug?: string;
}

const { title, description, currentSlug } = Astro.props;
---

<Layout title={title} description={description}>
  <div class="posts-layout" data-open="false">
    <PostsSidebar currentSlug={currentSlug} />
    <div class="posts-content">
      <slot />
    </div>
  </div>
</Layout>

<style>
  /* 两列网格：[侧栏列][内容列]
     开关按钮 fixed 定位，不占 grid 空间 → 收起时内容可真正居中；
     侧栏列宽 --sb-w 由 data-open 驱动 0↔240px，撑开时把内容列往右挤（push） */
  .posts-layout {
    --sb-w: 0px;
    position: relative; /* 开关按钮 absolute 定位的参照 */
    display: grid;
    grid-template-columns: var(--sb-w) minmax(0, 1fr);
    column-gap: 0;
    max-width: 1680px;
    margin: 0 auto;
    padding: 6.5rem 1.5rem 4rem;
    transition: grid-template-columns 0.34s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .posts-layout[data-open='true'] {
    --sb-w: 240px;
  }
  .posts-content {
    min-width: 0;
    padding-left: 2.6rem; /* 让出左上角开关按钮，标题不被遮挡 */
  }
  @media (max-width: 768px) {
    .posts-layout {
      grid-template-columns: 1fr;
      gap: 0;
      /* 顶部留出固定开关按钮（4.05rem + 2.2rem），避免压住首行内容 */
      padding: 6.4rem 1.1rem 4rem;
      transition: none;
    }
    .posts-content {
      padding-left: 0;
      width: 100%;
    }
  }
</style>
