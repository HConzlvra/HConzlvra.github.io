---
import Layout from './Layout.astro';
import DocsSidebar from '../components/DocsSidebar.astro';

interface Props {
  title: string;
  description?: string;
  currentSlug?: string;
}

const { title, description, currentSlug } = Astro.props;
---

<Layout title={title} description={description}>
  <div class="docs-layout" data-open="false">
    <DocsSidebar currentSlug={currentSlug} />
    <div class="docs-content">
      <slot />
    </div>
  </div>
</Layout>

<style>
  .docs-layout {
    --sb-w: 0px;
    position: relative;
    display: grid;
    grid-template-columns: var(--sb-w) minmax(0, 1fr);
    column-gap: 0;
    max-width: 1680px;
    margin: 0 auto;
    padding: 6.5rem 1.5rem 4rem;
    transition: grid-template-columns 0.34s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .docs-layout[data-open='true'] {
    --sb-w: 240px;
  }
  .docs-content {
    min-width: 0;
    padding-left: 2.6rem; /* 让出左上角开关按钮，标题不被遮挡 */
  }
  @media (max-width: 768px) {
    .docs-layout {
      grid-template-columns: 1fr;
      gap: 0;
      /* 顶部留出固定开关按钮（4.05rem + 2.2rem），避免压住首行内容 */
      padding: 6.4rem 1.1rem 4rem;
      transition: none;
    }
    .docs-content {
      padding-left: 0;
      width: 100%;
    }
  }
</style>
