---
import { getCollection } from 'astro:content';

const docs = await getCollection('docs');
const byCategory = new Map<string, typeof docs>();
for (const d of docs) {
  const c = d.data.category;
  if (!byCategory.has(c)) byCategory.set(c, []);
  byCategory.get(c)!.push(d);
}
const categories = [...byCategory.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---

<aside class="docs-sidebar">
  <button class="sidebar-toggle" type="button" aria-expanded="false" aria-controls="docs-sidebar-panel">
    <span>Docs</span>
    <span class="sidebar-caret" aria-hidden="true">▾</span>
  </button>
  <div class="sidebar-panel" id="docs-sidebar-panel">
    <div class="sidebar-header">
      <span class="sidebar-title">Docs</span>
    </div>
    <nav class="sidebar-links">
      <a href="/docs" class="sidebar-link active">
        <span class="link-title">All</span>
        <span class="link-count">{docs.length} entries</span>
      </a>
      {categories.map(([name, list]) => (
        <a href={`/docs#${encodeURIComponent(name)}`} class="sidebar-link">
          <span class="link-title">{name}</span>
          <span class="link-count">{list.length}</span>
        </a>
      ))}
    </nav>
  </div>
</aside>

<style>
  .docs-sidebar {
    position: sticky;
    top: 90px;
    align-self: start;
  }
  .sidebar-panel {
    display: grid;
    gap: 0.75rem;
  }
  .sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--surface-border);
  }
  .sidebar-title {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .sidebar-caret {
    font-size: 0.8rem;
    color: var(--text-secondary);
    transition: transform 0.2s ease;
  }
  .sidebar-toggle {
    display: none;
  }
  .sidebar-links {
    display: grid;
    gap: 0.25rem;
  }
  .sidebar-link {
    position: relative;
    display: grid;
    gap: 0.15rem;
    padding: 0.6rem 0.75rem 0.7rem;
    border-radius: 8px;
    text-decoration: none;
    color: var(--text);
    transition: background 0.2s ease;
  }
  .sidebar-link::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.2rem;
    height: 2px;
    border-radius: 1px;
    background: var(--btn-primary-bg);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.3s ease;
  }
  .sidebar-link:hover {
    background: var(--surface);
  }
  .sidebar-link:hover::after,
  .sidebar-link.active::after {
    transform: scaleX(1);
  }
  .sidebar-link.active {
    background: var(--surface);
  }
  .link-title {
    font-weight: 600;
    font-size: 0.9rem;
    line-height: 1.4;
  }
  .link-count {
    font-size: 0.72rem;
    color: var(--text-secondary);
  }

  @media (max-width: 768px) {
    .docs-sidebar {
      position: fixed;
      top: 4.5rem;
      left: 0;
      z-index: 80;
      pointer-events: auto;
    }
    .sidebar-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.45rem;
      min-width: 5.4rem;
      padding: 0.55rem 0.8rem;
      border: 1px solid var(--surface-border);
      border-radius: 0 10px 10px 0;
      background: rgba(17, 17, 22, 0.96);
      color: var(--text);
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.22);
      cursor: pointer;
      font: inherit;
      font-size: 0.8rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      position: relative;
      z-index: 90;
      touch-action: manipulation;
    }
    .docs-sidebar.open .sidebar-toggle {
      transform: translateX(min(72vw, 18rem));
    }
    .sidebar-panel {
      position: fixed;
      top: 4.5rem;
      left: 0;
      width: min(72vw, 18rem);
      max-height: calc(100vh - 5.5rem);
      overflow-y: auto;
      padding: 1rem 0.8rem 0.9rem;
      background: rgba(17, 17, 22, 0.96);
      border-right: 1px solid var(--surface-border);
      border-radius: 0 16px 16px 0;
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.28);
      transform: translateX(-110%);
      opacity: 0;
      pointer-events: none;
      transition: transform 0.25s ease, opacity 0.2s ease;
      gap: 0.6rem;
      z-index: 85;
    }
    .docs-sidebar.open .sidebar-panel {
      transform: translateX(0);
      opacity: 1;
      pointer-events: auto;
    }
    .sidebar-header {
      padding-bottom: 0.45rem;
    }
    .sidebar-links {
      gap: 0.5rem;
    }
    .sidebar-link {
      min-width: 0;
      background: var(--surface);
      border: 1px solid var(--surface-border);
      border-radius: 10px;
      padding: 0.65rem 0.7rem 0.8rem;
    }
    .link-title {
      font-size: 0.8rem;
    }
    .link-count {
      font-size: 0.68rem;
    }
  }
</style>

<script>
  const docsSidebar = document.querySelector('.docs-sidebar');
  const docsToggle = docsSidebar?.querySelector('.sidebar-toggle');
  if (docsSidebar && docsToggle) {
    const close = () => {
      docsSidebar.classList.remove('open');
      docsToggle.setAttribute('aria-expanded', 'false');
    };
    docsToggle.addEventListener('click', () => {
      const isOpen = docsSidebar.classList.toggle('open');
      docsToggle.setAttribute('aria-expanded', String(isOpen));
    });
    docsSidebar.querySelectorAll('.sidebar-link').forEach((link) => {
      link.addEventListener('click', close);
    });
  }
</script>
