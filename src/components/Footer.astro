---
// 页脚：多栏布局（参考 andrewawa.pages.dev）
// - 品牌 / 站点导航 / 联系方式 三栏（手机端品牌独占一行，导航与联系两栏并排）
// - 链接悬浮下划线从左划入；外链带 ↗ 小箭头
// - 底部版权条：版权 + Powered by Astro
const year = new Date().getFullYear();

const siteLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/posts', label: 'Posts' },
  { href: '/guestbook', label: 'Guestbook' },
  { href: '/bruh', label: 'Bruh' },
];

const socialLinks = [
  { href: 'https://github.com/HConzlvra', label: 'GitHub' },
  { href: 'https://space.bilibili.com/3493291423172656', label: 'Bilibili' },
];

const friendLinks = [
  { href: 'https://bfladderbean.me', label: 'BFladderbean' },
  { href: 'https://molforte.github.io/Molforte.pages/', label: 'Molforte' },
  { href: 'https://arcadia.moe', label: '4rcadia' },
];

// 两组外链栏（Connect / Friends），共用同一渲染
const externalCols = [
  { title: 'Connect', aria: 'Connect', links: socialLinks },
  { title: 'Friends', aria: 'Friends', links: friendLinks },
];
---

<footer class="footer">
  <div class="footer-grid">
    <!-- 品牌：名字 + 简介（手机端独占一行） -->
    <div class="footer-brand">
      <a href="/" class="brand-name">HConzlvra_'s Site</a>
      <p class="brand-desc">There is a crack in everything; that's how the light gets in.</p>
    </div>

    <!-- 站点导航 -->
    <nav class="footer-col" aria-label="Site navigation">
      <h3>Site</h3>
      <ul>
        {
          siteLinks.map(({ href, label }) => (
            <li>
              <a href={href} class="footer-link">
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- 外链栏：Connect（社交）/ Friends（友链） -->
    {
      externalCols.map(({ title, aria, links }) => (
        <nav class="footer-col" aria-label={aria}>
          <h3>{title}</h3>
          <ul>
            {links.map(({ href, label }) => (
              <li>
                <a href={href} target="_blank" rel="noopener noreferrer" class="footer-link">
                  {label}
                  <svg
                    viewBox="0 0 24 24"
                    width="12"
                    height="12"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M7 7h10v10"></path>
                    <path d="M7 17 17 7"></path>
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <!-- 底部版权条 -->
  <div class="footer-bottom">
    <span>© {year} HConzlvra_</span>
    <span>Powered by Astro</span>
  </div>
</footer>

<style>
  .footer {
    margin-top: auto;
    background: var(--footer-bg);
    border-top: 1px solid var(--surface-border);
    padding: 3rem 1.5rem 1.75rem;
  }
  .footer-grid {
    max-width: 1000px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 2.5rem;
  }

  /* ---- 品牌栏 ---- */
  .brand-name {
    display: inline-block;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    margin-bottom: 0.9rem;
    transition: color 0.2s ease;
  }
  .brand-name:hover {
    color: var(--accent-text);
  }
  .brand-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* ---- 栏目标题与链接 ---- */
  .footer-col h3 {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 1rem;
  }
  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  /* 链接：悬浮文字提亮 + 下划线从左划入 */
  .footer-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--text-secondary);
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  /* 下划线与导航栏完全同源：同色 --nav-underline、同 2px 粗细、同左入动画 */
  .footer-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 2px;
    border-radius: 1px;
    background: var(--nav-underline);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.3s ease;
  }
  .footer-link:hover {
    color: var(--text);
  }
  .footer-link:hover::after {
    transform: scaleX(1);
  }
  /* 外链小箭头：默认偏淡，悬浮点亮 */
  .footer-link svg {
    opacity: 0.4;
    transition: opacity 0.2s ease;
  }
  .footer-link:hover svg {
    opacity: 1;
  }

  /* ---- 底部版权条 ---- */
  .footer-bottom {
    max-width: 1000px;
    margin: 2.5rem auto 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--surface-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  /* 手机端：品牌独占一行，导航与联系两栏并排（同 andrewawa 的折叠方式） */
  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
    .footer-brand {
      grid-column: span 2;
    }
    .footer-bottom {
      justify-content: center;
      text-align: center;
    }
  }
</style>
