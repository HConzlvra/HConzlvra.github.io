<button class="theme-toggle theme-toggle-float" aria-label="Toggle theme" title="Toggle theme">
  <!-- 纯色简洁太阳：深色模式下显示（点击切到浅色） -->
  <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2" fill="currentColor"></circle>
    <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <line x1="12" y1="2.2" x2="12" y2="4.6"></line>
      <line x1="12" y1="19.4" x2="12" y2="21.8"></line>
      <line x1="2.2" y1="12" x2="4.6" y2="12"></line>
      <line x1="19.4" y1="12" x2="21.8" y2="12"></line>
      <line x1="5.1" y1="5.1" x2="6.8" y2="6.8"></line>
      <line x1="17.2" y1="17.2" x2="18.9" y2="18.9"></line>
      <line x1="18.9" y1="5.1" x2="17.2" y2="6.8"></line>
      <line x1="6.8" y1="17.2" x2="5.1" y2="18.9"></line>
    </g>
  </svg>
  <!-- 纯色简洁月亮：浅色模式下显示（点击切到深色） -->
  <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" fill="currentColor"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    cursor: pointer;
  }
  /* 桌面端浮动按钮：右下角圆形 */
  .theme-toggle-float {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 100;
    width: 2.8rem;
    height: 2.8rem;
    border: 1px solid var(--surface-border);
    border-radius: 50%;
    background: var(--surface);
    backdrop-filter: blur(10px);
    color: var(--text);
    transition:
      transform 0.2s ease,
      background 0.2s ease;
  }
  .theme-toggle-float:hover {
    transform: translateY(-3px);
    background: var(--surface-hover);
  }
  /* 移动端隐藏浮动按钮，改由下拉菜单里的按钮承担 */
  @media (max-width: 768px) {
    .theme-toggle-float {
      display: none;
    }
  }
  /* 两个图标叠放在同一格子里，按主题显隐 */
  .theme-toggle svg {
    grid-area: 1 / 1;
  }
</style>

<!-- 图标显隐规则必须全局，因为 mobile-panel 里的主题切换按钮（Navbar.astro）
     也用 .icon-sun / .icon-moon，scoped 样式跨组件不生效 -->
<style is:global>
  html[data-theme='dark'] .icon-moon {
    display: none;
  }
  html[data-theme='light'] .icon-sun {
    display: none;
  }
</style>

<script>
  // 主题切换：Apple 式交叉淡化——点击时给 <html> 挂 .theme-anim
  // （global.css 里对所有元素的背景/文字/边框/阴影统一 0.45s 过渡，
  // 渐变面经 @property 注册的色标变量插值），约 0.5s 后摘掉。
  // 窗口内连点：清掉旧计时器重新计，动画从当前颜色续走不跳变
  let animTimer: number | undefined;
  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target.closest('.theme-toggle') : null;
    if (!target) return;
    const html = document.documentElement;
    const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';

    // 减少动态偏好：不做淡化，直接切
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      html.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      return;
    }

    // 类要先挂上再切属性，transition 才接得住这次计算值变化
    html.classList.add('theme-anim');
    html.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
    if (animTimer) window.clearTimeout(animTimer);
    animTimer = window.setTimeout(() => {
      html.classList.remove('theme-anim');
      animTimer = undefined;
    }, 500);
  });
</script>
