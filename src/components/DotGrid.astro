---
// 主页交互格点背景：canvas 绘制点阵
// - 立体海面：偏俯侧视角，消失点位于屏幕上方偏右（HORIZON_RATIO 处地平线、
//   VP_X_RATIO 处横向）。点阵向消失点汇聚——远端行距与点径同步缩小、透明度变淡，
//   近端（屏幕底部）点大而疏。海面从右上方远处向左下方近处铺展，
//   既有俯视的纵深，又有侧倾的立体感（不是完全侧面，保留俯视基调）。
// - 海浪：波峰为横线，从地平线涌向屏幕底部（向观察者推进），
//   波带扫过处点轻微变粗、间隙张开。形变连续无跳变。
// - 光标/手指靠近时点被"挤压"推开并变粗（与海浪叠加共存）
// 仅在主页使用；模块脚本常驻事件监听，astro:page-load 时重新绑定画布
---

<canvas id="dot-grid" class="dot-grid" aria-hidden="true"></canvas>

<style>
  .dot-grid {
    position: fixed;
    inset: 0;
    z-index: -1; /* 位于渐变背景之上、页面内容之下 */
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>

<script>
  // ---------- 状态 ----------
  let canvas: HTMLCanvasElement | null = null;
  let ctx: CanvasRenderingContext2D | null = null;
  interface Dot {
    bx: number; // 屏幕基准 x（已透视投影）
    by: number; // 屏幕基准 y（已透视投影）
    s: number;  // 透视缩放（近端=1，远端→0）
    dx: number; // 屏幕位移 x
    dy: number; // 屏幕位移 y
    r: number;  // 屏幕半径
  }
  let dots: Dot[] = [];
  let spacing = 28;
  let baseR = 1.4;
  let influence = 130;
  let dpr = 1;
  let dotColor = 'rgba(128, 128, 128, 0.3)';
  let running = false;
  let lastTime = 0; // 上一帧时间戳（rAF），用于计算 dt
  const mouse = { x: -1e4, y: -1e4, active: false };
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  // ---------- 透视海面 ----------
  // 偏俯侧视角：消失点在屏幕上方偏右（HORIZON_RATIO 处地平线、VP_X_RATIO 处横向）。
  // 越接近消失点（远）点越小越密越淡，越接近底部（近）点越大越疏越实。
  // screen_y(z) = horizon_y + depthSpan / (1 + z * PERSP_K)
  // screen_x(z) = vp_x + (world_x - vp_x) / (1 + z * PERSP_K)
  // x 方向按深度收敛到偏右的消失点，海面从右上方远处向左下方近处铺展，
  // 既保留俯视的纵深，又有侧倾的立体感（不是完全侧面）。
  const HORIZON_RATIO = 0.08;     // 地平线略离屏幕顶部：从俯视变略侧视，
  // 上方留出小段背景，地平线作为海天分界更明显
  const PERSP_K = 0.0030;         // 深度压缩系数（越大压缩越剧、消失点越近）
  const PERSP_HAZE = 0.35;        // 最远处大气透明度（越远越淡，强化大气透视）
  const PERSP_VP_X_RATIO = 0.65;  // 消失点横向偏右：海面侧倾，从右上远方延伸到左下近处
  let horizon_y = 0;              // 地平线屏幕 y
  let depthSpan = 0;              // 地平线到屏幕底部的屏幕跨度
  let vp_x = 0;                   // 消失点 x

  // ---------- 海浪 ----------
  // 波峰是一条横线（恒定屏幕 y），从地平线略下方涌向屏幕底部（向观察者推进）。
  // 波带在屏幕空间为均匀宽度，扫过的点变粗、间隙张开；离开后自然回弹。
  // 推开方向在波峰前后 ±WAVE_FLIP_PX 内平滑翻转，波峰压过单个点时位移连续。
  // 变粗与推开解耦：推开用宽带（间隙开合），变粗只用窄带 → 波峰核心粗、
  // 波峰之间细，保留点阵层次。
  interface Wave {
    sy: number; // 波峰屏幕 y 位置
  }
  const WAVE_SCREEN_SPEED = 175;  // 屏幕推进速度 px/s（向近处=向下）
  const WAVE_BAND_PX = 75;        // 半带宽（屏幕 px）：很宽的微波带
  const WAVE_FLIP_PX = 32;        // 推开方向翻转带（屏幕 px），避免跳变
  const WAVE_PUSH = 6;            // 波峰两侧最大位移（屏幕 px，轻微形变）
  const WAVE_GROW = 0.9;          // 波峰处增粗量（屏幕 px，刻意小：粗细只留暗示）
  const WAVE_GROW_BAND_PX = 26;  // 增粗半带宽（远窄于 WAVE_BAND）：波峰核心微微变粗
  const WAVE_INTERVAL = 1.15;    // 波间隔（秒）：波峰紧挨波峰持续滚动
  const WAVE_START_FRAC = 0.15;  // 出生位置：地平线下方 depthSpan 的此比例处淡入
  let waves: Wave[] = [];
  let waveTimer = 0.4; // 距下一波出生的倒计时：首波 0.4s 后涌来
  const advanceWaves = (dt: number) => {
    waveTimer -= dt;
    if (waveTimer <= 0) {
      waves.push({ sy: horizon_y + depthSpan * WAVE_START_FRAC }); // 从地平线附近淡入
      waveTimer += WAVE_INTERVAL;
    }
    const bottom = window.innerHeight;
    for (const w of waves) w.sy += WAVE_SCREEN_SPEED * dt;
    waves = waves.filter((w) => w.sy < bottom + WAVE_BAND_PX); // 完全驶出后回收
  };

  // ---------- 尺寸与点阵 ----------
  const resize = () => {
    if (!canvas || !ctx) return;
    const w = window.innerWidth;
    const h = window.innerHeight;
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    canvas.style.width = `${w}px`;
    canvas.style.height = `${h}px`;

    horizon_y = h * HORIZON_RATIO;
    depthSpan = h - horizon_y;
    vp_x = w * PERSP_VP_X_RATIO;

    // 移动端间距更小（点阵别太稀疏）；并按面积上限稀释，防止大屏/4K 点数爆炸
    const isMobile = w <= 768;
    const maxDots = isMobile ? 2800 : 4500;
    const minSpacing = isMobile ? 26 : 28;
    spacing = Math.max(minSpacing, Math.sqrt((w * h) / maxDots));
    baseR = isMobile ? 2.0 : 1.9;
    influence = Math.max(110, spacing * 4);

    dots = [];
    // 按世界深度 z 生成行：z=0 近端（屏幕底），z→∞ 远端（地平线）。
    // 近端每单位 z 的屏幕步长 = depthSpan * PERSP_K；令近端屏幕行距 = spacing 反推 dz。
    const nearRowStep = depthSpan * PERSP_K;
    const dz = nearRowStep > 0 ? spacing / nearRowStep : 1;
    // 固定世界半宽：消失点偏右后，左侧需要更宽的世界覆盖才能铺满屏幕，
    // 取消失点到屏幕两侧的较大距离 + 边距，确保近端行覆盖全屏宽度
    // （若按深度放大世界宽来铺满屏幕，则所有行都满宽，x 方向就不再收敛，立体感丢失）
    const worldHalfW = Math.max(vp_x, w - vp_x) + spacing * 2;
    const colStepWorld = spacing;
    const colsHalf = Math.ceil(worldHalfW / colStepWorld);
    for (let zi = 0; ; zi++) {
      const z = zi * dz;
      const factor = 1 + z * PERSP_K; // = depthSpan / (sy - horizon_y)
      const sy = horizon_y + depthSpan / factor;
      if (sy <= horizon_y + 0.5) break; // 太接近地平线
      // 当前行屏幕步长（关于 z 的导数）：spacing / factor²
      const rowStep = spacing / (factor * factor);
      if (rowStep < 1.8) break; // 行太密，停止（避免远端点重叠成实心带）
      const xScale = 1 / factor; // 该深度 x 缩放：远→0，近→1
      for (let ci = -colsHalf; ci <= colsHalf; ci++) {
        const wx = vp_x + ci * colStepWorld;
        const sx = vp_x + (wx - vp_x) * xScale;
        if (sx < -spacing || sx > w + spacing) continue;
        dots.push({ bx: sx, by: sy, s: xScale, dx: 0, dy: 0, r: baseR * xScale });
      }
    }
  };

  const readColor = () => {
    dotColor =
      getComputedStyle(document.documentElement).getPropertyValue('--dot-color').trim() || dotColor;
  };

  // ---------- 绘制与物理 ----------
  // 目标位移/半径 = 海浪起伏 + 光标挤压 的叠加，再缓动逼近（保留拖尾感）
  const draw = () => {
    if (!ctx || !canvas) return;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
    ctx.fillStyle = dotColor;

    const PUSH = 14; // 光标最大位移距离（轻微挤压）
    const GROW = 2.6; // 光标最大增粗量
    for (const d of dots) {
      let tx = 0;
      let ty = 0;
      let tr = baseR * d.s;
      // 海浪贡献：波峰两侧的点向两边轻轻推开（间隙张开）+ 波峰核心变粗。
      // 推开方向不用 sign(s) 硬翻转，而是在波峰前后 ±WAVE_FLIP_PX 内线性过渡，
      // 波峰压过单个格点时位移目标连续变化，不会瞬间跳变。
      // 形变量按 d.s 缩放：近处形变明显，远处几乎不动（透视一致）。
      for (const w of waves) {
        const s = w.sy - d.by; // >0 波已越过(在下方/近处)；<0 波未到(在上方/远处)
        const a = 1 - Math.abs(s) / WAVE_BAND_PX;
        if (a <= 0) continue; // 不在波带内
        const env = a * a * (3 - 2 * a); // smoothstep 包络：波峰最强、边缘平滑收敛
        const dir = Math.max(-1, Math.min(1, s / WAVE_FLIP_PX)); // 未到 -1 / 已过 +1
        // 间隙张开：波已过(下方)→点向上(-y)；波未到(上方)→点向下(+y)
        ty += -dir * env * WAVE_PUSH * d.s;
        const ar = 1 - Math.abs(s) / WAVE_GROW_BAND_PX;
        if (ar > 0) {
          const er = ar * ar * (3 - 2 * ar);
          tr += er * WAVE_GROW * d.s;
        }
      }
      if (mouse.active) {
        // 光标距离用渲染后坐标计算，确保视觉上准确定位
        const ex = d.bx + d.dx - mouse.x;
        const ey = d.by + d.dy - mouse.y;
        const dist = Math.hypot(ex, ey);
        if (dist < influence) {
          const f = 1 - dist / influence; // 0~1 影响强度
          tx += dist > 0.001 ? (ex / dist) * f * f * PUSH : 0;
          ty += dist > 0.001 ? (ey / dist) * f * f * PUSH : 0;
          tr += f * f * GROW * d.s;
        }
      }
      // 缓动逼近目标（松手/波过后自然回弹）
      // 系数越大跟踪越紧、滞后越小；0.3 左右保留一丝拖尾感又不显迟钝
      d.dx += (tx - d.dx) * 0.32;
      d.dy += (ty - d.dy) * 0.32;
      d.r += (tr - d.r) * 0.38;
      // 大气透视：远端（d.s 小）更淡，近端更实
      ctx.globalAlpha = PERSP_HAZE + (1 - PERSP_HAZE) * d.s;
      ctx.beginPath();
      ctx.arc(d.bx + d.dx, d.by + d.dy, Math.max(0.5, d.r), 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalAlpha = 1; // 复位，防止影响其他绘制
  };

  // 渲染循环：海浪持续发生 → 常驻 rAF（页面切走时 rAF 自动暂停，
  // 画布随视图销毁时停止）。dt 上限 0.05s，后台切回不会让波浪瞬移。
  const loop = (now: number) => {
    if (!canvas || !canvas.isConnected) {
      running = false;
      return;
    }
    if (reduced.matches) {
      waves.length = 0; // 减少动态：不出海浪
      draw();
      running = false;
      return;
    }
    const dt = lastTime ? Math.min((now - lastTime) / 1000, 0.05) : 0.016;
    lastTime = now;
    advanceWaves(dt);
    draw();
    requestAnimationFrame(loop);
  };

  const kick = () => {
    if (!canvas || !canvas.isConnected) return;
    if (reduced.matches) {
      draw(); // 减少动态：只静态绘制
      return;
    }
    if (!running) {
      running = true;
      lastTime = 0;
      requestAnimationFrame(loop);
    }
  };

  // ---------- 绑定（模块只执行一次，监听器常驻） ----------
  const init = () => {
    const el = document.getElementById('dot-grid');
    if (!(el instanceof HTMLCanvasElement)) return; // 非主页
    canvas = el;
    ctx = el.getContext('2d');
    readColor();
    resize();
    draw();
    // 每次（重新）进入主页重置海浪：0.4s 后第一波从地平线涌来
    waves = [];
    waveTimer = 0.4;
    kick();
  };

  // 触摸结束后浏览器会派发合成的 mousemove，会把 mouse.active 重新置 true，
  // 导致格点松手后卡在挤压态不回弹。用一个短窗口屏蔽这类合成事件。
  let suppressMouse = false;
  let suppressTimer: number | null = null;
  const armSuppress = () => {
    suppressMouse = true;
    if (suppressTimer) clearTimeout(suppressTimer);
    suppressTimer = window.setTimeout(() => {
      suppressMouse = false;
      suppressTimer = null;
    }, 400);
  };

  window.addEventListener('mousemove', (e) => {
    if (suppressMouse) return;
    mouse.x = e.clientX;
    mouse.y = e.clientY;
    mouse.active = true;
    kick();
  }, { passive: true });

  window.addEventListener('mouseout', (e) => {
    if (suppressMouse) return;
    if (!e.relatedTarget) {
      mouse.active = false;
      mouse.x = -1e4;
      mouse.y = -1e4;
      kick();
    }
  });

  // 移动端：手指触摸或滑动都触发挤压
  const onTouch = (e: TouchEvent) => {
    const t = e.touches[0];
    if (t) {
      mouse.x = t.clientX;
      mouse.y = t.clientY;
      mouse.active = true;
      kick();
    }
  };
  window.addEventListener('touchstart', onTouch, { passive: true });
  window.addEventListener('touchmove', onTouch, { passive: true });

  const endTouch = () => {
    mouse.active = false;
    mouse.x = -1e4;
    mouse.y = -1e4;
    armSuppress();
    kick();
  };
  window.addEventListener('touchend', endTouch, { passive: true });
  window.addEventListener('touchcancel', endTouch, { passive: true });

  window.addEventListener('resize', () => {
    if (canvas?.isConnected) {
      readColor();
      resize();
      kick();
    }
  });

  // 主题切换时重读颜色（观察 data-theme 属性变化）
  new MutationObserver(() => {
    if (canvas?.isConnected) {
      readColor();
      kick();
    }
  }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  // 软导航回到主页时画布是全新元素，需重新绑定
  document.addEventListener('astro:page-load', init);
  init();
</script>
