---
// 主页交互格点背景：canvas 绘制三角形点阵
// - 海浪（微波）：宽波带沿对角线从左上涌向右下，波峰紧挨波峰持续滚动；
//   波带扫过处格点轻微变粗、间隙轻轻张开。形变小且连续：
//   波峰压过单个格点时位移目标平滑过渡，不存在瞬间跳变
// - 光标/手指靠近时格点被"挤压"推开并变粗（与海浪效果叠加共存）
// 仅在主页使用；模块脚本常驻事件监听，astro:page-load 时重新绑定画布
---

<canvas id="dot-grid" class="dot-grid" aria-hidden="true"></canvas>

<style>
  .dot-grid {
    position: fixed;
    inset: 0;
    z-index: -1; /* 位于渐变背景之上、页面内容之下 */
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>

<script>
  // ---------- 状态 ----------
  let canvas: HTMLCanvasElement | null = null;
  let ctx: CanvasRenderingContext2D | null = null;
  interface Dot {
    bx: number; // 基准 x
    by: number; // 基准 y
    dx: number; // 当前位移 x
    dy: number; // 当前位移 y
    r: number; // 当前半径
  }
  let dots: Dot[] = [];
  let spacing = 28;
  let baseR = 1.4;
  let influence = 130;
  let dpr = 1;
  let dotColor = 'rgba(128, 128, 128, 0.3)';
  let running = false;
  let lastTime = 0; // 上一帧时间戳（rAF），用于计算 dt
  const mouse = { x: -1e4, y: -1e4, active: false };
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  // ---------- 海浪 ----------
  // 波峰是一条垂直于对角线的整排线段，从左上角外向右下推进。
  // 每个格点在"波峰在对角线方向上的投影"处受影响：
  // 波没到的点被向前推、已越过的点被向后拉 → 波峰处间隙张开；
  // 同时波峰处点半径增大（类似光标悬浮），离开波带后自然回弹。
  interface Wave {
    pos: number; // 波峰在对角线方向上的投影位置（px）
  }
  const SQRT1_2 = Math.SQRT1_2;
  const WAVE_SPEED = 200; // 推进速度 px/s（慢速轻柔，呼吸感）
  const WAVE_BAND = 560; // 半带宽：波峰两侧各这么宽渐变（很宽的微波带）
  const WAVE_PUSH = 7; // 波峰两侧最大位移（轻微形变即可）
  const WAVE_FLIP = 130; // 推开方向在波峰前后各这么宽内平滑翻转，避免跳变
  const WAVE_GROW = 0.7; // 波峰处增粗量（刻意小：弱化粗细对比，
  // 波浪主要靠间隙开合表达，粗细只留一点若有若无的暗示）
  const WAVE_GROW_BAND = 150; // 增粗半带宽（远窄于 WAVE_BAND）：只有波峰核心微微变粗，
  // 相邻波峰之间回到细点，保留点阵层次
  // 波峰间距 = 带宽：一波刚过去下一波紧跟而来，固定间隔不随机
  const WAVE_INTERVAL = WAVE_BAND / WAVE_SPEED;
  let waves: Wave[] = [];
  let waveTimer = 0.4; // 距下一波出生的倒计时：首波 0.4s 后涌来
  let vw = 0; // 当前画布 CSS 宽（resize 时记录，draw/波浪用）
  let vh = 0; // 当前画布 CSS 高
  const advanceWaves = (dt: number) => {
    waveTimer -= dt;
    if (waveTimer <= 0) {
      waves.push({ pos: -WAVE_BAND }); // 从画面左上角外淡入，避免突兀
      waveTimer += WAVE_INTERVAL;
    }
    const maxP = (vw + vh) * SQRT1_2; // 右下角投影
    for (const w of waves) w.pos += WAVE_SPEED * dt;
    waves = waves.filter((w) => w.pos < maxP + WAVE_BAND); // 完全驶出后回收
  };

  // ---------- 移动端：格点个体揭示 ----------
  // 手机端平时不显示点阵：只在随机位置"长出"一小片，存活几秒后自己消散；
  // 手指按下的地方也会浮现一片跟随手指的小范围点阵，边缘持续呼吸起伏。
  // 实现要点是逐点算透明度——被揭示的是格点个体，而不是画一个遮罩洞，
  // 所以无论范围怎么变，边界都是格点自身淡出，不会出现被"切开"的直边。
  // 海浪照常运行：被揭示出来的每一颗格点和桌面端一样随波推开、变粗。
  interface Blob {
    x: number;
    y: number;
    r: number; // 基准半径
    amp: number; // 边缘起伏幅度（按半径比例随机）
    f1x: number; // 低频起伏的空间频率（方向 1）
    f1y: number;
    f2x: number; // 高频起伏的空间频率（方向 2）
    f2y: number;
    s1: number; // 低频起伏的漂移速度
    s2: number; // 高频起伏的漂移速度
    breathAmp: number; // 整体半径呼吸幅度
    breathSpeed: number; // 呼吸速度
    feather: number; // 该团的羽化宽度
    vx: number; // 缓慢漂移速度
    vy: number;
    p1: number; // 相位 A
    p2: number; // 相位 B
    t: number; // 已存活时间（秒）
    life: number; // 总寿命
    fin: number; // 淡入时长
    fout: number; // 淡出时长
  }
  let blobs: Blob[] = [];
  let blobTimer = 1.6; // 距下一团出现的倒计时（秒）
  let revealClock = 0; // 揭示动画的公共时钟（秒）
  let mobile = false; // 当前是否移动端布局（宽度 ≤ 768）

  const rand = (a: number, b: number) => a + Math.random() * (b - a);
  const smoothStep01 = (u: number) => u * u * (3 - 2 * u);
  // 边缘羽化宽度：越大越柔，是"不割裂"的关键（逐点渐变而非硬边）
  const FEATHER = 46;

  // 手指导出的揭示团：位置缓动跟随手指，松手后整团淡出
  const touchR = { active: false, x: 0, y: 0, tx: 0, ty: 0, a: 0 };

  const spawnBlob = (): Blob => {
    const life = rand(3.2, 6.2);
    const r = rand(78, 195);
    // 每个团的起伏方向、频率、呼吸节奏、漂移速度都独立随机，
    // 否则所有团共用同一套参数，看起来就像同一个模板在复制 → "伪随机"
    const dir = rand(0, Math.PI * 2);
    const f1 = rand(0.018, 0.042);
    const f2 = rand(0.03, 0.06);
    // 位置：随机取点，若与现有团太近就重挑 → 不会老在同一个地方反复冒
    let x = 0;
    let y = 0;
    for (let i = 0; i < 5; i += 1) {
      x = rand(vw * 0.12, vw * 0.88);
      y = rand(vh * 0.14, vh * 0.86);
      if (blobs.every((o) => Math.hypot(o.x - x, o.y - y) > (o.r + r) * 0.9)) break;
    }
    return {
      x,
      y,
      r,
      amp: r * rand(0.13, 0.3), // 按半径比例随机：有的圆润、有的碎
      f1x: Math.cos(dir) * f1,
      f1y: Math.sin(dir) * f1,
      f2x: Math.cos(dir + 1.7) * f2,
      f2y: Math.sin(dir + 1.7) * f2,
      s1: rand(0.45, 1.05),
      s2: rand(0.5, 1.25),
      breathAmp: rand(0.05, 0.12),
      breathSpeed: rand(0.55, 1.35),
      feather: rand(36, 66),
      vx: rand(-7, 7),
      vy: rand(-7, 7),
      p1: rand(0, Math.PI * 2),
      p2: rand(0, Math.PI * 2),
      t: 0,
      life,
      fin: rand(0.7, 1.1),
      fout: rand(0.9, 1.5),
    };
  };

  // 团块显隐包络：淡入 → 停留 → 淡出，两端都是平滑的
  const blobEnv = (b: Blob) => {
    let e = 1;
    if (b.t < b.fin) e = b.t / b.fin;
    else if (b.t > b.life - b.fout) e = (b.life - b.t) / b.fout;
    return smoothStep01(Math.max(0, Math.min(1, e)));
  };

  const advanceBlobs = (dt: number) => {
    // 随机位置、随机间隔出现；最多同时两团，避免满屏都是点
    blobTimer -= dt;
    if (blobTimer <= 0) {
      if (blobs.length < 2) blobs.push(spawnBlob());
      // 间隔本身也不规则：偶尔紧接着再来一小团，多数时候隔好几秒
      blobTimer = Math.random() < 0.25 ? rand(1.2, 2.6) : rand(3.2, 7.5);
    }
    for (const b of blobs) {
      b.t += dt;
      // 缓慢漂移：团的位置一直在游走，而不是钉死在一个点上"原地呼吸"
      b.x += b.vx * dt;
      b.y += b.vy * dt;
      if (b.x < vw * 0.06 || b.x > vw * 0.94) b.vx *= -1;
      if (b.y < vh * 0.08 || b.y > vh * 0.92) b.vy *= -1;
    }
    blobs = blobs.filter((b) => b.t < b.life);

    // 手指位置缓动跟随（拖动时不硬跳）
    const k = touchR.active ? 0.28 : 0.1;
    touchR.x += (touchR.tx - touchR.x) * k;
    touchR.y += (touchR.ty - touchR.y) * k;
    touchR.a += ((touchR.active ? 1 : 0) - touchR.a) * 0.16;
  };

  // 单个揭示团对某点的透明度：半径慢呼吸 + 边缘随位置/时间漂移的起伏，
  // 再按距离做羽化 → 轮廓不规则、一直在变，且没有硬边
  const blobAlphaAt = (x: number, y: number, b: Blob, time: number) => {
    const env = blobEnv(b);
    if (env < 0.02) return 0;
    const dx = x - b.x;
    const dy = y - b.y;
    const d2 = dx * dx + dy * dy;
    const R = b.r * (1 + b.breathAmp * Math.sin(time * b.breathSpeed + b.p1));
    const reach = R + b.amp + b.feather * 0.5;
    if (d2 > reach * reach) return 0; // 远处直接跳过，省掉 sqrt 与 sin
    const dist = Math.sqrt(d2);
    // 两组不同方向、不同频率的起伏叠加：轮廓不圆、不规则，并且各自漂移
    const wob =
      b.amp *
      (Math.sin(dx * b.f1x + dy * b.f1y + b.p1 + time * b.s1) * 0.7 +
        Math.sin(dx * b.f2x + dy * b.f2y - b.p2 + time * b.s2) * 0.35);
    const u = Math.max(0, Math.min(1, 0.5 + (R + wob - dist) / b.feather));
    return env * smoothStep01(u);
  };

  const drawReveal = () => {
    if (!ctx) return;
    const time = revealClock;
    const tR = 102 * (1 + 0.09 * Math.sin(time * 1.25)); // 手指团半径呼吸
    const tAmp = 15;

    for (const d of dots) {
      let a = 0;
      for (const b of blobs) a = Math.max(a, blobAlphaAt(d.bx, d.by, b, time));

      if (touchR.a > 0.02) {
        const dx = d.bx - touchR.x;
        const dy = d.by - touchR.y;
        const d2 = dx * dx + dy * dy;
        const reach = tR + tAmp + FEATHER * 0.5;
        if (d2 < reach * reach) {
          const dist = Math.sqrt(d2);
          const wob = tAmp * Math.sin(dx * 0.035 + dy * 0.028 + time * 0.85);
          const u = Math.max(0, Math.min(1, 0.5 + (tR + wob - dist) / FEATHER));
          a = Math.max(a, touchR.a * smoothStep01(u));
        }
      }

      if (a < 0.04) {
        // 不可见时不参与物理：归位，下次显现从零位移开始（避免残留位移造成跳变）
        d.dx = 0;
        d.dy = 0;
        d.r = baseR;
        continue;
      }

      // 海浪：与桌面端完全同一套公式（波峰两侧推开、波峰核心变粗），逐点缓动跟随，
      // 所以揭示出来的格点一样在随波起伏，而不是钉死的静态点
      let tx = 0;
      let ty = 0;
      let tr = baseR;
      for (const w of waves) {
        const s = w.pos - (d.bx + d.by) * SQRT1_2;
        const band = 1 - Math.abs(s) / WAVE_BAND;
        if (band <= 0) continue;
        const env = band * band * (3 - 2 * band);
        const dir = Math.max(-1, Math.min(1, -s / WAVE_FLIP));
        const push = dir * env * WAVE_PUSH * SQRT1_2;
        tx += push;
        ty += push;
        const ar = 1 - Math.abs(s) / WAVE_GROW_BAND;
        if (ar > 0) {
          const er = ar * ar * (3 - 2 * ar);
          tr += er * WAVE_GROW;
        }
      }

      // 触摸受力：与桌面端光标完全同一套公式（朝外推开 + 增粗，按距离平方衰减），
      // 力度乘以 touchR.a → 松手时随揭示团一起平滑消退，格点自己回弹
      if (touchR.a > 0.02) {
        const ex = d.bx + d.dx - touchR.x;
        const ey = d.by + d.dy - touchR.y;
        const dist = Math.hypot(ex, ey);
        if (dist < influence) {
          const strength = (1 - dist / influence) * touchR.a;
          const force = strength * strength;
          tx += dist > 0.001 ? (ex / dist) * force * 14 : 0;
          ty += dist > 0.001 ? (ey / dist) * force * 14 : 0;
          tr += force * 2.6;
        }
      }

      d.dx += (tx - d.dx) * 0.32;
      d.dy += (ty - d.dy) * 0.32;
      d.r += (tr - d.r) * 0.38;

      ctx.globalAlpha = a;
      ctx.beginPath();
      ctx.arc(d.bx + d.dx, d.by + d.dy, d.r, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalAlpha = 1;
  };

  // ---------- 尺寸与点阵 ----------
  // 画布尺寸完全交给 CSS（.dot-grid 的 inset:0 + 100% 永远满视口，地址栏
  // 伸缩也实时跟随）。这里只读取实际渲染尺寸同步像素缓冲与点阵——
  // 不用 JS 钉死 style 宽高：innerHeight 在地址栏收起时偏小，且 iOS Safari
  // 收起地址栏不触发 resize，钉死会让画布底部露出一段无格点的空隙
  const resize = () => {
    if (!canvas || !ctx) return;
    const w = canvas.clientWidth;
    const h = canvas.clientHeight;
    if (!w || !h) return;
    vw = w;
    vh = h;
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = Math.round(w * dpr);
    canvas.height = Math.round(h * dpr);

    // 端点切换（缩放窗口跨过断点）：重置波浪/揭示团，避免带着旧的动画状态
    const nextMobile = w <= 768;
    if (nextMobile !== mobile) {
      mobile = nextMobile;
      waves = [];
      waveTimer = 0.4;
      blobs = [];
      blobTimer = rand(1.2, 3.2);
      touchR.active = false;
      touchR.a = 0;
    }

    // 移动端间距更小（点阵别太稀疏）；并按面积上限稀释，防止大屏/4K 点数爆炸
    // （三角形格单点占面积 = 间距 × 行高 × sin60°，分母乘 sin60° 补偿行高压缩带来的密度上升）
    const isMobile = w <= 768;
    const maxDots = isMobile ? 2800 : 4500;
    const minSpacing = isMobile ? 26 : 28;
    const SIN60 = Math.sin(Math.PI / 3);
    spacing = Math.max(minSpacing, Math.sqrt((w * h) / (maxDots * SIN60)));
    baseR = isMobile ? 1.5 : 1.35;
    influence = Math.max(110, spacing * 4);

    // 三角形点阵：行高 = 间距 × sin60°（等边三角），奇数行横向错开半个间距
    dots = [];
    const rowH = spacing * SIN60;
    let row = 0;
    for (let y = spacing / 2; y < h; y += rowH, row++) {
      const x0 = spacing / 2 + (row % 2) * (spacing / 2);
      for (let x = x0; x < w; x += spacing) {
        dots.push({ bx: x, by: y, dx: 0, dy: 0, r: baseR });
      }
    }
  };

  const readColor = () => {
    dotColor =
      getComputedStyle(document.documentElement).getPropertyValue('--dot-color').trim() || dotColor;
  };

  // ---------- 绘制与物理 ----------
  // 目标位移/半径 = 海浪起伏 + 光标挤压 的叠加，再缓动逼近（保留拖尾感）
  const draw = () => {
    if (!ctx || !canvas) return;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, vw, vh);
    ctx.fillStyle = dotColor;

    // 移动端：整片点阵默认隐藏，只画被揭示的格点个体
    if (mobile) {
      drawReveal();
      return;
    }

    const PUSH = 14; // 光标最大位移距离（轻微挤压）
    const GROW = 2.6; // 光标最大增粗量
    for (const d of dots) {
      let tx = 0;
      let ty = 0;
      let tr = baseR;
      // 海浪贡献：波峰两侧的点向两边轻轻推开（间隙张开）+ 波峰核心变粗。
      // 推开方向不用 sign(s) 硬翻转，而是在波峰前后 ±WAVE_FLIP 内线性过渡，
      // 波峰压过单个格点时位移目标连续变化，不会出现瞬间跳变。
      // 变粗与推开解耦：推开用宽带（间隙轻柔开合，相邻波之间相互抵消），
      // 变粗只用窄带 → 波峰核心粗、波峰之间细，保留点阵层次。
      for (const w of waves) {
        const s = w.pos - (d.bx + d.by) * SQRT1_2; // <0 波未到；>0 波已越过
        const a = 1 - Math.abs(s) / WAVE_BAND;
        if (a <= 0) continue; // 不在波带内
        const env = a * a * (3 - 2 * a); // smoothstep 包络：波峰最强、边缘平滑收敛
        const dir = Math.max(-1, Math.min(1, -s / WAVE_FLIP)); // 未到 +1 / 已过 -1
        const push = dir * env * WAVE_PUSH * SQRT1_2;
        tx += push;
        ty += push;
        const ar = 1 - Math.abs(s) / WAVE_GROW_BAND;
        if (ar > 0) {
          const er = ar * ar * (3 - 2 * ar);
          tr += er * WAVE_GROW;
        }
      }
      if (mouse.active) {
        const ex = d.bx + d.dx - mouse.x;
        const ey = d.by + d.dy - mouse.y;
        const dist = Math.hypot(ex, ey);
        if (dist < influence) {
          const f = 1 - dist / influence; // 0~1 影响强度
          tx += dist > 0.001 ? (ex / dist) * f * f * PUSH : 0;
          ty += dist > 0.001 ? (ey / dist) * f * f * PUSH : 0;
          tr += f * f * GROW;
        }
      }
      // 缓动逼近目标（松手/波过后自然回弹）
      // 系数越大跟踪越紧、滞后越小；0.3 左右保留一丝拖尾感又不显迟钝
      d.dx += (tx - d.dx) * 0.32;
      d.dy += (ty - d.dy) * 0.32;
      d.r += (tr - d.r) * 0.38;
      ctx.beginPath();
      ctx.arc(d.bx + d.dx, d.by + d.dy, d.r, 0, Math.PI * 2);
      ctx.fill();
    }
  };

  // 渲染循环：海浪持续发生 → 常驻 rAF（页面切走时 rAF 自动暂停，
  // 画布随视图销毁时停止）。dt 上限 0.05s，后台切回不会让波浪瞬移。
  const loop = (now: number) => {
    if (!canvas || !canvas.isConnected) {
      running = false;
      return;
    }
    // 地址栏伸缩（iOS Safari 不触发 resize）等场景：每帧对比实际渲染
    // 尺寸与像素缓冲，不一致就重同步——画布永远满屏，底部不露空隙
    if (canvas.clientWidth * dpr !== canvas.width || canvas.clientHeight * dpr !== canvas.height) {
      resize();
    }
    if (reduced.matches) {
      waves.length = 0; // 减少动态：不出海浪
      draw();
      running = false;
      return;
    }
    const dt = lastTime ? Math.min((now - lastTime) / 1000, 0.05) : 0.016;
    lastTime = now;
    if (mobile) {
      revealClock += dt; // 揭示团的呼吸/起伏靠它推进
      advanceBlobs(dt);
    }
    // 海浪两端都常驻：手机端被揭示的格点同样随波推开、变粗
    advanceWaves(dt);
    draw();
    requestAnimationFrame(loop);
  };

  const kick = () => {
    if (!canvas || !canvas.isConnected) return;
    if (reduced.matches) {
      draw(); // 减少动态：只静态绘制
      return;
    }
    if (!running) {
      running = true;
      lastTime = 0;
      requestAnimationFrame(loop);
    }
  };

  // ---------- 绑定（模块只执行一次，监听器常驻） ----------
  const init = () => {
    const el = document.getElementById('dot-grid');
    if (!(el instanceof HTMLCanvasElement)) return; // 非主页
    canvas = el;
    ctx = el.getContext('2d');
    readColor();
    resize();
    draw();
    // 每次（重新）进入主页重置海浪：0.4s 后第一波从左上角涌来
    waves = [];
    waveTimer = 0.4;
    // 移动端揭示团也重新开始：先等一小会儿，再随机冒第一团
    blobs = [];
    blobTimer = rand(1.2, 3.2);
    revealClock = 0;
    touchR.active = false;
    touchR.a = 0;
    kick();
  };

  // 触摸结束后浏览器会派发合成的 mousemove，会把 mouse.active 重新置 true，
  // 导致格点松手后卡在挤压态不回弹。用一个短窗口屏蔽这类合成事件。
  let suppressMouse = false;
  let suppressTimer: number | null = null;
  const armSuppress = () => {
    suppressMouse = true;
    if (suppressTimer) clearTimeout(suppressTimer);
    suppressTimer = window.setTimeout(() => {
      suppressMouse = false;
      suppressTimer = null;
    }, 400);
  };

  window.addEventListener('mousemove', (e) => {
    if (suppressMouse) return;
    mouse.x = e.clientX;
    mouse.y = e.clientY;
    mouse.active = true;
    kick();
  }, { passive: true });

  window.addEventListener('mouseout', (e) => {
    if (suppressMouse) return;
    if (!e.relatedTarget) {
      mouse.active = false;
      mouse.x = -1e4;
      mouse.y = -1e4;
      kick();
    }
  });

  // 移动端：手指触摸或滑动都触发挤压（桌面端走挤压；手机端改为局部揭示）
  const onTouch = (e: TouchEvent) => {
    const t = e.touches[0];
    if (!t) return;
    if (mobile) {
      // 首次落指直接定位（不要让揭示团从上一处滑过来），之后的移动缓动跟随
      if (!touchR.active) {
        touchR.x = t.clientX;
        touchR.y = t.clientY;
      }
      touchR.tx = t.clientX;
      touchR.ty = t.clientY;
      touchR.active = true;
    } else {
      mouse.x = t.clientX;
      mouse.y = t.clientY;
      mouse.active = true;
    }
    kick();
  };
  window.addEventListener('touchstart', onTouch, { passive: true });
  window.addEventListener('touchmove', onTouch, { passive: true });

  const endTouch = () => {
    if (mobile) {
      touchR.active = false; // 揭示团自己淡出，不移除
    } else {
      mouse.active = false;
      mouse.x = -1e4;
      mouse.y = -1e4;
    }
    armSuppress();
    kick();
  };
  window.addEventListener('touchend', endTouch, { passive: true });
  window.addEventListener('touchcancel', endTouch, { passive: true });

  window.addEventListener('resize', () => {
    if (canvas?.isConnected) {
      readColor();
      resize();
      kick();
    }
  });

  // 主题切换时：--dot-color 已注册为 <color>（global.css @property），
  // CSS 过渡期间它的计算值逐帧插值——起一个短 rAF 窗口每帧重读，
  // 点阵颜色就与页面其余部分同步渐变（Apple 式交叉淡化）
  let colorFollowId = 0;
  const followColor = (until: number) => {
    if (colorFollowId) cancelAnimationFrame(colorFollowId);
    const step = () => {
      readColor();
      if (performance.now() < until) colorFollowId = requestAnimationFrame(step);
      else colorFollowId = 0;
    };
    colorFollowId = requestAnimationFrame(step);
  };
  new MutationObserver(() => {
    if (canvas?.isConnected) {
      readColor();
      kick();
      followColor(performance.now() + 550);
    }
  }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  // 软导航回到主页时画布是全新元素，需重新绑定
  document.addEventListener('astro:page-load', init);
  init();
</script>
