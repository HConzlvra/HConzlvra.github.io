---
// 顶部导航栏：全局唯一实例（由 Layout.astro 引入，所有页面共享）
// 悬浮液态玻璃条，页面滚动时收窄为居中圆角胶囊
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';

const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/characters', label: 'Characters' },
  { href: '/posts', label: 'Posts' },
];

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(href + '/');
---

<header class="nav-wrap" id="nav-wrap">
  <nav class="navbar" aria-label="主导航">
    <a href="/" class="logo">HC</a>
    <div class="links">
      {
        links.map(({ href, label }) => (
          <a href={href} class={isActive(href) ? 'active' : ''} aria-current={isActive(href) ? 'page' : undefined}>
            {label}
          </a>
        ))
      }
    </div>
    <form class="search-form" action="/search" method="get" role="search">
      <svg
        class="search-icon"
        viewBox="0 0 24 24"
        width="15"
        height="15"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="search"
        name="q"
        class="search-input"
        placeholder="Search…"
        aria-label="搜索全站"
        autocomplete="off"
      />
    </form>
  </nav>
</header>

<script>
  // 滚动时收窄导航栏；每次实时查询 DOM，兼容 ClientRouter 视图切换
  const onScroll = () => {
    document.getElementById('nav-wrap')?.classList.toggle('compact', window.scrollY > 24);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  document.addEventListener('astro:page-load', onScroll);
  onScroll();
</script>

<style>
  /* 外层容器：悬浮导航，四周留边距 */
  .nav-wrap {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 0.75rem 1rem;
    display: flex;
    justify-content: center;
    pointer-events: none; /* 让周围空白可点击 */
    transition: padding 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .navbar {
    pointer-events: auto;
    position: relative;
    width: 100%;
    max-width: 1080px;
    height: 56px;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0 1.25rem;
    border-radius: 18px;
    /* 液态玻璃：半透明底 + 渐变描边（模拟玻璃受光边缘） */
    border: 1px solid transparent;
    background:
      linear-gradient(var(--nav-tint), var(--nav-tint)) padding-box,
      linear-gradient(
        120deg,
        rgba(255, 255, 255, 0.65),
        rgba(255, 255, 255, 0.15) 26%,
        rgba(255, 255, 255, 0.04) 55%,
        rgba(255, 255, 255, 0.4)
      )
        border-box;
    backdrop-filter: blur(22px) saturate(1.8);
    -webkit-backdrop-filter: blur(22px) saturate(1.8);
    /* 内侧高光 = 玻璃上沿反光；外阴影 = 玻璃浮起 */
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.35),
      inset 0 -1px 0 rgba(255, 255, 255, 0.06),
      0 4px 24px rgba(0, 0, 0, 0.08);
    transition: all 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  /* 斜向流光层，模拟玻璃表面反光 */
  .navbar::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      115deg,
      rgba(255, 255, 255, 0.18) 0%,
      rgba(255, 255, 255, 0) 30%,
      rgba(255, 255, 255, 0) 70%,
      rgba(255, 255, 255, 0.1) 100%
    );
    pointer-events: none;
  }
  /* 滚动后：收窄成居中的圆角胶囊条 */
  .nav-wrap.compact {
    padding: 0.5rem 1rem;
  }
  .nav-wrap.compact .navbar {
    max-width: 640px;
    height: 46px;
    gap: 1rem;
    padding: 0 1.1rem;
    border-radius: 999px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.35),
      inset 0 -1px 0 rgba(255, 255, 255, 0.06),
      0 8px 32px rgba(0, 0, 0, 0.18);
  }

  .logo {
    font-size: 1.35rem;
    font-weight: 700;
    background: var(--heading-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-decoration: none;
    flex-shrink: 0;
  }
  .nav-wrap.compact .logo {
    font-size: 1.15rem;
  }

  .links {
    display: flex;
    gap: 1.4rem;
    flex: 1;
  }
  .nav-wrap.compact .links {
    gap: 1rem;
  }
  .links a {
    position: relative;
    color: var(--accent-text);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    padding-bottom: 4px;
    white-space: nowrap;
    transition: color 0.2s ease;
  }
  /* 底部横杠：悬浮时从左到右扫过 */
  .links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    border-radius: 1px;
    background: var(--btn-primary-bg);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.3s ease;
  }
  .links a:hover,
  .links a.active {
    color: var(--text);
  }
  .links a:hover::after,
  .links a.active::after {
    transform: scaleX(1);
  }

  /* 搜索框 */
  .search-form {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--nav-border);
    background: var(--surface);
    flex-shrink: 0;
    transition: border-color 0.2s ease;
  }
  .search-form:focus-within {
    border-color: var(--btn-primary-bg);
  }
  .search-icon {
    color: var(--text-secondary);
    flex-shrink: 0;
  }
  .search-input {
    border: none;
    outline: none;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 0.88rem;
    width: 7.5rem;
    transition: width 0.3s ease;
  }
  .search-input::placeholder {
    color: var(--text-secondary);
  }
  .search-input:focus {
    width: 10rem;
  }
  .nav-wrap.compact .search-input {
    width: 5.5rem;
  }
  .nav-wrap.compact .search-input:focus {
    width: 8rem;
  }

  /* 移动端 */
  @media (max-width: 640px) {
    .links {
      gap: 0.9rem;
    }
    .links a {
      font-size: 0.85rem;
    }
    .search-input {
      width: 4.5rem;
    }
    .search-input:focus {
      width: 6rem;
    }
    .nav-wrap.compact .search-input,
    .nav-wrap.compact .search-input:focus {
      width: 4.5rem;
    }
  }
</style>
