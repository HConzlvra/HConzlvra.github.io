---
// 顶部导航栏：全局唯一实例（由 Layout.astro 引入，所有页面共享）
// 桌面端：整条不透明实心导航栏（无玻璃、无滚动变形）
// 移动端：andrewawa.pages.dev 同款液态玻璃条（SVG 位移折射）+ 汉堡下拉菜单
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';

const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/posts', label: 'Posts' },
  { href: '/docs', label: 'Docs' },
  { href: '/archive', label: 'Archive' },
  { href: '/guestbook', label: 'Guestbook' },
  { href: '/bruh', label: 'Bruh' },
  // Characters 页面保留可访问（/characters 直接访问），但不进导航栏
];

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(href + '/');
---

<header class="nav-wrap" id="nav-wrap">
  <!-- 液态玻璃滤镜定义（配方取自 andrewawa.pages.dev）：
       feTurbulence 分形噪声 → 高斯模糊 → feDisplacementMap 按 noise 位移背景，
       backdrop-filter 引用后玻璃后方内容产生"流动折射"的变形。
       不支持 url() 滤镜的浏览器走上面的 blur/saturate 兜底行 -->
  <svg width="0" height="0" style="position: absolute" aria-hidden="true" focusable="false">
    <filter id="hc-liquid-nav" color-interpolation-filters="sRGB" x="0%" y="0%" width="100%" height="100%">
      <feTurbulence type="fractalNoise" baseFrequency="0.02" numOctaves="3" seed="15" result="noise"></feTurbulence>
      <feGaussianBlur in="noise" stdDeviation="1.5" result="blurred"></feGaussianBlur>
      <feDisplacementMap in="SourceGraphic" in2="blurred" scale="-25" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
    </filter>
    <filter id="hc-liquid-panel" color-interpolation-filters="sRGB" x="-10%" y="-10%" width="120%" height="120%">
      <feTurbulence type="fractalNoise" baseFrequency="0.015" numOctaves="3" seed="42" result="noise"></feTurbulence>
      <feGaussianBlur in="noise" stdDeviation="2" result="blurred"></feGaussianBlur>
      <feDisplacementMap in="SourceGraphic" in2="blurred" scale="-30" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
    </filter>
  </svg>

  <div class="nav-inner">
    <nav class="navbar" aria-label="主导航">
      <a href="/" class="logo">𝓗𝓒</a>

      <!-- 桌面端横向链接 -->
      <div class="links">
        {
          links.map(({ href, label }) => (
            <a href={href} class={isActive(href) ? 'active' : ''} aria-current={isActive(href) ? 'page' : undefined}>
              {label}
            </a>
          ))
        }
      </div>

      <!-- 搜索：默认收成圆形图标按钮，点一下展开输入框，Enter 提交（桌面端悬浮也会展开） -->
      <form class="search-form" action="/search" method="get" role="search">
        <button type="button" class="search-btn" aria-label="Open search">
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>
        <input
          type="search"
          name="q"
          class="search-input"
          placeholder="Search…"
          aria-label="Search site"
          autocomplete="off"
        />
      </form>

      <!-- 移动端汉堡按钮：SVG 线条（span 细横线旋转后端点在移动端会被光栅化成多余的点） -->
      <button id="menu-toggle" class="hamburger" aria-label="打开菜单" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <line x1="4" y1="6" x2="20" y2="6" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="18" x2="20" y2="18" />
        </svg>
      </button>
    </nav>

    <!-- 移动端下拉菜单（竖向排列）：与导航栏平级而不是嵌在里面，
         否则导航栏带滤镜时嵌套 backdrop-filter 采不到页面内容，玻璃效果会"变两种" -->
    <div class="mobile-panel">
      {
        links.map(({ href, label }) => (
          <a href={href} class={isActive(href) ? 'active' : ''} aria-current={isActive(href) ? 'page' : undefined}>
            {label}
          </a>
        ))
      }
      {/* 移动端底部工具行：左侧 GitHub 外链，右侧主题切换滑钮 */}
      <div class="mobile-tools">
        <a
          class="mobile-github"
          href="https://github.com/HConzlvra/HConzlvra.github.io"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.48 2 2 6.58 2 12.26c0 4.5 2.87 8.31 6.84 9.67.5.1.68-.22.68-.49v-1.7c-2.78.62-3.37-1.22-3.37-1.22-.46-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.36-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.74-.1-.26-.45-1.3.1-2.71 0 0 .84-.27 2.75 1.05A9.4 9.4 0 0 1 12 7.08c.85 0 1.7.12 2.5.34 1.91-1.32 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.71 1.03 1.62 1.03 2.74 0 3.93-2.34 4.79-4.57 5.05.36.32.68.94.68 1.9v2.82c0 .27.18.6.69.49A10.26 10.26 0 0 0 22 12.26C22 6.58 17.52 2 12 2Z"></path>
          </svg>
          <span>GitHub</span>
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17 17 7"></path>
            <path d="M8 7h9v9"></path>
          </svg>
        </a>
        {/* 主题切换滑钮：复用 .theme-toggle 类触发 ThemeToggle 的脚本，轨道黑白切换 */}
        <button class="theme-toggle theme-switch" aria-label="Toggle theme" type="button" role="switch">
          <span class="switch-track">
            <span class="switch-thumb">
              <svg class="icon-sun" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true">
                <circle cx="12" cy="12" r="4" fill="currentColor"></circle>
                <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <line x1="12" y1="2.5" x2="12" y2="4.5"></line>
                  <line x1="12" y1="19.5" x2="12" y2="21.5"></line>
                  <line x1="2.5" y1="12" x2="4.5" y2="12"></line>
                  <line x1="19.5" y1="12" x2="21.5" y2="12"></line>
                  <line x1="5.6" y1="5.6" x2="7" y2="7"></line>
                  <line x1="17" y1="17" x2="18.4" y2="18.4"></line>
                  <line x1="18.4" y1="5.6" x2="17" y2="7"></line>
                  <line x1="7" y1="17" x2="5.6" y2="18.4"></line>
                </g>
              </svg>
              <svg class="icon-moon" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true">
                <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" fill="currentColor"></path>
              </svg>
            </span>
          </span>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  // 导航栏入场动画：仅首次加载播放（从下方弹上来），软导航切换页面时不重播
  let navEntered = false;
  const playNavEnter = () => {
    if (navEntered) return;
    const nav = document.querySelector('.navbar');
    if (!nav) return;
    navEntered = true;
    nav.classList.add('nav-enter');
    nav.addEventListener('animationend', () => nav.classList.remove('nav-enter'), { once: true });
  };
  document.addEventListener('astro:page-load', playNavEnter);
  playNavEnter();

  // 滚动监听：移动端胶囊导航栏滚动时切换玻璃态
  const onScroll = () => {
    const wrap = document.getElementById('nav-wrap');
    if (!wrap) return;
    wrap.classList.toggle('scrolled', window.scrollY > 0);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // 导航栏光标泛光：把光标相对导航栏的坐标写进 --mx/--my，驱动 ::before 的光斑实时跟随
  const updateGlow = (clientX: number, clientY: number) => {
    const nav = document.querySelector('.navbar');
    if (!nav) return;
    const rect = nav.getBoundingClientRect();
    nav.style.setProperty('--mx', `${clientX - rect.left}px`);
    nav.style.setProperty('--my', `${clientY - rect.top}px`);
  };
  document.addEventListener(
    'mousemove',
    (e) => {
      const nav = e.target instanceof Element ? e.target.closest('.navbar') : null;
      if (!nav) return;
      updateGlow(e.clientX, e.clientY);
    },
    { passive: true }
  );

  // 移动端触控：没有 hover，用 touching 类等效触发光斑。
  // - touchstart 用事件委托绑在 document 上（只处理 .nav-inner 内的触摸），
  //   ClientRouter 页面切换后无需重新绑定
  // - touchend + touchcancel 双保险清理（移动端滚动时浏览器会发 touchcancel
  //   而不是 touchend，只听 touchend 会导致玻璃残留不消失）
  // - 快速点击时 touchstart→touchend 间隔极短，泛光还没亮起来就要消失，
  //   所以 touchend 延迟 ~120ms 再移除 touching，让光斑先亮起来再淡出
  let touching = false;
  let glowTimer: number | null = null;
  const setTouching = (on: boolean) => {
    touching = on;
    document.getElementById('nav-wrap')?.classList.toggle('touching', on);
  };
  document.addEventListener(
    'touchstart',
    (e) => {
      const t = e.touches[0];
      if (!t) return;
      // 只在触摸落在导航栏/面板内时激活
      if (!(e.target instanceof Element) || !e.target.closest('.nav-inner')) return;
      // 新的触摸开始，取消之前挂起的淡出
      if (glowTimer) {
        clearTimeout(glowTimer);
        glowTimer = null;
      }
      updateGlow(t.clientX, t.clientY);
      setTouching(true);
    },
    { passive: true }
  );
  document.addEventListener(
    'touchmove',
    (e) => {
      if (!touching) return;
      const t = e.touches[0];
      if (t) updateGlow(t.clientX, t.clientY);
    },
    { passive: true }
  );
  // 松手后延迟一小段再淡出，保证快速点击也能看到泛光亮起
  const endTouch = () => {
    if (glowTimer) clearTimeout(glowTimer);
    glowTimer = window.setTimeout(() => {
      setTouching(false);
      glowTimer = null;
    }, 120);
  };
  document.addEventListener('touchend', endTouch, { passive: true });
  document.addEventListener('touchcancel', endTouch, { passive: true });

  // 移动端菜单开合：事件委托（视图切换后按钮被替换也正常工作）
  document.addEventListener('click', (event) => {
    const wrap = document.getElementById('nav-wrap');
    if (!wrap) return;
    const target = event.target instanceof Element ? event.target : null;
    const menuBtn = document.getElementById('menu-toggle');

    if (target?.closest('#menu-toggle')) {
      const open = wrap.classList.toggle('mobile-open');
      menuBtn?.setAttribute('aria-expanded', String(open));
      return;
    }
    // 主题滑钮：切换后保持菜单展开，不收起
    if (target?.closest('.theme-switch')) return;
    // 点击菜单外任意位置（含菜单内链接）时收起菜单
    if (wrap.classList.contains('mobile-open')) {
      wrap.classList.remove('mobile-open');
      menuBtn?.setAttribute('aria-expanded', 'false');
    }
  });

  // 搜索交互：点圆形按钮第一次展开输入框并聚焦，已展开时点击 = 提交搜索
  document.addEventListener('click', (event) => {
    const btn = event.target instanceof Element ? event.target.closest('.search-btn') : null;
    if (!btn) return;
    const form = btn.closest('.search-form');
    if (!form) return;
    if (form.classList.contains('expanded')) {
      submitSearch(form);
    } else {
      form.classList.add('expanded');
      form.querySelector('.search-input')?.focus();
    }
  });

  // 统一的搜索提交：查询词存 sessionStorage 再跳转，
  // 完全绕开 URL 中文编码在 Vite dev server 返回 400 的问题
  const submitSearch = (form: Element) => {
    const input = form.querySelector('.search-input') as HTMLInputElement | null;
    const q = (input?.value ?? '').trim();
    sessionStorage.setItem('search-query', q);
    window.location.assign('/search');
  };

  // 回车提交
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Enter') return;
    const input = event.target instanceof Element ? event.target.closest('.search-input') : null;
    if (!input) return;
    const form = input.closest('.search-form');
    if (form) {
      event.preventDefault();
      submitSearch(form);
    }
  });

  // 点击搜索框外部：输入为空时才收起（有内容时保留，方便继续编辑/点按钮提交）
  document.addEventListener('click', (event) => {
    const inside = event.target instanceof Element ? event.target.closest('.search-form') : null;
    if (inside) return;
    document.querySelectorAll('.search-form.expanded').forEach((form) => {
      const input = form.querySelector('.search-input');
      if (input && !input.value.trim()) form.classList.remove('expanded');
    });
  });
  // 输入框失焦：输入为空时才收起
  document.addEventListener('focusout', (event) => {
    const input = event.target;
    if (!(input instanceof Element) || !input.classList.contains('search-input')) return;
    if (!input.value.trim()) input.closest('.search-form')?.classList.remove('expanded');
  });
</script>

<style>
  /* 外层：固定在顶部、整条通栏（桌面=不透明实心条，移动=液态玻璃条） */
  .nav-wrap {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
  }
  /* 内层包装：承载导航栏与下拉面板，让面板与导航栏平级（避免嵌套 backdrop-filter） */
  .nav-inner {
    position: relative;
    width: 100%;
  }
  .navbar {
    position: relative;
    width: 100%;
    height: 56px;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0 3rem; /* 与首页容器的左右内边距对齐 */
    border-radius: 0;
  }

  /* 光标泛光层（保留）：白色光斑以 --mx/--my（相对导航栏坐标）为圆心，
     随手指实时移动；仅在移动端触摸（.touching）时亮起 */
  .navbar::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      180px circle at var(--mx, 50%) var(--my, 50%),
      rgba(255, 255, 255, 0.22),
      rgba(255, 255, 255, 0.08) 45%,
      transparent 72%
    );
    opacity: 0;
    /* 基础态的 transition 决定"离开 touching"时的淡出速度（慢一点，余韵自然） */
    transition: opacity 0.4s ease;
    pointer-events: none;
  }
  .nav-wrap.touching .navbar::before {
    opacity: 1;
    /* touching 态的 transition 决定"进入 touching"时的淡入速度（几乎瞬时亮起） */
    transition: opacity 0.05s ease;
  }

  .logo {
    font-size: 1.35rem;
    font-weight: 700;
    background: var(--heading-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-decoration: none;
    flex-shrink: 0;
  }

  /* 桌面端横向链接 */
  .links {
    display: flex;
    gap: 1.4rem;
    flex: 1;
  }
  .links a {
    position: relative;
    color: var(--accent-text);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    padding-bottom: 4px;
    white-space: nowrap;
    transition: color 0.2s ease;
  }
  /* 底部横杠：悬浮时从左到右扫过 */
  .links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    border-radius: 1px;
    background: var(--nav-underline);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.3s ease;
  }
  .links a:hover,
  .links a.active {
    color: var(--text);
  }
  .links a:hover::after,
  .links a.active::after {
    transform: scaleX(1);
  }

  /* 搜索：默认收成圆形图标按钮，悬浮/聚焦展开为条 */
  .search-form {
    display: flex;
    align-items: center;
    height: 34px;
    border-radius: 999px;
    border: 1px solid var(--nav-border);
    background: var(--surface);
    overflow: hidden;
    flex-shrink: 0;
    margin-left: auto;
    transition: border-color 0.2s ease;
  }
  .search-btn {
    /* 32 = 表单 34px 高（含 1px 边框）减去上下边框：这样按钮不会被 overflow 裁掉，
       表单收起时的轮廓正好是 34×34 的正圆（原来按钮 34px 宽 → 表单 36×34 是椭圆） */
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    border: none;
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    flex-shrink: 0;
  }
  .search-input {
    border: none;
    outline: none;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 0.88rem;
    /* 撑满表单内容区：展开成搜索栏时不会改变表单内部的高度，
       竖直方向与收起态完全一致 */
    height: 100%;
    width: 0;
    opacity: 0;
    padding: 0;
    transition:
      width 0.3s ease,
      opacity 0.25s ease,
      padding 0.3s ease;
  }
  .search-form:hover,
  .search-form:focus-within,
  .search-form.expanded {
    border-color: var(--btn-primary-bg);
  }
  .search-form:hover .search-input,
  .search-form:focus-within .search-input,
  .search-form.expanded .search-input {
    width: 8rem;
    opacity: 1;
    padding: 0 0.75rem 0 0.15rem;
  }

  /* 汉堡按钮（仅移动端显示）：三根 SVG 线，开合时变形成叉叉。
     34×34 与搜索表单的轮廓（34×34 圆）统一 */
  .hamburger {
    display: none;
    width: 34px;
    height: 34px;
    justify-content: center;
    align-items: center;
    border: 1px solid var(--nav-border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text-secondary);
    cursor: pointer;
    flex-shrink: 0;
  }
  .hamburger svg {
    display: block;
  }
  .hamburger line {
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    /* 以整个 viewBox 为参考系，每根线绕自身中点旋转 */
    transform-box: view-box;
    transform-origin: 12px 6px;
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
  }
  .hamburger line:nth-child(2) {
    transform-origin: 12px 12px;
  }
  .hamburger line:nth-child(3) {
    transform-origin: 12px 18px;
  }
  .nav-wrap.mobile-open .hamburger line:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .nav-wrap.mobile-open .hamburger line:nth-child(2) {
    opacity: 0;
  }
  .nav-wrap.mobile-open .hamburger line:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* 移动端下拉菜单：与导航栏平级的液态玻璃卡片（面板滤镜），
     常驻 DOM 用 visibility 隐藏，开合走淡入淡出 + 轻微下坠，链接逐条错位滑入 */
  .mobile-panel {
    position: absolute;
    top: calc(100% + 0.6rem);
    left: 0;
    right: 0;
    margin: 0 auto;
    width: calc(100% - 1.5rem);
    max-width: 672px;
    display: flex;
    flex-direction: column;
    padding: 0.35rem;
    border-radius: 16px;
    pointer-events: auto;
    background: var(--nav-glass-bg);
    backdrop-filter: blur(24px) saturate(180%) brightness(1.03);
    -webkit-backdrop-filter: blur(24px) saturate(180%) brightness(1.03);
    border: 1px solid var(--nav-glass-border);
    box-shadow:
      inset 0 1px 0 var(--nav-glass-hi),
      inset 0 -1px 0 var(--nav-glass-lo),
      0 8px 32px rgba(0, 0, 0, 0.12);
    /* 关闭态：淡出并轻微上收 */
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition:
      opacity 0.3s ease,
