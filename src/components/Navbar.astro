---
// 顶部导航栏：全局唯一实例（由 Layout.astro 引入，所有页面共享）
// 桌面端：悬浮液态玻璃条，滚动收窄为胶囊，搜索框悬浮展开
// 移动端：汉堡菜单（竖向下拉）+ 圆形搜索图标按钮
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';

const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/characters', label: 'Characters' },
  { href: '/posts', label: 'Posts' },
];

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(href + '/');
---

<header class="nav-wrap" id="nav-wrap">
  <nav class="navbar" aria-label="主导航">
    <a href="/" class="logo">HC</a>

    <!-- 桌面端横向链接 -->
    <div class="links">
      {
        links.map(({ href, label }) => (
          <a href={href} class={isActive(href) ? 'active' : ''} aria-current={isActive(href) ? 'page' : undefined}>
            {label}
          </a>
        ))
      }
    </div>

    <!-- 搜索：默认收成圆形图标按钮，点一下展开输入框，Enter 提交（桌面端悬浮也会展开） -->
    <form class="search-form" action="/search" method="get" role="search">
      <button type="button" class="search-btn" aria-label="展开搜索">
        <svg
          viewBox="0 0 24 24"
          width="16"
          height="16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>
      <input
        type="search"
        name="q"
        class="search-input"
        placeholder="Search…"
        aria-label="搜索全站"
        autocomplete="off"
      />
    </form>

    <!-- 移动端汉堡按钮 -->
    <button id="menu-toggle" class="hamburger" aria-label="打开菜单" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <!-- 移动端下拉菜单（竖向排列） -->
    <div class="mobile-panel">
      {
        links.map(({ href, label }) => (
          <a href={href} class={isActive(href) ? 'active' : ''} aria-current={isActive(href) ? 'page' : undefined}>
            {label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  // 滚动时收窄导航栏；实时查询 DOM，兼容 ClientRouter 视图切换
  const onScroll = () => {
    document.getElementById('nav-wrap')?.classList.toggle('compact', window.scrollY > 24);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  document.addEventListener('astro:page-load', onScroll);
  onScroll();

  // 移动端菜单开合：事件委托（视图切换后按钮被替换也正常工作）
  document.addEventListener('click', (event) => {
    const wrap = document.getElementById('nav-wrap');
    if (!wrap) return;
    const target = event.target instanceof Element ? event.target : null;
    const menuBtn = document.getElementById('menu-toggle');

    if (target?.closest('#menu-toggle')) {
      const open = wrap.classList.toggle('mobile-open');
      menuBtn?.setAttribute('aria-expanded', String(open));
      return;
    }
    // 点击菜单外任意位置（含菜单内链接）时收起菜单
    if (wrap.classList.contains('mobile-open')) {
      wrap.classList.remove('mobile-open');
      menuBtn?.setAttribute('aria-expanded', 'false');
    }
  });

  // 搜索交互：点圆形按钮第一次展开输入框并聚焦，已展开时点击 = 提交搜索
  document.addEventListener('click', (event) => {
    const btn = event.target instanceof Element ? event.target.closest('.search-btn') : null;
    if (!btn) return;
    const form = btn.closest('.search-form');
    if (!form) return;
    if (form.classList.contains('expanded')) {
      form.submit();
    } else {
      form.classList.add('expanded');
      form.querySelector('.search-input')?.focus();
    }
  });

  // 点击搜索框外部：输入为空时才收起（有内容时保留，方便继续编辑/点按钮提交）
  document.addEventListener('click', (event) => {
    const inside = event.target instanceof Element ? event.target.closest('.search-form') : null;
    if (inside) return;
    document.querySelectorAll('.search-form.expanded').forEach((form) => {
      const input = form.querySelector('.search-input');
      if (input && !input.value.trim()) form.classList.remove('expanded');
    });
  });
  // 输入框失焦：输入为空时才收起
  document.addEventListener('focusout', (event) => {
    const input = event.target;
    if (!(input instanceof Element) || !input.classList.contains('search-input')) return;
    if (!input.value.trim()) input.closest('.search-form')?.classList.remove('expanded');
  });
</script>

<style>
  /* 外层容器：悬浮导航，四周留边距 */
  .nav-wrap {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 0.75rem 1rem;
    display: flex;
    justify-content: center;
    pointer-events: none; /* 让周围空白可点击 */
  }
  .navbar {
    pointer-events: auto;
    position: relative;
    width: 100%;
    max-width: 1080px;
    height: 56px;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0 1.25rem;
    border-radius: 18px;
    /* 液态玻璃：半透明底 + 渐变描边（模拟玻璃受光边缘） */
    border: 1px solid transparent;
    background:
      linear-gradient(var(--nav-tint), var(--nav-tint)) padding-box,
      linear-gradient(
        120deg,
        rgba(255, 255, 255, 0.65),
        rgba(255, 255, 255, 0.15) 26%,
        rgba(255, 255, 255, 0.04) 55%,
        rgba(255, 255, 255, 0.4)
      )
        border-box;
    backdrop-filter: blur(22px) saturate(1.8);
    -webkit-backdrop-filter: blur(22px) saturate(1.8);
    /* 内侧高光 = 玻璃上沿反光；外阴影 = 玻璃浮起 */
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.35),
      inset 0 -1px 0 rgba(255, 255, 255, 0.06),
      0 4px 24px rgba(0, 0, 0, 0.08);
    transition: all 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  /* 斜向流光层，模拟玻璃表面反光 */
  .navbar::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      115deg,
      rgba(255, 255, 255, 0.18) 0%,
      rgba(255, 255, 255, 0) 30%,
      rgba(255, 255, 255, 0) 70%,
      rgba(255, 255, 255, 0.1) 100%
    );
    pointer-events: none;
  }

  .logo {
    font-size: 1.35rem;
    font-weight: 700;
    background: var(--heading-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-decoration: none;
    flex-shrink: 0;
  }

  /* 桌面端横向链接 */
  .links {
    display: flex;
    gap: 1.4rem;
    flex: 1;
  }
  .links a {
    position: relative;
    color: var(--accent-text);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    padding-bottom: 4px;
    white-space: nowrap;
    transition: color 0.2s ease;
  }
  /* 底部横杠：悬浮时从左到右扫过 */
  .links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    border-radius: 1px;
    background: var(--btn-primary-bg);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.3s ease;
  }
  .links a:hover,
  .links a.active {
    color: var(--text);
  }
  .links a:hover::after,
  .links a.active::after {
    transform: scaleX(1);
  }

  /* 搜索：默认收成圆形图标按钮，悬浮/聚焦展开为条 */
  .search-form {
    display: flex;
    align-items: center;
    height: 34px;
    border-radius: 999px;
    border: 1px solid var(--nav-border);
    background: var(--surface);
    overflow: hidden;
    flex-shrink: 0;
    margin-left: auto;
    transition: border-color 0.2s ease;
  }
  .search-btn {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border: none;
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    flex-shrink: 0;
  }
  .search-input {
    border: none;
    outline: none;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 0.88rem;
    width: 0;
    opacity: 0;
    padding: 0;
    transition:
      width 0.3s ease,
      opacity 0.25s ease,
      padding 0.3s ease;
  }
  .search-form:hover,
  .search-form:focus-within,
  .search-form.expanded {
    border-color: var(--btn-primary-bg);
  }
  .search-form:hover .search-input,
  .search-form:focus-within .search-input,
  .search-form.expanded .search-input {
    width: 8rem;
    opacity: 1;
    padding: 0 0.75rem 0 0.15rem;
  }

  /* 汉堡按钮（仅移动端显示） */
  .hamburger {
    display: none;
    width: 34px;
    height: 34px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
    border: 1px solid var(--nav-border);
    border-radius: 999px;
    background: var(--surface);
    cursor: pointer;
    flex-shrink: 0;
  }
  .hamburger span {
    width: 15px;
    height: 2px;
    border-radius: 1px;
    background: var(--text-secondary);
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
  }
  .nav-wrap.mobile-open .hamburger span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .nav-wrap.mobile-open .hamburger span:nth-child(2) {
    opacity: 0;
  }
  .nav-wrap.mobile-open .hamburger span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* 移动端下拉菜单（默认隐藏） */
  .mobile-panel {
    display: none;
    position: absolute;
    top: calc(100% + 0.6rem);
    left: 0;
    right: 0;
    flex-direction: column;
    padding: 0.5rem;
    border-radius: 16px;
    border: 1px solid transparent;
    background:
      linear-gradient(var(--nav-tint), var(--nav-tint)) padding-box,
      linear-gradient(
        120deg,
        rgba(255, 255, 255, 0.65),
        rgba(255, 255, 255, 0.15) 26%,
        rgba(255, 255, 255, 0.04) 55%,
        rgba(255, 255, 255, 0.4)
      )
        border-box;
    backdrop-filter: blur(22px) saturate(1.8);
    -webkit-backdrop-filter: blur(22px) saturate(1.8);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.35),
      0 8px 32px rgba(0, 0, 0, 0.18);
  }
  .nav-wrap.mobile-open .mobile-panel {
    display: flex;
  }
  .mobile-panel a {
    padding: 0.8rem 1rem;
    border-radius: 10px;
    text-decoration: none;
    color: var(--accent-text);
    font-weight: 500;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }
  .mobile-panel a:hover,
  .mobile-panel a.active {
    background: var(--surface);
    color: var(--text);
  }

  /* ============ 桌面端（> 768px）：滚动收窄为胶囊 ============ */
  @media (min-width: 769px) {
    .hamburger {
      display: none;
    }
    .nav-wrap.compact {
      padding: 0.5rem 1rem;
    }
    .nav-wrap.compact .navbar {
      max-width: 640px;
      height: 46px;
      gap: 1rem;
      padding: 0 1.1rem;
      border-radius: 999px;
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.35),
        inset 0 -1px 0 rgba(255, 255, 255, 0.06),
        0 8px 32px rgba(0, 0, 0, 0.18);
    }
    .nav-wrap.compact .logo {
      font-size: 1.15rem;
    }
    .nav-wrap.compact .links {
      gap: 1rem;
    }
  }

  /* ============ 移动端（<= 768px）：汉堡菜单 + 圆形搜索 ============ */
  @media (max-width: 768px) {
    .links {
      display: none; /* 横向链接收进下拉菜单 */
    }
    .hamburger {
      display: flex;
    }
    /* 搜索默认只剩圆形按钮；点一下加 .expanded 展开输入框（Enter 提交） */
    .search-input {
      display: none;
    }
    .search-form.expanded .search-input {
      display: block;
      width: 6.5rem;
      opacity: 1;
      padding: 0 0.6rem 0 0.15rem;
    }
    .navbar {
      gap: 0.75rem;
      height: 52px;
      padding: 0 0.9rem;
    }
  }
</style>
