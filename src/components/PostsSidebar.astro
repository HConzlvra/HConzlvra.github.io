---
import { getCollection } from 'astro:content';

interface Props {
  currentSlug?: string;
}
const { currentSlug = '' } = Astro.props;

const posts = (await getCollection('posts')).sort(
  (a, b) => (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0)
);
---

<!-- 开关按钮：grid 第一列，sticky 钉在视口顶部，开合时永不位移。
     圆形玻璃质感 + chevron 指示方向，与导航栏 hamburger 同语言 -->
<button
  class="sidebar-toggle"
  type="button"
  aria-expanded="false"
  aria-controls="posts-sidebar-panel"
  aria-label="切换文章目录"
>
  <svg class="toggle-icon" viewBox="0 0 24 24" aria-hidden="true">
    <!-- 侧栏图标：左竖条 + 右大方块，展开时左条变粗（fill 切换） -->
    <rect class="ic-bar" x="3" y="4" width="4" height="16" rx="1.5" />
    <rect class="ic-panel" x="9" y="4" width="12" height="16" rx="2" />
  </svg>
</button>

<!-- 侧栏面板：grid 第二列（电脑端 push），移动端全高贴边抽屉 -->
<aside class="posts-sidebar">
  <div class="sidebar-panel" id="posts-sidebar-panel">
    <div class="sidebar-header">
      <span class="sidebar-title">Posts</span>
    </div>
    {
      posts.length === 0 ? (
        <p class="sidebar-empty">暂无文章</p>
      ) : (
        <nav class="sidebar-links">
          {posts.map((post) => (
            <a
              href={`/posts/${post.id}`}
              class:list={['sidebar-link', currentSlug === post.id && 'active']}
              aria-current={currentSlug === post.id ? 'page' : undefined}
              data-slug={post.id}
              data-title={post.data.title}
              data-date={post.data.pubDate?.toISOString() ?? ''}
            >
              <span class="link-title">{post.data.title}</span>
              {post.data.pubDate && (
                <time class="link-date" datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
              )}
            </a>
          ))}
        </nav>
      )
    }
  </div>
</aside>

<!-- 移动端遮罩：点遮罩收起面板 -->
<div class="sidebar-scrim" aria-hidden="true"></div>

<style>
  /* ============ 开关按钮（两端共用） ============ */
  .sidebar-toggle {
    position: sticky;
    top: 6rem;
    align-self: start;
    z-index: 40;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    margin-right: 0.9rem;
    padding: 0;
    border: 1px solid var(--surface-border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text-secondary);
    cursor: pointer;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
    transition: background 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
  }
  .sidebar-toggle:hover {
    background: var(--surface-hover);
    color: var(--text);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.14);
  }
  .toggle-icon {
    width: 1.1rem;
    height: 1.1rem;
    transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .toggle-icon .ic-bar,
  .toggle-icon .ic-panel {
    fill: currentColor;
    transition: fill 0.2s ease;
  }
  /* 展开时：图标整体旋 180°，左条与右块互换视觉位置，暗示"已展开可收起" */
  :global(.posts-layout[data-open='true']) .toggle-icon {
    transform: rotate(180deg);
  }

  /* ============ 侧栏面板：电脑端 push（grid 第二列） ============ */
  .posts-sidebar {
    align-self: start;
    overflow: hidden;
    height: fit-content;
    margin-right: 2rem;
  }
  .sidebar-panel {
    width: 240px;
    display: grid;
    gap: 0.5rem;
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 0.22s ease, transform 0.22s ease;
    transition-delay: 0s;
  }
  :global(.posts-layout[data-open='true']) .sidebar-panel {
    opacity: 1;
    transform: none;
    transition-delay: 0.1s; /* 等列宽撑开再显内容 */
  }
  .sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--surface-border);
  }
  .sidebar-title {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .sidebar-links {
    display: grid;
    gap: 0.2rem;
  }
  .sidebar-link {
    position: relative;
    display: grid;
    gap: 0.1rem;
    padding: 0.35rem 0.65rem 0.45rem;
    border-radius: 8px;
    text-decoration: none;
    color: var(--text);
    transition: background 0.2s ease, color 0.2s ease;
  }
  .sidebar-link::after {
    content: '';
    position: absolute;
    left: 0.65rem;
    right: 0.65rem;
    bottom: 0.1rem;
    height: 2px;
    border-radius: 1px;
    background: var(--btn-primary-bg);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.3s ease;
  }
  .sidebar-link:hover {
    background: var(--surface);
  }
  .sidebar-link:hover::after,
  .sidebar-link.active::after {
    transform: scaleX(1);
  }
  .sidebar-link.active {
    background: var(--surface);
  }
  .link-title {
    font-weight: 600;
    font-size: 0.92rem;
    line-height: 1.4;
  }
  .link-date {
    font-size: 0.72rem;
    color: var(--text-secondary);
  }
  .sidebar-empty {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  /* 遮罩仅移动端用 */
  .sidebar-scrim {
    display: none;
  }

  /* ============ 移动端：全高贴边抽屉 ============ */
  @media (max-width: 768px) {
    /* 按钮固定在左上（导航栏下方），开合时永不位移；
       展开后浮在抽屉上方充当关闭钮，与"Posts"头部行同高对齐 */
    .sidebar-toggle {
      position: fixed;
      top: 5rem;
      left: 1rem;
      margin-right: 0;
      z-index: 95;
    }
    /* 侧栏脱离 grid，fixed 全高贴左边缘，从左滑入 */
    .posts-sidebar {
      position: static;
      overflow: visible;
      height: auto;
      margin-right: 0;
    }
    .sidebar-panel {
      position: fixed;
      top: 0;
      left: 0;
      width: min(82vw, 19rem);
      height: 100dvh;
      max-height: 100dvh;
      padding: 5rem 1rem 1.2rem;
      overflow-y: auto;
      overscroll-behavior: contain;
      gap: 0.45rem;
      opacity: 0;
      transform: translateX(-104%);
      pointer-events: none;
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.22s ease;
      z-index: 90;
      border-right: 1px solid var(--surface-border);
      backdrop-filter: blur(22px) saturate(1.2);
      -webkit-backdrop-filter: blur(22px) saturate(1.2);
    }
    :global(html[data-theme='light']) .sidebar-panel {
      background: rgba(245, 242, 251, 0.94);
    }
    :global(html[data-theme='dark']) .sidebar-panel {
      background: rgba(14, 12, 24, 0.96);
    }
    :global(.posts-layout[data-open='true']) .sidebar-panel {
      transform: translateX(0);
      opacity: 1;
      pointer-events: auto;
    }
    /* 头部行：与固定开关按钮同行，标题给按钮让位 */
    .sidebar-header {
      min-height: 2.4rem;
      padding: 0 0 0.4rem 2.9rem;
    }
    /* 紧凑列表：单行条目，日期右对齐，去掉卡片底/描边 */
    .sidebar-links {
      gap: 0.1rem;
    }
    .sidebar-link {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      padding: 0.45rem 0.55rem 0.55rem;
    }
    .sidebar-link::after {
      left: 0.55rem;
      right: 0.55rem;
      bottom: 0.12rem;
    }
    .link-title {
      min-width: 0;
      font-size: 0.84rem;
    }
    .link-date {
      margin-left: auto;
      flex-shrink: 0;
      font-size: 0.68rem;
    }

    /* 遮罩：全屏覆盖，点遮罩收起 */
    .sidebar-scrim {
      display: block;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.32);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
      z-index: 85;
      backdrop-filter: blur(2px);
      -webkit-backdrop-filter: blur(2px);
    }
    :global(.posts-layout[data-open='true']) .sidebar-scrim {
      opacity: 1;
      pointer-events: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-toggle,
    .sidebar-panel,
    .sidebar-scrim,
    .toggle-icon {
      transition: none !important;
    }
  }
</style>

<script>
  function setupPostsSidebar() {
    const layout = document.querySelector('.posts-layout');
    if (!layout || layout.dataset.bound === '1') return;
    layout.dataset.bound = '1';

    const toggle = layout.querySelector('.sidebar-toggle');
    const scrim = layout.querySelector('.sidebar-scrim');
    if (!toggle) return;

    const isMobile = () => window.matchMedia('(max-width: 768px)').matches;
    const STORAGE_KEY = 'posts-sidebar-open';

    const applyState = (open: boolean) => {
      layout.setAttribute('data-open', open ? 'true' : 'false');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    };

    // 电脑端恢复上次展开偏好；移动端始终默认收起
    const restore = () => {
      if (!isMobile()) {
        const saved = localStorage.getItem(STORAGE_KEY);
        applyState(saved === '1');
      } else {
        applyState(false);
      }
    };
    restore();

    const setOpen = (open: boolean) => {
      applyState(open);
      if (!isMobile()) localStorage.setItem(STORAGE_KEY, open ? '1' : '0');
    };

    toggle.addEventListener('click', () => {
      setOpen(layout.getAttribute('data-open') !== 'true');
    });

    if (scrim) scrim.addEventListener('click', () => setOpen(false));

    // 委托：点目录链接时，移动端收起面板（电脑端保持展开）
    layout.addEventListener('click', (e) => {
      const a = (e.target as Element)?.closest('.sidebar-link');
      if (a && isMobile()) setOpen(false);
    });

    // 跨断点切换：从电脑切到移动时收起，避免残留展开态
    const mq = window.matchMedia('(max-width: 768px)');
    mq.addEventListener('change', (e) => {
      if (e.matches) applyState(false);
      else restore();
    });
  }

  function mergeSidebarPosts() {
    import('../lib/api').then(({ API_BASE }) => {
      const API = API_BASE;
      const fmt = (ts: number) =>
        new Date(ts).toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' });

      fetch(`${API}/posts`)
        .then((res) => (res.ok ? res.json() : null))
        .then((payload) => {
          const posts = Array.isArray(payload?.posts) ? payload.posts : [];
          const nav = document.querySelector('.sidebar-links') as HTMLElement | null;
          const dynamic = posts.filter((p) => p?.slug);
          if (!dynamic.length) return;

          let holder = nav;
          if (!holder) {
            const empty = document.querySelector('.sidebar-empty');
            if (!empty) return;
            holder = document.createElement('nav');
            holder.className = 'sidebar-links';
            empty.replaceWith(holder);
          }

          const items = [...holder.querySelectorAll<HTMLAnchorElement>('.sidebar-link')].map((a) => ({
            slug: a.dataset.slug || '',
            title: a.dataset.title || '',
            ts: Number(new Date(a.dataset.date || 0).valueOf()) || 0,
            el: a as HTMLElement,
          }));

          for (const p of dynamic) {
            const slug = p.slug;
            if (!slug || items.some((it) => it.slug === slug)) continue;
            items.push({ slug, title: p.title || slug, ts: Number(p.created_at) || 0, el: null });
          }

          items.sort((a, b) => (b.ts || 0) - (a.ts || 0));

          const proto = holder.querySelector('.sidebar-link');
          for (const it of items) {
            if (it.el) continue;
            const a = (proto?.cloneNode(true) || document.createElement('a')) as HTMLAnchorElement;
            a.href = `/posts/${it.slug}`;
            a.removeAttribute('aria-current');
            a.classList.remove('active');
            a.dataset.slug = it.slug;
            a.dataset.title = it.title;
            a.dataset.date = new Date(it.ts).toISOString();
            const title = a.querySelector('.link-title');
            if (title) title.textContent = it.title;
            if (!title) a.textContent = it.title;
            const date = a.querySelector('.link-date');
            if (date) date.textContent = fmt(it.ts);
            it.el = a;
          }

          holder.innerHTML = '';
          for (const it of items) holder.append(it.el!);
        })
        .catch(() => {
          /* 后端不可用：保持静态目录 */
        });
    });
  }

  document.addEventListener('astro:page-load', () => {
    setupPostsSidebar();
    mergeSidebarPosts();
  });
  setupPostsSidebar();
  mergeSidebarPosts();
</script>
