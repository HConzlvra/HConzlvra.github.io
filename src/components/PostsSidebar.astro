---
import { getCollection } from 'astro:content';

interface Props {
  currentSlug?: string;
}
const { currentSlug = '' } = Astro.props;

// 按发布日期倒序
const posts = (await getCollection('posts')).sort(
  (a, b) => (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0)
);
---

<aside class="posts-sidebar">
  <button class="sidebar-toggle" type="button" aria-expanded="false" aria-controls="posts-sidebar-panel">
    <span>Posts</span>
    <span class="sidebar-caret" aria-hidden="true">▾</span>
  </button>
  <div class="sidebar-panel" id="posts-sidebar-panel">
    <div class="sidebar-header">
      <span class="sidebar-title">Posts</span>
    </div>
    {
      posts.length === 0 ? (
        <p class="sidebar-empty">暂无文章</p>
      ) : (
        <nav class="sidebar-links">
          {posts.map((post) => (
            <a
              href={`/posts/${post.id}`}
              class:list={['sidebar-link', currentSlug === post.id && 'active']}
              aria-current={currentSlug === post.id ? 'page' : undefined}
              data-slug={post.id}
              data-title={post.data.title}
              data-date={post.data.pubDate?.toISOString() ?? ''}
            >
              <span class="link-title">{post.data.title}</span>
              {post.data.pubDate && (
                <time class="link-date" datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
              )}
            </a>
          ))}
        </nav>
      )
    }
  </div>
</aside>

<style>
  .posts-sidebar {
    position: sticky;
    top: 90px;
    align-self: start;
  }
  .sidebar-panel {
    display: grid;
    gap: 0.75rem;
  }
  .sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--surface-border);
  }
  .sidebar-title {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .sidebar-caret {
    font-size: 0.8rem;
    color: var(--text-secondary);
    transition: transform 0.2s ease;
  }
  .sidebar-toggle {
    display: none;
  }
  .sidebar-links {
    display: grid;
    gap: 0.25rem;
  }
  .sidebar-link {
    position: relative;
    display: grid;
    gap: 0.15rem;
    padding: 0.6rem 0.75rem 0.7rem;
    border-radius: 8px;
    text-decoration: none;
    color: var(--text);
    transition: background 0.2s ease;
  }
  /* 底部横杠：悬浮时从左到右扫过（与顶部导航栏一致） */
  .sidebar-link::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.2rem;
    height: 2px;
    border-radius: 1px;
    background: var(--btn-primary-bg);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.3s ease;
  }
  .sidebar-link:hover {
    background: var(--surface);
  }
  .sidebar-link:hover::after,
  .sidebar-link.active::after {
    transform: scaleX(1);
  }
  .sidebar-link.active {
    background: var(--surface);
  }
  .link-title {
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.4;
  }
  .link-date {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }
  .sidebar-empty {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }
  @media (max-width: 768px) {
    .posts-sidebar {
      position: fixed;
      top: 4.5rem;
      left: 0;
      z-index: 60;
    }
    .sidebar-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.45rem;
      min-width: 5.4rem;
      padding: 0.55rem 0.8rem;
      border: 1px solid var(--surface-border);
      border-radius: 0 10px 10px 0;
      background: rgba(17, 17, 22, 0.92);
      color: var(--text);
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.22);
      cursor: pointer;
      font: inherit;
      font-size: 0.8rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      z-index: 62;
      position: relative;
    }
    .posts-sidebar.open .sidebar-toggle {
      transform: translateX(min(72vw, 18rem));
    }
    .sidebar-panel {
      position: fixed;
      top: 4.5rem;
      left: 0;
      width: min(72vw, 18rem);
      max-height: calc(100vh - 5.5rem);
      overflow-y: auto;
      padding: 1rem 0.8rem 0.9rem;
      background: rgba(17, 17, 22, 0.96);
      border-right: 1px solid var(--surface-border);
      border-radius: 0 16px 16px 0;
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.28);
      transform: translateX(-110%);
      transition: transform 0.25s ease;
      gap: 0.6rem;
    }
    .posts-sidebar.open .sidebar-panel {
      transform: translateX(0);
    }
    .sidebar-header {
      padding-bottom: 0.45rem;
    }
    .sidebar-links {
      gap: 0.5rem;
    }
    .sidebar-link {
      min-width: 0;
      background: var(--surface);
      border: 1px solid var(--surface-border);
      border-radius: 10px;
      padding: 0.65rem 0.7rem 0.8rem;
    }
    .link-title {
      font-size: 0.8rem;
    }
    .link-date {
      font-size: 0.68rem;
    }
  }
</style>

<script>
  const sidebar = document.querySelector('.posts-sidebar');
  const toggle = sidebar?.querySelector('.sidebar-toggle');
  if (sidebar && toggle) {
    toggle.addEventListener('click', () => {
      const isOpen = sidebar.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(isOpen));
    });
    sidebar.querySelectorAll('.sidebar-link').forEach((link) => {
      link.addEventListener('click', () => {
        sidebar.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>

<script>
  import { API_BASE } from '../lib/api';

  // 动态文章合并（与 posts/index.astro 同源逻辑）：侧边栏目录是静态构建的，
  // 这里运行时拉后端（D1）里 /admin 发布的文章，按日期降序混入。
  // 后端不可用或无新文章时保持静态目录原样
  const API = API_BASE;

  const fmt = (ts: number) =>
    new Date(ts).toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' });

  function mergeSidebarPosts() {
    fetch(`${API}/posts`)
      .then((res) => {
        if (!res.ok) return;
        return res.json();
      })
      .then((payload) => {
        const posts = Array.isArray(payload?.posts) ? payload.posts : [];
        const nav = document.querySelector('.sidebar-links') as HTMLElement | null;
        const dynamic = posts.filter((p) => p?.slug);
        if (!dynamic.length) return;

        let holder = nav;
        if (!holder) {
          const empty = document.querySelector('.sidebar-empty');
          if (!empty) return;
          holder = document.createElement('nav');
          holder.className = 'sidebar-links';
          empty.replaceWith(holder);
        }

        const items = [...holder.querySelectorAll<HTMLAnchorElement>('.sidebar-link')].map((a) => ({
          slug: a.dataset.slug || '',
          title: a.dataset.title || '',
          ts: Number(new Date(a.dataset.date || 0).valueOf()) || 0,
          el: a,
        }));

        for (const p of dynamic) {
          const slug = p.slug;
          if (!slug || items.some((it) => it.slug === slug)) continue;
          items.push({ slug, title: p.title || slug, ts: Number(p.created_at) || 0, el: null });
        }

        items.sort((a, b) => (b.ts || 0) - (a.ts || 0));

        const proto = holder.querySelector('.sidebar-link');
        for (const it of items) {
          if (it.el) continue;
          const a = (proto?.cloneNode(true) || document.createElement('a')) as HTMLAnchorElement;
          a.href = `/posts/${it.slug}`;
          a.removeAttribute('aria-current');
          a.classList.remove('active');
          a.dataset.slug = it.slug;
          a.dataset.title = it.title;
          a.dataset.date = new Date(it.ts).toISOString();
          const title = a.querySelector('.link-title');
          if (title) title.textContent = it.title;
          if (!title) a.textContent = it.title;
          const date = a.querySelector('.link-date');
          if (date) date.textContent = fmt(it.ts);
          it.el = a;
        }

        holder.innerHTML = '';
        for (const it of items) holder.append(it.el!);
      })
      .catch(() => {
        // 后端不可用：保持静态目录
      });
  }

  document.addEventListener('astro:page-load', mergeSidebarPosts);
  mergeSidebarPosts();
</script>
