---
// 背景：WebGL2 实时光栅抖动（ordered dither），两个变体：
// - sand：整幅画布缓慢流动的沙纹（黑白，主页使用）
// - star：八芒星（旧版，主题紫色，visions 收藏用）
// 抖动 / Bayer 8×8 来自 https://github.com/yashkotha/dither-hero（MIT）。
// 两种变体都用 alpha 叠加在页面渐变之上：底色透出来，亮处是抖动方格。
interface Props {
  variant?: 'sand' | 'star';
}
const { variant = 'sand' } = Astro.props;
---

<canvas class="dither-bg" data-dither data-variant={variant} aria-hidden="true"></canvas>

<style>
  .dither-bg {
    position: fixed;
    left: 0;
    top: 0;
    z-index: -1; /* 位于渐变背景之上、页面内容之下 */
    width: 100%;
    /* 用「最大视口高度」：移动端地址栏收起/展开时高度不变，
       画布不会跟着滚动重算尺寸（否则会抽一下） */
    height: 100vh;
    height: 100lvh;
    pointer-events: none;
    transform: translateZ(0); /* 单独合成层，滚动时不被页面重绘拖着走 */
  }
</style>

<script>
  // ---------- 变体参数 ----------
  const VARIANTS = {
    sand: {
      size: 2, // 抖动单元边长（CSS px），会取整成整数设备像素
      exposure: 1.02,
      gamma: 0.92,
      glow: 1, // sand 不用
      contrast: 1, // sand 不用
      scatter: 0.12,
      motion: 0.55,
      alpha: 0.5, // 黑白点的不透明度
    },
    star: {
      size: 2,
      exposure: 1.15,
      gamma: 1.1,
      glow: 1.7,
      contrast: 1.18,
      scatter: 0.2,
      motion: 0.4,
      alpha: 0.55,
    },
  } as const;

  const VERT = `#version 300 es
  in vec2 aPos; void main(){ gl_Position = vec4(aPos,0.0,1.0); }`;

  /* 公共部分：噪声 / Bayer */
  const COMMON = `
  uniform vec2  uRes;
  uniform float uTime;
  uniform vec2  uMouseUV;  // 光标，0..1（y 向上）
  uniform float uMouseOn;  // 0..1，首次移动后渐入
  uniform float uSize;     // 抖动单元边长（整数设备像素）
  uniform float uExposure;
  uniform float uGamma;
  uniform vec3  uTint;
  uniform float uAlpha;
  uniform float uVeil;     // 整幅黑色薄雾：浅色主题下把背景整体压暗
  uniform float uScatter;
  uniform vec2  uMouseVel; // 光标速度（场景坐标/秒），用于刮擦拖拽
  uniform float uInk;      // 局部墨量限制：密度越高，点越暗，避免整屏发亮

  float hash21(vec2 p){ p = fract(p*vec2(123.34,456.21)); p += dot(p,p+45.32); return fract(p.x*p.y); }
  vec3 mod289(vec3 x){ return x - floor(x*(1.0/289.0))*289.0; }
  vec2 mod289(vec2 x){ return x - floor(x*(1.0/289.0))*289.0; }
  vec3 permute(vec3 x){ return mod289(((x*34.0)+1.0)*x); }
  float snoise(vec2 v){
    const vec4 C = vec4(0.211324865405187,0.366025403784439,-0.577350269189626,0.024390243902439);
    vec2 i=floor(v+dot(v,C.yy)); vec2 x0=v-i+dot(i,C.xx);
    vec2 i1=(x0.x>x0.y)?vec2(1.0,0.0):vec2(0.0,1.0);
    vec4 x12=x0.xyxy+C.xxzz; x12.xy-=i1; i=mod289(i);
    vec3 p=permute(permute(i.y+vec3(0.0,i1.y,1.0))+i.x+vec3(0.0,i1.x,1.0));
    vec3 m=max(0.5-vec3(dot(x0,x0),dot(x12.xy,x12.xy),dot(x12.zw,x12.zw)),0.0);
    m=m*m; m=m*m;
    vec3 x=2.0*fract(p*C.www)-1.0; vec3 h=abs(x)-0.5; vec3 ox=floor(x+0.5); vec3 a0=x-ox;
    m*=1.79284291400159-0.85373472095314*(a0*a0+h*h);
    vec3 g; g.x=a0.x*x0.x+h.x*x0.y; g.yz=a0.yz*x12.xz+h.yz*x12.yw;
    return 130.0*dot(m,g);
  }
  float fbm(vec2 p){ float s=0.0,a=0.5; for(int i=0;i<4;i++){ s+=a*snoise(p); p*=2.03; a*=0.5; } return s; }

  float bayer2(vec2 a){ a=floor(a); return fract(dot(a,vec2(0.5,a.y*0.75))); }
  float bayer4(vec2 a){ return bayer2(0.5*a)*0.25 + bayer2(a); }
  float bayer8(vec2 a){ return bayer4(0.5*a)*0.25 + bayer2(a); }

  /* 抖动主循环：整格取格心的亮度 → 每格严格是完整正方形；
     uSize 是整数设备像素 → 格子等宽等高、严格对齐 */
  vec4 shade(vec2 fc, vec2 mSt, float t, float lum){
    vec2 gcell = floor(fc/uSize);
    float threshJ = (hash21(gcell + vec2(13.1, 71.7)) - 0.5) * uScatter;
    float thr = bayer8(gcell);
    float d = step(thr + threshJ, lum);
    d *= smoothstep(0.015, 0.09, lum);

    vec2 st = (fc - 0.5*uRes)/uRes.y;
    float vig = smoothstep(1.55, 0.2, length(st));
    /* 墨量限制（印刷里的 ink limit）：越密的区域点越淡。
       这样沙脊再厚也不会烧成一片白，整屏亮度有上界，不会"偶尔特别亮" */
    float ink = 1.0 - uInk * smoothstep(0.30, 0.92, lum);
    float a = d * mix(0.8, 1.0, vig) * ink;
    float narrow = smoothstep(1.05, 0.62, uRes.x/uRes.y);
    a *= uAlpha * mix(1.0, 0.6, narrow);
    // 黑色薄雾是"无点"的底色：预乘后 rgb 仍为 0，alpha 叠加即可压暗底色
    float va = uVeil * mix(1.0, 0.75, narrow);
    return vec4(uTint * a, clamp(a + va, 0.0, 1.0));
  }`;

  /* ---------- 变体 1：整幅流沙（黑白） ---------- */
  const FRAG_SAND = `#version 300 es
  precision highp float;
  out vec4 fragColor;
  ${COMMON}

  float scene(vec2 fc, vec2 mSt, float t){
    vec2 uv = fc/uRes;
    vec2 st = (fc - 0.5*uRes)/uRes.y;
    float narrow = smoothstep(1.05, 0.62, uRes.x/uRes.y);

    /* 整体极慢漂移 + 两层不同尺度的域扭曲：大层慢、小层稍快，形成层次 */
    vec2 q = st + vec2(t*0.010, -t*0.007);
    vec2 warpA = vec2(fbm(q*0.55 + vec2(0.0, t*0.018)),
                      fbm(q*0.55 + vec2(7.1, -t*0.014)));
    vec2 warpB = vec2(fbm(q*1.35 + vec2(3.2, t*0.030)),
                      fbm(q*1.35 + vec2(-4.4, -t*0.026)));
    vec2 w = q + warpA*0.75 + warpB*0.18;

    /* 局部扰动：不用 sin 环（会出现同心圆），改为
       ① 反平方衰减的径向推挤（参考 dither-hero / neuform 的指针排斥）
       ② 低频噪声决定方向的切向涡旋 → 有机翻卷
       ③ 沿光标速度方向的拖拽 → 像手指拨过沙面
       三者的作用域都只有一小片，且 JS 端缓动很慢，所以是渐进跟手 */
    vec2 toM = st - mSt;
    float md = length(toM);
    vec2 dirM = toM/(md + 1e-4);
    float on = uMouseOn;
    float push = on * 0.030 / (md*md + 0.020);
    push = min(push, 0.055);
    float nearF = smoothstep(mix(0.34, 0.26, narrow), 0.0, md);
    float swirl = snoise(st*3.4 + vec2(t*0.05, -t*0.04));
    vec2 tang = vec2(-dirM.y, dirM.x);
    vec2 mVel = clamp(uMouseVel, vec2(-1.6), vec2(1.6));
    w += dirM * push * 0.9
       + tang * (swirl * nearF * on * 0.085)
       + mVel * (nearF * on * 0.28);

    /* 大沙垄：宽、慢、方向略斜。窄屏提高空间频率，否则整屏只容得下一道沙脊 */
    float kf = mix(1.0, 1.7, narrow);
    float phaseA = (w.y*5.2 + w.x*1.7)*kf + fbm(w*0.72 + vec2(t*0.012, -t*0.008))*3.0 + t*0.02;
    float duneA = pow(0.5 + 0.5*cos(phaseA), 2.2);

    /* 中尺度沙纹：更细、方向不同、稍快一点（视差） */
    float phaseB = (w.x*8.0 - w.y*2.9)*kf + fbm(w*1.5 - vec2(t*0.020, t*0.012))*2.4 + t*0.035;
    float duneB = pow(0.5 + 0.5*cos(phaseB), 3.0);

    /* 细颗粒 + 大尺度疏密：让沙面有厚有薄 */
    float grain = fbm(w*7.0 + vec2(-t*0.030, t*0.025))*0.5 + 0.5;
    float density = fbm(q*0.5 + vec2(t*0.008, -t*0.006))*0.5 + 0.5;

    /* 整幅都有沙，但中部偏右略厚，形成柔和的视觉落点（不是具象图形）。 */
    float field = 0.03
                + duneA * (0.26 + 0.18*density)
                + duneB * 0.09 * (0.3 + 0.7*duneA)
                + grain * 0.03;

    vec2 c = vec2(mix(0.62, 0.5, narrow), mix(0.50, 0.46, narrow));
    vec2 p = (uv - c) * vec2(uRes.x/uRes.y, 1.0);
    float focus = smoothstep(1.05, 0.06, length(p));
    field *= mix(0.55, 0.45, narrow) + mix(0.75, 0.95, narrow)*focus;
    /* 中心再托一层底：即使落在两道沙脊之间，也留下柔和的密度，不会空成一片 */
    field += smoothstep(0.8, 0.0, length(p)) * 0.10;
    /* 光标附近沙粒被搅动的疏密：用 fbm 而不是同心环，形状不规则 */
    float stirred = fbm(w*4.5 + vec2(t*0.10, -t*0.08));
    field = max(field + stirred * nearF * on * 0.20, 0.0);

    /* 拉开垄顶与垄间的差距：沙脊处密到成片，低处只剩稀疏松散的颗粒，
       dither 的层次才看得出来，而不是一整屏均匀噪点 */
    field = pow(clamp(field, 0.0, 1.0), 1.3) * 1.35;
    field *= 1.0 + 0.05*sin(t*0.11);
    /* 封顶留出空档：再密的沙脊也保留 12% 的空格，不会糊成整块实心 */
    return min(field, 0.88) * mix(1.0, 0.9, narrow);
  }

  void main(){
    vec2 fc = gl_FragCoord.xy;
    vec2 gcell = floor(fc/uSize);
    vec2 cellCenter = (gcell + 0.5) * uSize;
    float t = uTime;
    vec2 mSt = vec2((uMouseUV.x-0.5)*uRes.x/uRes.y, uMouseUV.y-0.5);

    float lum = clamp(scene(cellCenter, mSt, t), 0.0, 1.0);
    lum = clamp(pow(lum, uGamma) * uExposure, 0.0, 1.0);
    fragColor = shade(fc, mSt, t, lum);
  }`;

  /* ---------- 变体 2：八芒星（旧版，主题紫色） ---------- */
  const FRAG_STAR = `#version 300 es
  precision highp float;
  out vec4 fragColor;
  ${COMMON}
  uniform float uGlow;
  uniform float uContrast;

  float scene(vec2 fc, vec2 mSt, float t){
    vec2 uv = fc/uRes;
    vec2 st = (fc - 0.5*uRes)/uRes.y;

    vec2 fp = st*1.7;
    vec2 warp = vec2(fbm(fp + vec2(0.0, t*0.10)),
                     fbm(fp + vec2(5.2, -t*0.08)));

    vec2 toP = st - mSt;
    float pd = length(toP);
    float push = uMouseOn * 0.04 / (pd*pd + 0.025);
    push = min(push, 0.06);
    vec2 disp = (toP/(pd+1e-4)) * push;

    vec2 sts = st + warp*0.04 + disp*0.45;

    float aspect = uRes.x/uRes.y;
    float narrow = smoothstep(1.05, 0.6, aspect);
    float cx = min(0.44, max(0.0, aspect*0.5 - 0.28));
    vec2 center = vec2(cx, 0.05) + mSt*0.06;
    vec2 p = sts - center;
    float r = length(p) * mix(1.0, 1.22, narrow);
    float ang = atan(p.y,p.x);
    float rot = 0.12 + t*0.03;

    float aL = abs(cos(2.0*(ang+rot)));
    float aS = abs(cos(2.0*(ang+rot-0.78539816)));
    float rays = (pow(aL,38.0) + pow(aS,55.0)*0.5) * exp(-r*3.3*uGlow);
    float glow = exp(-r*6.6*uGlow)*0.5;

    vec2 ep = p*vec2(1.0,1.72); float er=length(ep);
    float core = smoothstep(0.135,0.028,er);
    float halo = exp(-abs(er-0.14)*8.5)*0.95;

    float star = (rays*1.25 + glow + halo)*(1.0 - core*1.55);
    star = max(star,0.0);
    star *= 1.0 + 0.05*sin(t*0.6);

    vec2 np = vec2(uv.x*3.0, uv.y*3.0) + warp*0.5 + disp*2.4;
    float flow = fbm(np*1.25 + vec2(t*0.08,-t*0.11));
    float field = fbm(np*2.25 + flow*0.7 + vec2(t*0.05,t*0.05));
    float bmask = smoothstep(0.55,0.0,uv.y);
    float terrain = pow(field*0.5+0.5,1.4)*bmask*mix(0.45, 0.24, narrow);

    float sand = fbm(np*1.7 + warp*1.1 + vec2(-t*0.10, t*0.07));
    float sandField = (sand*0.5+0.5) * 0.09 * smoothstep(1.4,0.0,r);
    float haze = (fbm(np*0.7 + t*0.02)*0.5+0.5)*0.05 * smoothstep(1.1,0.1,r);

    vec2 cell = floor((fc + vec2(t*5.0, t*2.5))/max(uSize*2.0, 4.0));
    float sh = hash21(cell);
    float tw = 0.5+0.5*sin(t*3.0 + hash21(cell+7.0)*30.0);
    float specks = smoothstep(0.9965,0.9990,sh)*tw*0.45;

    float g = star + terrain + sandField + haze + specks + 0.02;

    float md = distance(st, mSt);
    float hv = smoothstep(0.32, 0.0, md);
    float stir = fbm(np*3.0 + t*0.6)*0.5+0.5;
    g += hv * (0.09 + 0.20*stir);
    g += smoothstep(0.09, 0.0, md) * 0.10;
    return g;
  }

  void main(){
    vec2 fc = gl_FragCoord.xy;
    vec2 gcell = floor(fc/uSize);
    vec2 cellCenter = (gcell + 0.5) * uSize;
    float t = uTime;
    vec2 mSt = vec2((uMouseUV.x-0.5)*uRes.x/uRes.y, uMouseUV.y-0.5);

    float g = clamp(scene(cellCenter, mSt, t), 0.0, 1.0);
    g = pow(g, uGamma);
    g = (g - 0.5)*uContrast + 0.5;
    g = clamp(g * uExposure, 0.0, 1.0);
    fragColor = shade(fc, mSt, t, g);
  }`;

  // ---------- 运行时 ----------
  interface Inst {
    el: HTMLCanvasElement;
    gl: WebGL2RenderingContext;
    u: Record<string, WebGLUniformLocation | null>;
    variant: 'sand' | 'star';
    dpr: number;
    last: number;
    animT: number;
    mUV: { x: number; y: number };
    vel: { x: number; y: number };
    mouseOn: number;
    mouseOnTarget: number;
    tint: [number, number, number];
    veil: number;
    alphaScale: number;
  }

  const live: Inst[] = [];
  let raf = 0;

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const dprCap = window.matchMedia('(pointer: coarse)').matches ? 1.5 : 2;

  const tUV = { x: 0.62, y: 0.6 };
  let mouseOnTarget = 0;

  const FALLBACK: [number, number, number] = [0.545, 0.247, 0.82];
  const parseColor = (raw: string): [number, number, number] => {
    const s = raw.trim();
    if (!s) return FALLBACK;
    if (s.startsWith('#')) {
      let h = s.slice(1);
      if (h.length === 3) h = h[0] + h[0] + h[1] + h[1] + h[2] + h[2];
      const n = parseInt(h, 16);
      if (Number.isNaN(n)) return FALLBACK;
      return [((n >> 16) & 255) / 255, ((n >> 8) & 255) / 255, (n & 255) / 255];
    }
    const nums = s.match(/[\d.]+/g);
    if (nums && nums.length >= 3) {
      return [Number(nums[0]) / 255, Number(nums[1]) / 255, Number(nums[2]) / 255];
    }
    return FALLBACK;
  };

  // sand 是黑白：浅色主题用更实的黑点 + 一层黑色薄雾压暗整体；
  // 深色主题把白点调暗（略灰、降透明度），避免整屏发亮。star 沿用主题紫
  const readTheme = (variant: 'sand' | 'star') => {
    if (variant === 'star') {
      return {
        tint: parseColor(getComputedStyle(document.documentElement).getPropertyValue('--grad-b')),
        veil: 0,
        alphaScale: 1,
      };
    }
    return document.documentElement.dataset.theme === 'dark'
      ? { tint: [0.72, 0.72, 0.72] as [number, number, number], veil: 0, alphaScale: 0.42 }
      : { tint: [0, 0, 0] as [number, number, number], veil: 0.04, alphaScale: 1.02 };
  };

  const compile = (gl: WebGL2RenderingContext, type: number, src: string) => {
    const s = gl.createShader(type);
    if (!s) return null;
    gl.shaderSource(s, src.replace(/^\s+/, ''));
    gl.compileShader(s);
    if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) {
      console.error(gl.getShaderInfoLog(s));
      return null;
    }
    return s;
  };

  const resize = (it: Inst) => {
    const { el, gl } = it;
    if (!el.clientWidth || !el.clientHeight) return; // 被 display:none 收起时保持原缓冲
    it.dpr = Math.min(window.devicePixelRatio || 1, dprCap);
    const w = Math.max(1, Math.round(el.clientWidth * it.dpr));
    const h = Math.max(1, Math.round(el.clientHeight * it.dpr));
    if (el.width !== w || el.height !== h) {
      el.width = w;
      el.height = h;
      gl.viewport(0, 0, w, h);
    }
  };

  const draw = (it: Inst) => {
    const { el, gl, u } = it;
    resize(it);
    const P = VARIANTS[it.variant];
    gl.uniform2f(u.uRes, el.width, el.height);
    gl.uniform1f(u.uTime, it.animT);
    gl.uniform2f(u.uMouseUV, it.mUV.x, it.mUV.y);
    gl.uniform1f(u.uMouseOn, it.mouseOn);
    // 手机（竖屏）上格子放大一点，保住像素颗粒感；仍取整设备像素，保持严格方格
    const portrait = el.clientWidth / Math.max(1, el.clientHeight) < 0.8;
    gl.uniform1f(u.uSize, Math.max(2, Math.round(P.size * it.dpr * (portrait ? 1.3 : 1))));
    gl.uniform1f(u.uExposure, P.exposure);
    gl.uniform1f(u.uGamma, P.gamma);
    gl.uniform1f(u.uGlow, P.glow);
    gl.uniform1f(u.uContrast, P.contrast);
    gl.uniform3f(u.uTint, it.tint[0], it.tint[1], it.tint[2]);
    gl.uniform1f(u.uAlpha, P.alpha * it.alphaScale);
    gl.uniform1f(u.uVeil, it.veil);
    gl.uniform1f(u.uScatter, P.scatter);
    gl.uniform2f(u.uMouseVel, Math.max(-1.5, Math.min(1.5, it.vel.x)), Math.max(-1.5, Math.min(1.5, it.vel.y)));
    gl.uniform1f(u.uInk, it.variant === 'sand' ? 0.45 : 0);
    gl.drawArrays(gl.TRIANGLES, 0, 3);
  };

  // 单个循环驱动所有画布：切走的（display:none / 已卸载）自动跳过或移除
  const tick = (now: number) => {
    for (let i = live.length - 1; i >= 0; i -= 1) {
      const it = live[i];
      if (!it.el.isConnected) {
        live.splice(i, 1);
        continue;
      }
      if (!it.el.clientWidth) {
        it.last = now;
        continue;
      }
      const dt = it.last ? Math.min((now - it.last) / 1000, 0.05) : 0.016;
      it.last = now;
      const P = VARIANTS[it.variant];
      it.animT += dt * P.motion;
      // 很慢地跟随：手感是"渐进、笨拙的滞后"，不是贴着手走
      const k = 1 - Math.exp(-1.1 * dt);
      const kOn = 1 - Math.exp(-1.0 * dt);
      const px = it.mUV.x;
      const py = it.mUV.y;
      it.mUV.x += (tUV.x - it.mUV.x) * k;
      it.mUV.y += (tUV.y - it.mUV.y) * k;
      it.mouseOn += (mouseOnTarget - it.mouseOn) * kOn;
      // 平滑后的位移速度：只用于刮擦拖拽，停下后很快归零
      const kv = 1 - Math.exp(-2.6 * dt);
      const aspect = it.el.width / Math.max(1, it.el.height);
      it.vel.x += (((it.mUV.x - px) / Math.max(dt, 1e-3)) * aspect - it.vel.x) * kv;
      it.vel.y += (((it.mUV.y - py) / Math.max(dt, 1e-3)) - it.vel.y) * kv;
      draw(it);
    }
    raf = live.length ? requestAnimationFrame(tick) : 0;
  };

  const start = () => {
    if (reduced.matches) {
      // 减少动态：每个画布只画一帧静态画面
      for (const it of live) {
        if (!it.el.isConnected) continue;
        it.animT = 6;
        draw(it);
      }
      return;
    }
    if (!raf) raf = requestAnimationFrame(tick);
  };

  const mount = (el: HTMLCanvasElement) => {
    if (live.some((it) => it.el === el)) return;
    const variant = (el.dataset.variant === 'star' ? 'star' : 'sand') as 'sand' | 'star';
    const gl = el.getContext('webgl2', {
      antialias: false,
      alpha: true,
      premultipliedAlpha: true,
      powerPreference: 'high-performance',
    });
    if (!gl) {
      el.style.display = 'none';
      return;
    }
    const vs = compile(gl, gl.VERTEX_SHADER, VERT);
    const fs = compile(gl, gl.FRAGMENT_SHADER, variant === 'star' ? FRAG_STAR : FRAG_SAND);
    if (!vs || !fs) {
      el.style.display = 'none';
      return;
    }
    const prog = gl.createProgram();
    gl.attachShader(prog, vs);
    gl.attachShader(prog, fs);
    gl.bindAttribLocation(prog, 0, 'aPos');
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {
      console.error(gl.getProgramInfoLog(prog));
      el.style.display = 'none';
      return;
    }
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    gl.enableVertexAttribArray(0);
    gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);

    const u: Record<string, WebGLUniformLocation | null> = {};
    for (const name of [
      'uRes', 'uTime', 'uMouseUV', 'uMouseOn', 'uSize',
      'uExposure', 'uGamma', 'uGlow', 'uContrast', 'uTint', 'uAlpha', 'uVeil', 'uScatter',
      'uMouseVel', 'uInk',
    ]) {
      u[name] = gl.getUniformLocation(prog, name);
    }

    el.style.display = '';
    live.push({
      el,
      gl,
      u,
      variant,
      dpr: 1,
      last: 0,
      animT: 0,
      mUV: { x: tUV.x, y: tUV.y },
      vel: { x: 0, y: 0 },
      mouseOn: 0,
      mouseOnTarget: 0,
      ...readTheme(variant),
    });
  };

  const init = () => {
    for (const el of document.querySelectorAll<HTMLCanvasElement>('canvas[data-dither]')) {
      mount(el);
    }
    start();
  };

  // ---------- 全局监听（模块只执行一次）----------
  window.addEventListener(
    'pointermove',
    (e) => {
      tUV.x = e.clientX / window.innerWidth;
      tUV.y = 1 - e.clientY / window.innerHeight;
      mouseOnTarget = 1;
    },
    { passive: true }
  );
  window.addEventListener(
    'pointerleave',
    () => {
      mouseOnTarget = 0;
    },
    { passive: true }
  );
  // 触摸结束 / 手势取消后也要让影响慢慢退场，否则手指离开后流场会一直保持被推开的形状
  const release = () => {
    mouseOnTarget = 0;
  };
  window.addEventListener('pointerup', release, { passive: true });
  window.addEventListener('pointercancel', release, { passive: true });

  window.addEventListener('resize', start);

  // 主题切换：颜色已注册为 <color>，过渡期间逐帧重读（star 的紫色与页面同步渐变）
  const applyTheme = (it: Inst) => {
    Object.assign(it, readTheme(it.variant));
  };
  let followId = 0;
  const followTheme = (until: number) => {
    if (followId) cancelAnimationFrame(followId);
    const step = () => {
      for (const it of live) {
        applyTheme(it);
        if (reduced.matches && it.el.isConnected) draw(it);
      }
      if (performance.now() < until) followId = requestAnimationFrame(step);
      else followId = 0;
    };
    followId = requestAnimationFrame(step);
  };
  new MutationObserver(() => {
    for (const it of live) applyTheme(it);
    start();
    followTheme(performance.now() + 600);
  }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  reduced.addEventListener('change', start);

  document.addEventListener('astro:page-load', init);
  init();
</script>
